name = 'FreeSurfer'
version = '8.1.0'
versionsuffix = '-rocky9_x86_64'

homepage = 'https://surfer.nmr.mgh.harvard.edu/'
description = """FreeSurfer is a set of tools for analysis and visualization
of structural and functional brain imaging data.  FreeSurfer contains a fully
automatic structural imaging stream for processing cross sectional and
longitudinal data."""

toolchain = {'name': 'GCC', 'version': '13.2.0'}

source_urls = ['https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/%(version)s/']
sources = ['%(namelower)s-linux%(versionsuffix)s-%(version)s.tar.gz']
checksums = ['6158acc772fcbb5220c89e6405e8b56e4618701b13b6bbe6e8da77695f5e5546']

osdependencies = ['tcsh']

builddependencies = [('patchelf', '0.18.0')]
dependencies = [
    ('MCR', 'R2019b.8', '', SYSTEM),
    ('FlexiBLAS', '3.3.1'),  # 
    ('JsonCpp', '1.9.5'),  # libjsoncpp.so.25
    ('glew', '2.2.0', '-egl'),  # libGLEW.so.2.2
]

# postinstallcmds = [
#     "ln -s $EBROOTMCR/v97 %(installdir)s/MCRv97",
#     # patchelf to EBROOTFLEXIBLAS/lib/libflexiblas.so.3
#     "patchelf --replace-needed libblas.so.3 libflexiblas.so.3 --replace-needed liblapack.so.3 libflexiblas.so.3 %(installdir)s/bin/mri_robust_register"
# ]
postinstallcmds = [
    "ln -s $EBROOTMCR/v97 %(installdir)s/MCRv97",
    r"""for f in %(installdir)s/bin/*; do
           file -b "$f" 2>/dev/null | grep -q '^ELF ' || continue
           need=$(patchelf --print-needed "$f" 2>/dev/null || true)
           echo "$need" | grep -qE 'lib(blas|lapack)\.so\.3' || continue
           patchelf --replace-needed libblas.so.3 libflexiblas.so.3 \
                   --replace-needed liblapack.so.3 libflexiblas.so.3 "$f"
        done""",
]

license_text = """email@example.com
00000
g1bb3r1sh
"""

# Prepend system libs so FreeSurfer binaries pick up the system libstdc++.so.6 first.
# This avoids GLIBCXX_* symbol errors caused by the older libstdc++ bundled with MCR.
# modextrapaths = {'LD_LIBRARY_PATH': ['/usr/lib64']}
# modextrapaths = {
#     'LD_LIBRARY_PATH': ['/usr/lib64', '%(installdir)s/lib', '%(installdir)s/mni/lib'],
# }
# modextrapaths = {
#     'LD_LIBRARY_PATH': ['%(installdir)s/lib', '%(installdir)s/mni/lib'],
# }

moduleclass = 'bio'

modluafooter = r'''
local gccroot = os.getenv("EBROOTGCC") or os.getenv("EBROOTGCCCORE")
if gccroot then
  prepend_path("LD_LIBRARY_PATH", pathJoin(gccroot, "lib64"))
  prepend_path("LD_LIBRARY_PATH", pathJoin(gccroot, "lib"))
end
'''