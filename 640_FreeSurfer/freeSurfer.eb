easyblock = 'CMakeMake'

name = 'FreeSurfer'
version = '7.4.1'

homepage = 'https://surfer.nmr.mgh.harvard.edu/'
description = """FreeSurfer is a set of tools for analysis and visualization
of structural and functional brain imaging data.  FreeSurfer contains a fully
automatic structural imaging stream for processing cross sectional and
longitudinal data."""

toolchain = {'name': 'foss', 'version': '2023b'}

source_urls = ['https://github.com/freesurfer/freesurfer/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['526852fe4ee979a051c017fe79851ccbd6a128ae7fad2f393bd767c36d8e0ca0']

builddependencies = [
  # ('patchelf', '0.18.0'),
  ('git-annex', '10.20240531'),
  ('CMake', '3.27.6'),
  ('xxd', '9.1.0307'),
]
dependencies = [
  ('Python', '3.11.5'),
  ('zlib', '1.2.13'),
  ('MCR', 'R2019b.8', '', SYSTEM),
  ('ITK', '5.4.0'),
  ('VTK', '9.3.0'),
  ('tcsh', '6.24.13'),  # fix shebang in the files TODO
  ('FlexiBLAS', '3.3.1'),
  ('JsonCpp', '1.9.5'),  # libjsoncpp.so.25
  ('glew', '2.2.0', '-egl'),  # libGLEW.so.2.2
]

# license_text = """email@example.com
# 00000
# g1bb3r1sh
# """

moduleclass = 'bio'
