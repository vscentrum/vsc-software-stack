#!/usr/bin/env bash
set -euo pipefail

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

export JUPYTER_CONFIG_DIR="$tmpdir/jupyter_config"
export JUPYTER_DATA_DIR="$tmpdir/jupyter_data"
export JUPYTER_RUNTIME_DIR="$tmpdir/jupyter_runtime"
export IPYTHONDIR="$tmpdir/ipython"
export MPLCONFIGDIR="$tmpdir/matplotlib"
export XDG_RUNTIME_DIR="$tmpdir/xdg_runtime"

mkdir -p "$JUPYTER_CONFIG_DIR" "$JUPYTER_DATA_DIR" "$JUPYTER_RUNTIME_DIR" "$IPYTHONDIR" "$MPLCONFIGDIR" "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

echo "== Basic executable checks =="
python --version
jupyter --version
jupyter --paths
jupyter server --version
jupyter server --help >/dev/null
jupyter server extension list
ipython --version

echo "== Python import checks: jupyter-server stack =="
python - <<'PY'
mods = [
    "jupyter_server",
    "jupyter_events",
    "jupyter_server_terminals",
    "jupyter_client",
    "jupyter_core",
    "nbformat",
    "nbclient",
    "nbconvert",
    "traitlets",
    "tornado",
    "zmq",
    "argon2",
    "terminado",
    "send2trash",
    "websocket",
]
for mod in mods:
    __import__(mod)
    print(f"OK import {mod}")
PY

echo "== Python import checks: IPython stack =="
python - <<'PY'
import importlib.metadata as md

mods = [
    "IPython",
    "traitlets",
    "stack_data",
    "executing",
    "asttokens",
    "pure_eval",
    "pexpect",
    "ptyprocess",
    "prompt_toolkit",
    "jedi",
    "pygments",
]
for mod in mods:
    __import__(mod)
    print(f"OK import {mod}")

for dist in ["ipython", "ipython-pygments-lexers", "matplotlib-inline"]:
    print(f"OK distribution {dist}: {md.version(dist)}")
PY

echo "== IPython execution check =="
ipython --quick --colors=NoColor -c "from IPython import get_ipython; assert get_ipython() is not None; x = 6 * 7; assert x == 42; print('OK IPython execution')"

echo "== pexpect/ptyprocess check =="
python - <<'PY'
import sys
import pexpect

child = pexpect.spawn(sys.executable, ["-q"], encoding="utf-8", timeout=10)
child.expect(">>> ")
child.sendline("2 + 2")
child.expect("4")
child.sendline("exit()")
child.expect(pexpect.EOF)
print("OK pexpect spawned Python REPL")
PY

echo "== Optional Jupyter kernel/widget stack check =="
python - <<'PY'
import importlib.util as iu

optional_groups = {
    "ipykernel stack": ["ipykernel", "debugpy", "comm", "nest_asyncio"],
    "widgets stack": ["ipywidgets", "jupyterlab_widgets", "widgetsnbextension"],
    "notebook shim": ["notebook_shim"],
}

for label, mods in optional_groups.items():
    missing = [m for m in mods if iu.find_spec(m) is None]
    if missing:
        print(f"SKIP {label}: missing {', '.join(missing)}")
        continue
    for mod in mods:
        __import__(mod)
        print(f"OK import {mod}")

    if "ipywidgets" in mods:
        import ipywidgets
        slider = ipywidgets.IntSlider(value=7)
        assert slider.value == 7
        print("OK ipywidgets object creation")
PY

echo "== ipykernel command check, if available =="
if python -c 'import importlib.util as iu; raise SystemExit(0 if iu.find_spec("ipykernel") else 1)'; then
    python -m ipykernel --version
    python -m ipykernel install --prefix "$tmpdir/kernel_prefix" --name eb-smoke --display-name "EasyBuild smoke kernel"
    JUPYTER_PATH="$tmpdir/kernel_prefix/share/jupyter" jupyter kernelspec list
else
    echo "SKIP ipykernel command check: ipykernel not installed"
fi

echo "== Start/stop Jupyter Server check =="
python - <<'PY'
import os
import subprocess
import sys
import time

tmpdir = os.environ["JUPYTER_RUNTIME_DIR"]
cmd = [
    "jupyter", "server",
    "--no-browser",
    "--ServerApp.ip=127.0.0.1",
    "--ServerApp.port=0",
    "--ServerApp.port_retries=0",
    "--ServerApp.root_dir=" + tmpdir,
    "--ServerApp.token=",
    "--ServerApp.password=",
    "--ServerApp.allow_root=True",
]

proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
lines = []
deadline = time.time() + 30
started = False

try:
    while time.time() < deadline:
        line = proc.stdout.readline()
        if line:
            lines.append(line.rstrip())
            print(line, end="")
            if "http://127.0.0.1:" in line or "Jupyter Server" in line and "is running at" in line:
                started = True
                break
        elif proc.poll() is not None:
            break
        else:
            time.sleep(0.2)

    if not started:
        proc.poll()
        raise RuntimeError("Jupyter Server did not start cleanly within 30 seconds")

finally:
    proc.terminate()
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait(timeout=10)

if proc.returncode not in (0, -15, 143):
    raise RuntimeError(f"Jupyter Server exited unexpectedly with code {proc.returncode}")

print("OK Jupyter Server start/stop")
PY

echo "== pip consistency check =="
python -m pip check

echo "All smoke tests passed."