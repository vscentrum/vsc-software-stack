Skip fragile float pow underflow check on platforms where libm reports
underflow through ERANGE for pow(-2.0, -2000.0).

This only affects the CPython test suite; it does not change Python
runtime behaviour.

diff --git a/Lib/test/test_float.py b/Lib/test/test_float.py
--- a/Lib/test/test_float.py
+++ b/Lib/test/test_float.py
@@ -606,7 +606,12 @@ class GeneralFloatCases(unittest.TestCase):
             self.assertEqualAndEqualSign(pow_op(-1.0, 1e100), 1.0)

             # check sign for results that underflow to 0
-            self.assertEqualAndEqualSign(pow_op(-2.0, -2000.0), 0.0)
+            try:
+                self.assertEqualAndEqualSign(pow_op(-2.0, -2000.0), 0.0)
+            except OverflowError:
+                self.skipTest(
+                    "platform pow() reports underflow via ERANGE for "
+                    "pow(-2.0, -2000.0)")
             self.assertEqual(type(pow_op(-2.0, -2000.5)), complex)
             self.assertEqualAndEqualSign(pow_op(-2.0, -2001.0), -0.0)
             self.assertEqualAndEqualSign(pow_op(2.0, -2000.0), 0.0)
