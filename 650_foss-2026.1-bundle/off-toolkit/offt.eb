easyblock = 'PythonBundle'

name = 'OpenForceField-Toolkit'
version = '0.18.1'

homepage = 'https://github.com/openforcefield/openff-toolkit'
description = """The Open Force Field Toolkit provides implementations of the SMIRNOFF format,
parameterization engine, and other tools."""

toolchain = {'name': 'foss', 'version': '2026.1'}

_ambertools_version = '26.1'
# builddependencies = [('poetry', '2.1.2')]
dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('networkx', '3.6.1'),
    ('pydantic', '2.13.4'),
    ('tqdm', '4.67.3'),
    ('OpenMM', '8.5.2'),
    ('PyYAML', '6.0.3'),
    ('RDKit', '2026.03.4'),
    ('MDTraj', '1.11.1'),
    ('JupyterNotebook', '7.5.7'),
    ('AmberTools', _ambertools_version),
    ('Pint', '0.25.3'),
    ('nglview', '4.0.1'),
]

# fix old syntax in versioneer.py
# _fix_versioneer = "sed -i -e 's/SafeConfigParser()/ConfigParser()/' -e 's/readfp(/read_file(/' versioneer.py && "

# fix version in OpenForceFields-Utilities
_utilities_fix = (
    r"""sed -i -e '/"versioningit",/d' -e 's/^dynamic = \["version"\]/version = "%(version)s"/' pyproject.toml && """
)

# fix version in OpenForceFields-Units
# _units_fix = r"sed -i -e '/\"versioningit\"/d' -e '/dynamic/d' -e '13 a version = \"%(version)s\"' pyproject.toml && "

# fix version in OpenForceFields-Interchange
# _interchange_fix = r"""sed -i -e 's/dynamic = [ "version" ]/version = "%(version)s"/' pyproject.toml && """

# fix version and license in OpenForceFields-Toolkit
_toolkit_fix = (
    "sed -i -e "
    r"""'s/, "versioningit" //' -e """
    r"""'s/^dynamic = \[ "version" \]/version = "%(version)s"/' """
    "pyproject.toml && "
)
# fix AmberTools version in GLOBAL_TOOLKIT_REGISTRY
_fix_ambertools_version = (
    f"""sed -i 's/get_ambertools_version()/"{_ambertools_version}"/' openff/toolkit/utils/ambertools_wrapper.py && """
)

# _fix_pyedr =  (
#     "sed -i -e "
#     r"'/versioningit/d' -e "
#     r"""'s/^dynamic = \["version"\]/version = "%(version)s"/' """
#     "pyproject.toml && "
# )

_bson_fix = (
    "sed -i -e 's/import pkgutil/import importlib.util/' "
    "-e 's/pkgutil[.]find_loader/importlib.util.find_spec/' setup.py && "
)

