From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EasyBuild
Date: Wed, 1 Jul 2026 00:00:00 +0200
Subject: [PATCH] Fix compatibility with mpmath 1.4.x

mpmath 1.4 deprecates the mpf_log alias in favour of mpf_ln.
Import mpf_ln as mpf_log when available, while retaining compatibility
with older mpmath releases that only provide mpf_log.

Backported from upstream SymPy PR #29250, limited to the mpmath symbol
rename needed for SymPy 1.14.0.

--- a/sympy/core/evalf.py
+++ b/sympy/core/evalf.py
@@ -11,11 +11,15 @@ from mpmath import inf as mpmath_inf
 from mpmath.libmp import (
     from_int, from_man_exp, from_rational,
     fhalf, fnan, finf, fninf, fnone, fone, fzero,
     mpf_abs, mpf_add, mpf_atan, mpf_atan2, mpf_cmp,
-    mpf_cos, mpf_e, mpf_exp, mpf_log, mpf_lt, mpf_mul, mpf_neg, mpf_pi,
+    mpf_cos, mpf_e, mpf_exp, mpf_lt, mpf_mul, mpf_neg, mpf_pi,
     mpf_pow, mpf_pow_int, mpf_shift, mpf_sin, mpf_sqrt,
     normalize, round_nearest, to_int, to_str, mpf_tan)
+try:
+    from mpmath.libmp import mpf_ln as mpf_log
+except ImportError:
+    from mpmath.libmp import mpf_log
 from mpmath.libmp import bitcount as mpmath_bitcount
 from mpmath.libmp.backend import MPZ
 from mpmath.libmp.libmpc import _infs_nan
 from mpmath.libmp.libmpf import dps_to_prec, prec_to_dps
--- a/sympy/core/expr.py
+++ b/sympy/core/expr.py
@@ -18,7 +18,11 @@ from sympy.utilities.exceptions import sympy_deprecation_warning
 from sympy.utilities.misc import as_int, func_name, filldedent
 from sympy.utilities.iterables import has_variety, sift
 
-from mpmath.libmp import mpf_log, prec_to_dps
+from mpmath.libmp import prec_to_dps
+try:
+    from mpmath.libmp import mpf_ln as mpf_log
+except ImportError:
+    from mpmath.libmp import mpf_log
 from mpmath.libmp.libintmath import giant_steps
 
 if TYPE_CHECKING: