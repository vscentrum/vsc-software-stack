easyblock = 'PythonBundle'

name = 'JupyterHub'
version = '5.5.0'

homepage = 'https://jupyter.org'
description = """JupyterHub is a multiuser version of the Jupyter (IPython) notebook designed
 for centralized deployments in companies, university classrooms and research labs."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('hatchling', '1.29.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('IPython', '9.14.0'),
    ('bcrypt', '5.0.0'),
    ('configurable-http-proxy', '5.2.0'),
    # ('OpenSSL', '3', '', SYSTEM),
    ('tornado', '6.5.6'),
    ('PycURL', '7.46.0'),  # optional, recommended with large number of users
    ('SQLAlchemy', '2.0.51'),
    ('pydantic', '2.13.4'),
    # ('PyYAML', '6.0.2'),
]

# DEPS:
    # OK alembic>=1.4 - in SQL
    # ok certipy>=0.1.2
    # OK idna - in pydantic
    # OK jinja2>=2.11.0
    # ok jupyter_events - also in jupyter-server
    # ok oauthlib>=3.0
    # OK packaging
    # ok pamela>=1.1.0; sys_platform != 'win32'
    # ok prometheus_client>=0.5.0 - also in jupyter-server
    # OK pydantic>=2
    # OK python-dateutil
    # OK requests
    # OK SQLAlchemy>=1.4.1
    # OK tornado>=5.1
    # OK traitlets>=4.3.2 - in IPython
    # ok jupyter-events 0.12.1 requires python-json-logger, which is not installed.
    # ok jupyter-events 0.12.1 requires rfc3339-validator, which is not installed.
    # ok jupyter-events 0.12.1 requires rfc3986-validator, which is not installed.

