        'source_tmpl': 'v%(version)s.tar.gz',
        'runtest': 'export HOME=%(builddir)s && cd %(start_dir)s && pytest -svv tests/',
        'testinstall': True}),
]

sanity_check_commands = ["boltz 2>&1 | grep 'Usage: boltz'"]

moduleclass = 'bio'
