easyblock = 'PythonBundle'

name = 'Boltz'
version = '2.1.1'
versionsuffix = '-CUDA-%(cudaver)s'
_cueq_ver = '0.5.1'

homepage = 'https://github.com/jwohlwend/boltz'
description = """
Boltz is a family of models for biomolecular interaction prediction. Boltz-1
was the first fully open source model to approach AlphaFold3 accuracy. Our
latest work Boltz-2 is a new biomolecular foundation model that goes beyond
AlphaFold3 and Boltz-1 by jointly modeling complex structures and binding
affinities, a critical component towards accurate molecular design. Boltz-2 is
the first deep learning model to approach the accuracy of physics-based
free-energy perturbation (FEP) methods, while running 1000x faster — making
accurate in silico screening practical for early-stage drug discovery."""

toolchain = {'name': 'foss', 'version': '2024a'}

builddependencies = [('hatchling', '1.24.2')]
dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05'),
    ('Biopython', '1.84'),
    ('PyYAML', '6.0.2'),
    ('CUDA', '12.6.0', '', SYSTEM),
    ('PyTorch', '2.6.0', versionsuffix),
    ('PyTorch-Lightning', '2.5.2', versionsuffix),
    ('Hydra', '1.3.2'),
    ('RDKit', '2025.03.3'),
    ('dm-tree', '0.1.9'),
    ('einops', '0.8.1'),
    ('wandb', '0.20.1'),
    ('scikit-learn', '1.5.2'),
    ('numba', '0.60.0'),
    ('gemmi', '0.7.1'),
]

# unpin strict dependencies versions
local_preinstallopts = (
    "sed -i -e "
    r"'s/==.*/\",/g' -e "
    "'s/torch>=2.2/torch/g' -e "
    "'16d' -e "  # delete rdkit dep - pip check fails even RDKit is there
    "'s/pandas>=2.2.2/pandas/g' "
    "pyproject.toml && "
)

exts_list = [
    ('ihm', '2.6', {
        'checksums': ['260b73c5299bbf02cfbc49ff4ebe55983b3ffb624bcf916af1391b23bc10bd72'],
    }),
    ('frozendict', '2.4.5', {
        'checksums': ['fd7add309789595c044c0155a0bddfa9d20c77f65de1e33a14aa3033b936ef63'],
    }),
    ('types-requests', '2.32.4.20250611', {
        'modulename': False,
        # fix configuration error: `project.license` must be valid exactly by one definition (2 matches found)
        'preinstallopts': "sed -i '/^license/d' pyproject.toml && ",
        'source_tmpl': 'types_requests-%(version)s.tar.gz',
        'checksums': ['741c8777ed6425830bf51e54d6abe245f79b4dcb9019f1622b773463946bf826'],
    }),
    ('einx', '0.3.0', {
        'checksums': ['17ff87c6a0f68ab358c1da489f00e95f1de106fd12ff17d0fb3e210aaa1e5f8c'],
    }),
    ('fairscale', '0.4.13', {
        'checksums': ['1b797825c427f5dba92253fd0d8daa574e8bd651a2423497775fab1b30cfb768'],
    }),
    ('mashumaro', '3.16', {
        'checksums': ['3844137cf053bbac30c4cbd0ee9984e839a5731a0ef96fd3dd9388359af3f2e1'],
    }),
    ('modelcif', '1.4', {
        'checksums': ['fca5c1da5eb25fff3c9cd61b618fa247569f8e90cbb64774740601155d4add6e'],
    }),
    ('chembl-structure-pipeline', '1.2.2', {
        'source_tmpl': 'chembl_structure_pipeline-%(version)s.tar.gz',
        'checksums': ['625ffc25f86d7d6fe1b459a381b2a52fb1df5fe0c8bbfe9c615e8b7f75c301c8'],
    }),
    ('opt-einsum', '3.4.0', {
        'source_tmpl': 'opt_einsum-%(version)s.tar.gz',
        'checksums': ['96ca72f1b886d148241348783498194c577fa30a8faac108586b14f1ba4473ac'],
    }),
    ('nvidia-ml-py', '12.575.51', {
        'modulename': 'pynvml',
        'source_tmpl': 'nvidia_ml_py-%(version)s.tar.gz',
        'checksums': ['6490e93fea99eb4e966327ae18c6eec6256194c921f23459c8767aee28c54581'],
    }),
    ('cuequivariance-torch', '0.5.1', {
        'source_tmpl': 'cuequivariance_torch-%(version)s.tar.gz',
        'checksums': ['9d2cfa9e299fc7637a9f851f91367c42f306922d0dc3f376453a27b49fa1fcc1'],
    }),
    ('cuequivariance', '0.5.1', {
        'source_tmpl': 'cuequivariance-%(version)s.tar.gz',
        'checksums': ['280f4d566fab363c1cffb4aa4cec21faadade0f7f8dbbdbea3298cd7ae50af95'],
    }),
    ('cuequivariance-ops-cu12', '0.5.1', {
        'modulename': 'cuequivariance_ops',
        'source_tmpl': 'cuequivariance_ops_cu12-%(version)s-py3-none-manylinux_2_24_x86_64.manylinux_2_28_x86_64.whl',
        'checksums': ['1edae1f6920f12f988cb5d42f410c1483a9e248dfd9f67815f43906c834fc8c4'],
    }),
    ('cuequivariance-ops-torch-cu12', '0.5.1', {
        'modulename': 'cuequivariance_ops_torch',
        'source_tmpl': 'cuequivariance_ops_torch_cu12-%(version)s-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl',
        'checksums': ['960c284e51635b821d6f57a269b9fd5d28361a42793bd54bbdfdf88f0d4fddea'],
    }),
    ('boltz', version, {
        'preinstallopts': """sed -i -e 's/==.*/\",/g' -e 's/torch>=2.2/torch/g' -e '16d' -e 's/pandas>=2.2.2/pandas/g' pyproject.toml && """,
        'runtest': "cd %(start_dir)s && python tests/test_kernels.py",
        'source_tmpl': 'v%(version)s.tar.gz',
        'source_urls': ['https://github.com/jwohlwend/boltz/archive/'],
        'testinstall': True,
        'checksums': ['def056abd5ee927889ff1d986dd4064cd84ba522572cc9c3619243c3454534a1'],
    }),
]

postinstallcmds = [
    "sed -i -e 's/Requires-Dist: pynvml/Requires-Dist: nvidia_ml_py/' "
    "-e '/Requires-Dist: nvidia-cublas-cu12/d' "  # CUBLAS runtime libraries are already provided by CUDA
    f"%(installdir)s/lib/python%(pyshortver)s/site-packages/cuequivariance_ops_cu12-{_cueq_ver}.dist-info/METADATA"
]

sanity_check_commands = ["boltz 2>&1 | grep 'Usage: boltz'"]

modextrapaths = {
    'LD_LIBRARY_PATH': 'lib/python%(pyshortver)s/site-packages/cuequivariance_ops/lib',
}

moduleclass = 'bio'
