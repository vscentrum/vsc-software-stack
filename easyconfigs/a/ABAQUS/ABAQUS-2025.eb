name = 'ABAQUS'
version = '2025'

homepage = 'https://www.simulia.com/products/abaqus_fea.html'
description = """Finite Element Analysis software for modeling, visualization and best-in-class implicit and explicit
 dynamics FEA."""

toolchain = SYSTEM

sources = [
    '%(version)s.AM_SIM_Abaqus_Extend.AllOS.1-5.tar',
    '%(version)s.AM_SIM_Abaqus_Extend.AllOS.2-5.tar',
    '%(version)s.AM_SIM_Abaqus_Extend.AllOS.3-5.tar',
    '%(version)s.AM_SIM_Abaqus_Extend.AllOS.4-5.tar',
    '%(version)s.AM_SIM_Abaqus_Extend.AllOS.5-5.tar',
]
checksums = [
    {'2025.AM_SIM_Abaqus_Extend.AllOS.1-5.tar': 'a49fc8ef1a460f19f25d8d78f70f43f01761208365505641e89ed635209de506'},
    {'2025.AM_SIM_Abaqus_Extend.AllOS.2-5.tar': '7e7b8f0d9742c7460984d8ae174b6ea83e5b65719cc59dc6c2c0875c86582d65'},
    {'2025.AM_SIM_Abaqus_Extend.AllOS.3-5.tar': '471984a25f15d870d6942af0d1d2fc3c5ed33472b3242dc1218c41b4d4f20d4f'},
    {'2025.AM_SIM_Abaqus_Extend.AllOS.4-5.tar': 'aed04ea40e106da90269567379c3f9e9979444af39afb93bdd702fc57fb6ed4f'},
    {'2025.AM_SIM_Abaqus_Extend.AllOS.5-5.tar': 'e482e41897c35d281e0ed7a4174a83d3653434ff0484677e6b2ee9e78649ce1a'},
]

download_instructions = f"""{name} requires manual download from https://www.3ds.com/support/software-downloads.

Required downloads:\n{chr(10).join(sources)}"""

# Site specific licensing information
_config = '%(installdir)s/cae/linux_a64/SMA/site/EstablishedProductsConfig.ini'
_lic_dir = '/apps/brussel/licenses/abaqus'
_lic_config = _lic_dir + '/DSLicSrv.txt'
postinstallcmds = [
    f"sed -i 's/LICENSE_SERVER_TYPE=flex/LICENSE_SERVER_TYPE=dsls/' {_config}",
    f"sed -i '/abaqusfea/a DSLS_LICENSE_CONFIG={_lic_config}' {_config}",
    f"sed -i '/abaqusfea/a ACADEMIC_TYPE=EDU' {_config}",
    f"sed -i '/FLEX_LICENSE_CONFIG=abaqusfea,abaqusfea,abaqusfea/d' {_config}",
]

_bwrap_prefix = f'bwrap --dev-bind / / --tmpfs /var --ro-bind /var/lib /var/lib --ro-bind {_lic_dir} /var/DassaultSystemes/Licenses'
modaliases = {
    'abaqus' : _bwrap_prefix +  ' abaqus',
    'abq2025' : _bwrap_prefix + ' abq2025',
}

modloadmsg = 'Note: Licenses for %(name)s only work on the Anansi cluster.'

moduleclass = 'cae'
