easyblock = 'PythonBundle'

name = 'CUDA-wheel-bundle'
version = '12.6.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://developer.nvidia.com/cuda'
description = "Repackaging of NVIDIA CUDA libraries as Python packages"

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

dependencies = [
    ('CUDA', '12.6.0', '', SYSTEM),
    ('cuDNN', '9.5.0.50', versionsuffix, SYSTEM),
    ('cuSPARSELt', '0.8.0.4', versionsuffix, SYSTEM),
    ('NCCL', '2.22.3', versionsuffix),
    ('Python', '3.13.1'),
]

dummy_package = True

exts_list = [
    # the following package list is based on the requirements of PyTorch 2.6.0
    # provided by CUDA
    ('nvidia-cublas-cu12', '12.6.4.1'),
    ('nvidia-cuda-cupti-cu12', '12.6.80'),
    ('nvidia-cuda-nvrtc-cu12', '12.6.77'),
    ('nvidia-cuda-runtime-cu12', '12.6.77'),
    ('nvidia-cufft-cu12', '11.3.0.4'),
    ('nvidia-curand-cu12', '10.3.7.77'),
    ('nvidia-cusolver-cu12', '11.7.1.2'),
    ('nvidia-cusparse-cu12', '12.5.4.2'),
    ('nvidia-nvjitlink-cu12', '12.6.85'),
    ('nvidia-nvtx-cu12', '12.6.77'),
    # provided by cuDNN
    ('nvidia-cudnn-cu12', '9.5.1.17'),
    # provided by cuSPARSELt
    ('nvidia-cusparselt-cu12', '0.6.3'),
    # provided by NCCL
    ('nvidia-nccl-cu12', '2.21.5'),
]

moduleclass = 'lib'
