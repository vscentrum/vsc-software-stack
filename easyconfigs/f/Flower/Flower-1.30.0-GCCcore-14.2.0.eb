easyblock = 'PythonBundle'

name = 'Flower'
version = '1.30.0'

homepage = 'https://flower.ai'
description = """
Flower: A Friendly Federated AI Framework. Federated learning, federated evaluation, and
federated analytics require infrastructure to move machine learning models back and forth,
train and evaluate them on local data, and then aggregate the updated models. Flower provides
the infrastructure to do exactly that in an easy, scalable, and secure way.
"""

toolchain = {'name': 'gfbf', 'version': '2025a'}

builddependencies = [
    ('poetry', '2.1.2'),
    ('PDM', '2.25.5'),  # for typer
]

dependencies = [
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('grpcio', '1.76.0'),
    ('protobuf-python', '6.31.1'),
    ('PyYAML', '6.0.2'),
    ('cryptography', '44.0.2'),
    ('SQLAlchemy', '2.0.41'),
    ('uv', '0.7.13'),
]

# tweak versions to fit the toolchain dependencies
local_preinstallopts = """sed -i 's/cryptography>=46.0.5,<47.0.0/cryptography/' pyproject.toml && """
local_preinstallopts += """sed -i 's/SQLAlchemy>=2.0.45,<3.0.0/SQLAlchemy/' pyproject.toml && """
local_preinstallopts += """sed -i 's/uv>=0.11.3,<0.12.0/uv/' pyproject.toml && """

exts_list = [
    ('grpcio-health-checking', '1.76.0', {
        'modulename': 'grpc',
        'sources': ['grpcio_health_checking-%(version)s.tar.gz'],
        'checksums': ['b7a99d74096b3ab3a59987fc02374068e1c180a352e8d1f79f10e5a23727098d'],
    }),
    ('iterators', '0.0.2', {
        'checksums': ['4f6a5b39c3c724edd5c7231a589d463ad50357cdc35494a3c71730795b78eb50'],
    }),
    ('typer', '0.13.0', {
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['d85fe0b777b2517cc99c8055ed735452f2659cd45e451507c76f48ce5c1d00e2'],
    }),
    ('rich', '13.9.4', {
        'checksums': ['439594978a49a09530cff7ebc4b5c7103ef57baf48d5ea3184f21d9a2befa098'],
    }),  # flwr 1.30.0 has requirement rich<14.0.0,>=13.5.0
    ('alembic', '1.18.1', {
        'patches': ['alembic-1.16.1_old_license_syntax.patch'],
        'checksums': [
            {'alembic-1.18.1.tar.gz': '83ac6b81359596816fb3b893099841a0862f2117b2963258e965d70dc62fb866'},
            {'alembic-1.16.1_old_license_syntax.patch':
             '1f442cd90ae3dd5637b110706cd6f89a501247f4add2a489c6dbf1bf8c6944be'},
        ],
    }),  # flwr 1.30.0 has requirement alembic<2.0.0,>=1.18.1
    ('typer', '0.19.2', {
        'checksums': ['9ad824308ded0ad06cc716434705f691d4ee0bfd0fb081839d2e426860e7fdca'],
    }),
    ('flwr', version, {
        'preinstallopts': local_preinstallopts,
        'checksums': ['0db8b89633918d64a54cc1f0f0bfdcfa062e72d5d3fe12e1b84a0211c9573ad2'],
    }),
]

sanity_check_paths = {
    'files': ['bin/flwr'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/flwr'],
}

sanity_check_commands = [
    "flwr --help",
]

moduleclass = 'ai'
