easyblock = 'CMakeMake'

name = 'hictk'
version = '2.1.4'

homepage = 'https://hictk.readthedocs.io/en/latest/index.html'
description = """
hictk is a blazing fast toolkit to work with .hic and .cool files.
"""

toolchain = {'name': 'foss', 'version': '2023a'}

source_urls = ['https://github.com/paulsengroup/hictk/archive/']
sources = ['v%(version)s.tar.gz']
patches = ['new.patch']  # TODO
checksums = [
    '3a0030425176dacc25c20afc6fedb5dfbbc3c1a67f773be11ac77d7fa6b7efde',  # v2.1.4.tar.gz
    'ff1d30e653c5e9519602f29442001d7201cd7c83fbbba3236801fb31981dbf24',  # new.patch  # TODO
]

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
    ('Catch2', '3.10.0'),
]

dependencies = [  # TODO bshoshany-thread-pool
    ('Arrow', '14.0.1'),
    ('Boost', '1.82.0'),
    ('bzip2', '1.0.8'),
    ('CLI11', '2.5.0'),
    ('concurrentqueue', '1.0.4'),
    ('Eigen', '3.4.0'),
    ('fast_float', '8.0.2'),
    ('fmt', '10.1.0'),
    ('HDF5', '1.14.0'),
    ('HighFive', '2.8.0'),
    ('libarchive', '3.6.2'),
    ('cURL', '8.0.1'),
    ('libdeflate', '1.18'),
    ('lz4', '1.9.4'),
    ('LZO', '2.10'),
    ('nlohmann_json', '3.11.2'),
    ('opentelemetry-cpp', '1.22.0'),
    ('parallel-hashmap', '2.0.0'),
    ('pybind11', '2.11.1'),
    ('readerwriterqueue', '1.0.7'),
    ('span-lite', '0.11.0'),
    ('spdlog', '1.12.0'),
    ('tomlplusplus', '3.4.0'),
    ('XZ', '5.4.2'),
    ('zstd', '1.5.5'),
    ('zlib', '1.2.13'),
]

configopts = "-DZSTD_LIB=$EBROOTZSTD/lib/libzstd.%s " % SHLIB_EXT

moduleclass = 'tools'
