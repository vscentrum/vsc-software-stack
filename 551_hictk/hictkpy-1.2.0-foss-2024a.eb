easyblock = 'PythonBundle'

name = 'hictkpy'
version = '1.2.0'

homepage = 'https://hictk.readthedocs.io/en/stable/'
description = """
Python bindings for hictk, a blazing fast toolkit to work with .hic and .cool files.
"""

