easyblock = 'CmdCp'

name = 'bshoshany-thread-pool'
version = '5.0.0'

homepage = 'https://github.com/bshoshany/thread-pool'
description = """
BS::thread_pool: a fast, lightweight, modern, and easy-to-use C++17 / C++20 / C++23 thread pool library
"""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

source_urls = ['https://github.com/bshoshany/thread-pool/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['617a8fbc2c360577f498998f336777c73d581810831d4ce9c920f11ec680b07b']

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
]

local_cmds = """
cat > "%(installdir)s/lib/cmake/bshoshany-thread-pool/bshoshany-thread-poolConfig.cmake" <<'CM'
if(TARGET BS::thread_pool) return() endif()
add_library(BS_thread_pool INTERFACE)
add_library(BS::thread_pool ALIAS BS_thread_pool)
CM
"""

cmds_map = [('.*', local_cmds)]

files_to_copy = [
    (['include'], 'include'),
    (['lib'], 'lib'),
]

modextrapaths = {
    MODULE_LOAD_ENV_HEADERS: 'include',
    'CMAKE_PREFIX_PATH': ['lib/cmake/bshoshany-thread-pool']
}

moduleclass = 'lib'
