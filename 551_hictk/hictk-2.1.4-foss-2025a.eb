easyblock = 'CMakeMake'

name = 'hictk'
version = '2.1.4'

homepage = 'https://hictk.readthedocs.io/en/latest/index.html'
description = """
hictk is a blazing fast toolkit to work with .hic and .cool files.
"""

toolchain = {'name': 'foss', 'version': '2025a'}

source_urls = ['https://github.com/paulsengroup/hictk/archive/']
sources = ['v%(version)s.tar.gz']
patches = ['hictk-2.1.4_CMake_deps.patch']
checksums = [
    '3a0030425176dacc25c20afc6fedb5dfbbc3c1a67f773be11ac77d7fa6b7efde',  # v2.1.4.tar.gz
    'b41fcac861fd577e4bfc20abf91b092f20e79f263eece7ea23452650f27d9ff8',  # hictk-2.1.4_CMake_deps.patch
]

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.31.3'),
    ('Catch2', '3.8.1'),
]

dependencies = [
    ('Arrow', '17.0.0'),  # TODO
    ('Boost', '1.88.0'),
    ('bzip2', '1.0.8'),
    ('CLI11', '2.5.0'),  # TODO
    ('concurrentqueue', '1.0.4'),  # TODO
    ('Eigen', '3.4.0'),
    ('fast_float', '8.0.2'),  # TODO
    ('fmt', '11.2.0'),
    ('HDF5', '1.14.6'),
    ('HighFive', '2.10.1'),  # TODO
    ('libarchive', '3.7.7'),
    ('cURL', '8.11.1'),
    ('libdeflate', '1.24'),
    ('lz4', '1.10.0'),
    ('LZO', '2.10'),
    ('nlohmann_json', '3.12.0'),
    ('opentelemetry-cpp', '1.22.0'),  # TODO
    ('parallel-hashmap', '2.0.0'),  # TODO
    ('bshoshany-thread-pool', '5.0.0', '', SYSTEM),  # TODO
    ('pybind11', '2.13.6'),
    ('readerwriterqueue', '1.0.7'),  # TODO
    ('span-lite', '0.11.0'),  # TODO
    ('spdlog', '1.15.3'),  # TODO
    ('tomlplusplus', '3.4.0'),  # TODO
    ('XZ', '5.6.3'),
    ('zstd', '1.5.6'),
    ('zlib', '1.3.1'),
]

configopts = "-DZSTD_LIB=$EBROOTZSTD/lib/libzstd.%s " % SHLIB_EXT

moduleclass = 'tools'
