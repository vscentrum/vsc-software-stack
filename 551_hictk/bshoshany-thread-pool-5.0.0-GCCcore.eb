easyblock = 'CmdCp'

name = 'bshoshany-thread-pool'
version = '5.0.0'

homepage = 'https://github.com/bshoshany/thread-pool'
description = """
BS::thread_pool: a fast, lightweight, modern, and easy-to-use C++17 / C++20 / C++23 thread pool library
"""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

source_urls = ['https://github.com/bshoshany/thread-pool/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['617a8fbc2c360577f498998f336777c73d581810831d4ce9c920f11ec680b07b']

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
    ('conan', '1.60.2'),
]

local_crate_conanfile_cmd = " echo '[requires]' > conanfile.txt && "
local_crate_conanfile_cmd += "echo 'opentelemetry-cpp/1.18.0' >> conanfile.txt && "
local_crate_conanfile_cmd += "echo '[generators]' >> conanfile.txt && "
local_crate_conanfile_cmd += "echo 'CMakeDeps' >> conanfile.txt && "
local_crate_conanfile_cmd += "echo 'CMakeToolchain' >> conanfile.txt && "
local_crate_conanfile_cmd += "echo '[layout]' >> conanfile.txt && "
local_crate_conanfile_cmd += "echo 'cmake_layout' >> conanfile.txt && "
local_crate_conanfile_cmd += "export CONAN_USER_HOME=%(builddir)s/%(name)s-%(version)s && conan install ."

cmds_map = [('.*', local_crate_conanfile_cmd)]

files_to_copy = [
    (['include'], 'include'),
    (['lib'], 'lib'),
]

moduleclass = 'lib'

