easyblock = 'CMakeMake'

name = 'opentelemetry-cpp'
version = '1.22.0'

homepage = 'https://github.com/open-telemetry/opentelemetry-cpp'
description = """
The C++ OpenTelemetry client.
"""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

source_urls = ['https://github.com/open-telemetry/opentelemetry-cpp/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['3428f433f4b435ed1fad64cbdbe75b7288c06f6297786a7036d65d5b9a1d215b']

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
]

test_cmd = 'ctest'

sanity_check_paths = {
    'files': ['lib/libopentelemetry_common.a'],
    'dirs': ['include/opentelemetry'],
}

moduleclass = 'lib'
