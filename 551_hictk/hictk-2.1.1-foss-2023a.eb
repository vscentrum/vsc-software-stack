easyblock = 'CMakeMake'

name = 'hictk'
version = '2.1.1'

homepage = 'https://hictk.readthedocs.io/en/latest/index.html'
description = """
hictk is a blazing fast toolkit to work with .hic and .cool files.
"""

toolchain = {'name': 'foss', 'version': '2023a'}

source_urls = ['https://github.com/paulsengroup/hictk/archive/']
sources = ['v%(version)s.tar.gz']
patches = ['hictk-2.1.1_CMake_deps.patch']
checksums = [
    '0a00eb9cc599fa80f4d6edafd4f0bc4db75863e7d11337775fc3f2547aa7c829',  # v2.1.1.tar.gz
    'a84d1697cd42fab428d8d5ab7dae5542c9aa3eb1aa48febe856089496325c9c4',  # hictk-2.1.1_CMake_deps.patch
]

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
]

dependencies = [
    ('Arrow', '14.0.1'),
    ('Boost', '1.82.0'),
    ('bzip2', '1.0.8'),
    ('Catch2', '2.13.9'),
    ('CLI11', '2.5.0'),
    ('concurrentqueue', '1.0.4'),
    ('Eigen', '3.4.0'),
    ('fast_float', '8.0.2'),
    ('fmt', '10.1.0'),
    ('HDF5', '1.14.0'),
    ('HighFive', '2.7.1'),
    ('libarchive', '3.6.2'),
    ('cURL', '8.0.1'),
    ('libdeflate', '1.18'),
    ('lz4', '1.9.4'),
    ('LZO', '2.10'),
    ('nlohmann_json', '3.11.2'),
    ('opentelemetry-cpp', '1.22.0'),  # TODO ok?
    ('parallel-hashmap', '2.0.0'),
    ('pybind11', '2.11.1'),
    ('readerwriterqueue', '1.0.7'),
    ('span-lite', '0.11.0'),
    ('spdlog', '1.11.0'),
    ('tomlplusplus', '3.4.0'),
    ('XZ', '5.4.2'),
    ('zstd', '1.5.5'),
    ('zlib', '1.2.13'),
]

# TODO sed commands to patchfile
preconfigopts = """sed -i 's|find_package(zstd REQUIRED QUIET)|find_library(zstd PATHS $ENV{EBROOTZSTD}/lib64)|g' %(builddir)s/%(name)s-%(version)s/src/libhictk/balancing/CMakeLists.txt %(builddir)s/%(name)s-%(version)s/src/libhictk/common/default_delete_zstd/CMakeLists.txt && """

preconfigopts = """sed -i 's|find_package(opentelemetry-cpp REQUIRED QUIET)|find_library(opentelemetry-cpp PATHS $ENV{EBROOTOPENTELEMETRYCPP}/lib64)|g' %(builddir)s/%(name)s-%(version)s/src/hictk/telemetry/CMakeLists.txt && """

preconfigopts += """sed -i '/find_package(phmap REQUIRED QUIET)/d' %(builddir)s/%(name)s-%(version)s/src/libhictk/cooler/CMakeLists.txt %(builddir)s/%(name)s-%(version)s/src/libhictk/expected_values_aggregator/CMakeLists.txt && """

configopts = '-DZSTD_LIBRARY=$EBROOTZSTD/lib/libzstd.%s ' % SHLIB_EXT

moduleclass = 'tools'

