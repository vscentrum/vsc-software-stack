easyblock = 'CMakeMake'

name = 'hictk'
version = '2.1.1'

homepage = 'https://hictk.readthedocs.io/en/latest/index.html'
description = """
hictk is a blazing fast toolkit to work with .hic and .cool files.
"""

toolchain = {'name': 'foss', 'version': '2023a'}

source_urls = ['https://github.com/paulsengroup/hictk/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['0a00eb9cc599fa80f4d6edafd4f0bc4db75863e7d11337775fc3f2547aa7c829']

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
    # ('conan', '1.60.2'),
]

dependencies = [
    ('Arrow', '14.0.1'),
    ('Boost', '1.82.0'),
    # ('bshoshany-thread-pool', '5.0.0'),  # TODO
    ('bzip2', '1.0.8'),
    ('Catch2', '2.13.9'),
    ('CLI11', '2.5.0'),
    ('concurrentqueue', '1.0.4'),
    ('Eigen', '3.4.0'),
    ('fast_float', '8.0.2'),
    ('fmt', '10.1.0'),
    ('HDF5', '1.14.0'),
    ('HighFive', '2.7.1'),
    ('libarchive', '3.6.2'),
    ('cURL', '8.0.1'),
    ('libdeflate', '1.18'),
    ('lz4', '1.9.4'),
    ('LZO', '2.10'),
    ('nlohmann_json', '3.11.2'),
    # ('opentelemetry-cpp', '1.20.0'),  # TODO
    ('parallel-hashmap', '2.0.0'),
    ('pybind11', '2.11.1'),
    ('readerwriterqueue', '1.0.7'),
    ('span-lite', '0.11.0'),
    ('spdlog', '1.11.0'),
    ('tomlplusplus', '3.4.0'),
    ('XZ', '5.4.2'),
    ('zstd', '1.5.5'),
    ('zlib', '1.2.13'),
]

