easyblock = 'CMakeMake'

name = 'hictk'
version = '2.1.4'

homepage = 'https://hictk.readthedocs.io/en/latest/index.html'
description = """
hictk is a blazing fast toolkit to work with .hic and .cool files.
"""

toolchain = {'name': 'foss', 'version': '2023a'}
toolchainopts = {'cstd': 'c++20'}  # TODO didn't help'

source_urls = ['https://github.com/paulsengroup/hictk/archive/']
sources = ['v%(version)s.tar.gz']
# patches = ['hictk-2.1.4_CMake_deps.patch']
checksums = [
    '3a0030425176dacc25c20afc6fedb5dfbbc3c1a67f773be11ac77d7fa6b7efde',  # v2.1.4.tar.gz
    '89155b2500a36756f9125ff8c152addb732dc69c955cc2cdf4308d705544e451',  # hictk-2.1.4_CMake_deps.patch
]

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
    ('Catch2', '3.10.0'),
    ('conan', '2.20.1'),
]

dependencies = [
    ('Arrow', '14.0.1'),
    ('Boost', '1.82.0'),
    ('bzip2', '1.0.8'),
    ('CLI11', '2.5.0'),
    ('concurrentqueue', '1.0.4'),
    ('Eigen', '3.4.0'),
    ('fast_float', '8.0.2'),
    ('fmt', '10.1.0'),
    ('HDF5', '1.14.0'),
    ('HighFive', '2.8.0'),
    ('libarchive', '3.6.2'),
    ('cURL', '8.0.1'),
    ('libdeflate', '1.18'),
    ('lz4', '1.9.4'),
    ('LZO', '2.10'),
    ('nlohmann_json', '3.11.2'),
    ('opentelemetry-cpp', '1.22.0'),
    ('parallel-hashmap', '2.0.0'),  # TODO replaced by CMake fetch?
    ('pybind11', '2.11.1'),
    ('readerwriterqueue', '1.0.7'),
    ('span-lite', '0.11.0'),
    ('spdlog', '1.12.0'),
    ('tomlplusplus', '3.4.0'),
    ('XZ', '5.4.2'),
    ('zstd', '1.5.5'),
    ('zlib', '1.2.13'),
]

# preconfigopts = (
#       "cat > conanfile.txt <<'CF'"
# "[requires]/nbshoshany-thread-pool/5.0.0/n[generators]/ncmake_find_package"
# "CF && "
#     "conan install . "
#     "--build=missing "
#     "-s build_type=Release "
#     "-if %(builddir)s && "
# )

# preconfigopts = """
# set -e
# cat > conanfile.txt <<'CF'
# [requires]
# bshoshany-thread-pool/5.0.0
# [generators]
# cmake_find_package
# CF && 
# """
# preconfigopts = (
#     'touch conanfile.txt && '
#     'echo "[requires]" > conanfile.txt && '
#     'echo "bshoshany-thread-pool/5.0.0" >> conanfile.txt && '
#     'echo "[generators]" >> conanfile.txt && '
#     'echo "cmake_find_package" >> conanfile.txt && '
# )
# conan install . -s build_type=Release -if %(builddir)s --build=missing
preconfigopts = (
    "conan profile detect --force && "
    "conan install "
    "--requires=bshoshany-thread-pool/5.0.0 "
    "-g CMakeDeps "
    "-s build_type=Release "
    "-of %(builddir)s && "
)

configopts = "-DZSTD_LIB=$EBROOTZSTD/lib/libzstd.%s " % SHLIB_EXT
# fixes error: ‘basic_runtime’ is not a member of ‘fmt’
# configopts += "-DCMAKE_CXX_FLAGS='-DSPDLOG_USE_STD_FORMAT=1'"
configopts += '-DCMAKE_PREFIX_PATH="%(builddir)s"'
# configopts += '-DCMAKE_MODULE_PATH="%(builddir)s"'
# configopts += 

moduleclass = 'tools'

# missing zstd-config.cmake
# problem with BS_thread_pool.hpp and parallel-hashmap -> OK
    # 
# missing concurrentqueue headers -> update ec to link all .h files to include dir -> OK
# HighFive is old - update to v2.8 -> OK
# spdlog v1.11 and fmt v10 are not compatible -> OK
    # -> update spdlog to 1.12.0 -> OK
    # use spdlog v1.12 + fmt v10 OR spdlog v1.11 + fmt v9.1

