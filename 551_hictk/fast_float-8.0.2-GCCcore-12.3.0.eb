easyblock = 'CMakeMake'

name = 'fast_float'
version = '8.0.2'

homepage = 'https://github.com/fastfloat/fast_float'
description = """
Fast and exact implementation of the C++ from_chars functions for float and double types.
"""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

source_urls = ['https://github.com/fastfloat/fast_float/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['e14a33089712b681d74d94e2a11362643bd7d769ae8f7e7caefe955f57f7eacd']

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
]

sanity_check_paths = {
    'files': [],
    'dirs': ['include/%(name)s', 'share'],
}

moduleclass = 'lib'
