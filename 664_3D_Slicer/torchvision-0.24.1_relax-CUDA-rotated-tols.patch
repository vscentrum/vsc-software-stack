Relax tolerances for CUDA float32 XYWHR bounding-box transform tests.

With PyTorch 2.9.1 and CUDA 12.9.1, torchvision 0.24.1 shows small
CPU-vs-CUDA numerical differences for rotated float32 XYWHR bounding boxes.
The observed differences are about 1.15e-5 for Resize and 3.74e-4 for
RandomCrop, while the rest of the functionality passes the test suite.

Relax the tolerances only for CUDA float32 XYWHR cases. Keep all tests
enabled and preserve the default tolerances for other devices, dtypes, and
bounding-box formats.

Author: Pavel Tomanek (Inuits/UGent) with help from ChatGPT5.6
--- a/test/test_transforms_v2.py
+++ b/test/test_transforms_v2.py
@@ -688,6 +688,15 @@ class TestResize:
             dtype=dtype,
             device=device,
         )
+        check_cuda_vs_cpu = (
+            dict(rtol=1.3e-6, atol=2e-5)
+            if (
+                device == "cuda"
+                and dtype is torch.float32
+                and format == tv_tensors.BoundingBoxFormat.XYWHR
+            )
+            else True
+        )
         check_kernel(
             F.resize_bounding_boxes,
             bounding_boxes,
@@ -695,6 +704,7 @@ class TestResize:
             canvas_size=bounding_boxes.canvas_size,
             size=size,
             **max_size_kwarg,
+            check_cuda_vs_cpu=check_cuda_vs_cpu,
             check_scripted_vs_eager=not isinstance(size, int),
         )
     @pytest.mark.parametrize("size", OUTPUT_SIZES)
@@ -3295,3 +3305,12 @@
         expected = self._reference_crop_bounding_boxes(bounding_boxes, **params)
-        torch.testing.assert_close(actual, expected)
+        tolerances = (
+            dict(rtol=1.3e-6, atol=5e-4)
+            if (
