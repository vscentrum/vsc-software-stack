easyblock = 'CMakeMake'

name = 'Slicer'
version = '5.12.3'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://www.slicer.org'
description = "Slicer, or 3D Slicer, is a free, open source software package for visualization and image analysis."

toolchain = {'name': 'foss', 'version': '2025b'}

source_urls = ['https://github.com/Slicer/Slicer/archive/']
sources = [{
    'filename': SOURCE_TAR_XZ,
    'git_config': {
        'url': 'https://github.com/Slicer',
        'repo_name': name,
        'tag': 'v%(version)s',
        'keep_git_dir': True,
    },
}]
patches = ['Slicer-5.12.3_fix-Python-3.13.patch']
checksums = [
    {'Slicer-5.12.3.tar.xz': 'c2d36b592964a68f24caf567b16a417c32b31f8ddc030af3085dccd68da7aa7b'},
    {'Slicer-5.12.3_fix-Python-3.13.patch': '388f957fc45d2dba51245b5dfc910a468365c71423a950da5e5d19092c4bb213'},
]

builddependencies = [
    ('CMake', '3.31.8'),
    ('patchelf', '0.18.0'),
]
dependencies = [
    ('CUDA', '12.9.1', '', SYSTEM),
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('Qt6', '6.9.3'),
    ('Slicer-Python-deps', version),
    ('Biomedisa', '26.7.3', versionsuffix),
    ('OpenSSL', '3', '', SYSTEM),
    ('cURL', '8.14.1'),
    # Slicer build its special patched VTK and ITK versions different from ones in EB repo
]

preconfigopts = "sed -i '/^[[:space:]]*nose[[:space:]]*$/d' "
preconfigopts += "%(builddir)s/Slicer/SuperBuild/External_python-numpy.cmake && "

configopts = '-DCMAKE_BUILD_TYPE=Release '
configopts += '-DSlicer_RELEASE_TYPE=Stable '
# configopts += '-DSlicer_FORCED_REVISION=34627 '
configopts += '-DQt6_DIR=$EBROOTQT6/lib/cmake/Qt6 '
configopts += '-DSlicer_USE_SYSTEM_QT=ON '
configopts += '-DSlicer_USE_SYSTEM_python=ON '
configopts += '-DSlicer_REQUIRED_PYTHON_VERSION=3.13.5 '
# configopts += '-DSlicer_USE_SYSTEM_VTK=ON '
# configopts += '-DSlicer_VTK_VERSION_MINOR=5 '
# configopts += '-DSlicer_VTK_SMP_IMPLEMENTATION_TYPE=Sequential '
# configopts += '-DSlicer_USE_SYSTEM_ITK=ON '
configopts += '-DBUILD_TESTING=OFF '
configopts += '-DOPENSSL_ROOT_DIR=$EBROOTOPENSSL '
configopts += '-DSlicer_USE_SYSTEM_curl=ON '
configopts += '-DCURL_USE_STATIC_LIBS=OFF '

# Slicer's SuperBuild does not provide a complete install through a plain CMake install step.
# Generate the official CPack TGZ package and extract its contents into the EasyBuild install directory.
install_cmd = 'mkdir -p %(builddir)s/easybuild_obj/cpack-install && '
install_cmd += 'cd %(builddir)s/easybuild_obj/Slicer-build && '
install_cmd += 'cpack --config CPackConfig.cmake -G TGZ -B %(builddir)s/easybuild_obj/cpack-install && '
install_cmd += 'tar -xzf %(builddir)s/easybuild_obj/cpack-install/Slicer-%(version)s-linux-amd64.tar.gz '
install_cmd += '--strip-components=1 -C %(installdir)s && '
# Slicer builds its own TBB for VTK/ITK, but the generated CPack archive does not include these libraries.
# Copy the required TBB shared libraries into the final installation.
install_cmd += 'cp -a %(builddir)s/easybuild_obj/tbb-install/lib/libtbb*.so* %(installdir)s/lib/ && '
# Some bundled DCMTK binaries retain the SuperBuild DCMTK build directory in their RPATH after packaging.
# Remove this stale path and add the final Slicer library directory as a relative RPATH entry.
install_cmd += 'BUILD="%(builddir)s/easybuild_obj" && '
install_cmd += 'find %(installdir)s -type f -print0 | while IFS= read -r -d "" f; do '
install_cmd += 'rpath=$(patchelf --print-rpath "$f" 2>/dev/null || true); '
install_cmd += 'if echo "$rpath" | grep -qF "$BUILD/DCMTK-build/lib"; then '
install_cmd += 'new=$(echo "$rpath" | tr ":" "\\n" | grep -vF "$BUILD/DCMTK-build/lib" | grep -v "^$" | '
install_cmd += "awk '!seen[$0]++' | paste -sd: -); "
install_cmd += 'case ":$new:" in *":\\$ORIGIN/../lib/Slicer-5.12:"*) ;; '
install_cmd += '*) new="$new:\\$ORIGIN/../lib/Slicer-5.12" ;; esac; '
install_cmd += 'patchelf --force-rpath --set-rpath "$new" "$f"; '
# libdcmjp2kcs may retain the SuperBuild OpenJPEG staging directory in its RPATH.
# Remove this stale path; OpenJPEG is installed together with Slicer's internal libraries.
install_cmd += 'elif echo "$rpath" | grep -qF "$BUILD/OpenJPEG-install/lib"; then '
install_cmd += 'new=$(echo "$rpath" | tr ":" "\\n" | grep -vF "$BUILD/OpenJPEG-install/lib" | grep -v "^$" | '
install_cmd += "awk '!seen[$0]++' | paste -sd: -); "
install_cmd += 'patchelf --force-rpath --set-rpath "$new" "$f"; '
install_cmd += 'fi; done'

# Slicer uses CTK AppLauncher to configure runtime library paths for its internal executables and libraries.
# Restrict EasyBuild's generic linkage checks to the top-level launcher and lib directory, and skip the
# readelf RPATH check because launcher-managed binaries are not intended to resolve correctly when inspected
# directly outside the AppLauncher-provided environment.
check_readelf_rpath = False
bin_lib_subdirs = ['.', 'lib']

modextrapaths = {'PATH': ''}

moduleclass = 'vis'
