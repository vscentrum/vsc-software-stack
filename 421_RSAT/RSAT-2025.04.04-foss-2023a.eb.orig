easyblock = 'RPackage'

name = 'RSAT'
version = '2025.04.04'

homepage = 'https://github.com/rsa-tools/rsat-code/'
description = """Regulatory Sequence Analysis Tools (RSAT)."""

toolchain = {'name': 'foss', 'version': '2023a'}
# toolchainopts = {'pic': True}

source_urls = ['https://github.com/rsa-tools/rsat-code/archive/']
sources = [{'download_filename': '%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
checksums = ['e1391de42c9115f1675f6399f02b5e364fc229d4ae185643a78ac75d1fe97c62']

builddependencies = [
    ('binutils', '2.40'),
    # ('groff', '1.22.4'),
]

dependencies = [
    ('Perl', '5.36.1'),
    ('Perl-bundle-CPAN', '%(perlver)s'),
    ('zlib', '1.2.13'),  # for Net::SSLeay
    ('expat', '2.5.0'),  # for XML::Parser
    ('ncurses', '6.4'),  # for Term::ReadLine::Gnu
    ('libreadline', '8.2'),  # for Term::ReadLine::Gnu
    # ('OpenSSL', '1.1', '', SYSTEM),  # required for Net::SSLeay
]

start_dir = 'R-scripts'

sanity_check_paths = {
    'files': [
        'bin/compare-matrices-quick',
        'bin/count-words',
        'bin/info-gibbs',
        'bin/matrix-scan-quick',
        'bin/retrieve-variation-seq',
        'bin/%(namelower)s',
        'bin/variation-scan',
    ],
    'dirs': ['share/%(namelower)s'],
}

moduleclass = 'bio'
