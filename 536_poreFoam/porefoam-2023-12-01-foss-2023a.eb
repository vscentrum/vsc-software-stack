# surfaceFormats/vtk/VTKsurfaceFormatCore.H:56:52: error: ‘unique_void_ptr’ was not declared in this scope
#    56 | using objRegistry = std::unordered_map<std::string,unique_void_ptr>;
#       |                                                    ^~~~~~~~~~~~~~~
# ...
