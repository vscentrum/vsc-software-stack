    #   FILE STRINGS file
    #   "/apps/gent/RHEL8/cascadelake-ib/software/Python/3.11.3-GCCcore-12.3.0/include/python3.11m/patchlevel.h"
    #   cannot be read.
    # Call Stack (most recent call first):
    #   VTK/CMake/vtkWrapPython.cmake:168 (find_package)
    #   VTK/Utilities/Python/CMakeLists.txt:4 (include)

    # Traceback (most recent call last):
    #   File "<string>", line 1, in <module>
    # ModuleNotFoundError: No module named 'mpi4py'
    # CMake Error at VTK/Parallel/MPI4Py/CMakeLists.txt:23 (include_directories):
    #   include_directories given empty-string as include directory.
