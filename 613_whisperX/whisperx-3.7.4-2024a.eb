easyblock = 'PythonBundle'

name = 'WhisperX'
version = '3.7.4'
versionsuffix = '-CUDA-%(cudaver)s'
local_pytorch_version = '2.7.1'

homepage = 'https://github.com/m-bain/whisperx'
description = "Automatic Speech Recognition with Word-level Timestamps (& Diarization)."

toolchain = {'name': 'foss', 'version': '2024a'}

## DEPS:
    # OK "ctranslate2>=4.5.0",
    # ok "faster-whisper>=1.1.1",
    # OK "nltk>=3.9.1",
    # ok "pandas>=2.2.3,<2.3.0",
    # ok "av<16.0.0",
    # OK "pyannote-audio>=3.3.2,<4.0.0",
    # OK "torch~=2.8.0",
    # OK "torchaudio~=2.8.0",
    # OK "transformers>=4.48.0",
    # OK "triton>=3.3.0; sys_platform == 'linux' and platform_machine == 'x86_64'" # only install triton on x86_64 Linux
    # faster-whisper 1.2.0 requires onnxruntime, which is not installed.
        # onnxruntime>=1.14,<2
    # whisperx 3.7.4 has requirement numpy<2.1.0,>=2.0.2; python_version < "3.13", but you have numpy 1.26.4.
    # whisperx 3.7.4 has requirement pandas<2.3.0,>=2.2.3, but you have pandas 2.2.2.
    # whisperx 3.7.4 has requirement torch~=2.8.0, but you have torch 2.7.1.
    # whisperx 3.7.4 has requirement torchaudio~=2.8.0, but you have torchaudio 2.7.1a0.

builddependencies = [('Cython', '3.0.10')]
dependencies = [
    ('CUDA', '12.6.0', '', SYSTEM),
    ('Python', '3.12.3'),
    ('PyTorch', '2.7.1', versionsuffix),
    ('SciPy-bundle', '2024.05'),
    ('CTranslate2', '4.5.0', versionsuffix),
    ('NLTK', '3.9.1'),
    ('Transformers', '4.55.0'),
    ('FFmpeg', '7.0.2'),
    # ('PyAV', '11.0.0'),
    ('ONNX-Runtime', '1.23.2', versionsuffix),
    ('pyannote.audio', '3.4.0', versionsuffix),
]

# unpin dependencies versions + fix onnxruntime-gpu check
local_whisperx_preinstallopts = (
"sed -E -i "
r"""-e '/^[[:space:]]*dependencies[[:space:]]*=[[:space:]]*[[]/,/^[[:space:]]*]/{s/"([^"<>!=~;[:space:]]+)[^"]*"/"\1"/g}' """
"-e 's/onnxruntime/onnxruntime-gpu/' pyproject.toml && "
)
exts_list = [
    ('faster-whisper', '1.2.0', {
        'preinstallopts': """sed -i 's/onnxruntime/onnxruntime-gpu/' requirements.txt && """,
        'checksums': ['56b20d616a575049a79f33b04f02db0868ce38c5d057a0b816d36ca59a6d2598'],
    }),
    ('av', '14.0.1', {
        'checksums': ['2b0a17301af469ddaea46b5c1c982df1b7b5de8bc6c94cdc98cad4a67178c82a'],
    }),
    (name, version, {
        'preinstallopts': local_whisperx_preinstallopts,
        'source_urls': ['https://github.com/m-bain/whisperX/archive/'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'checksums': ['ffe9ce94d8895e7ba6030f3cc35a357788a458462051422dda6428d2f95324a7'],
    }),
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["%(namelower)s -h"]

moduleclass = 'ai'
