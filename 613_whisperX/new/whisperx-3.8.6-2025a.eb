easyblock = 'PythonBundle'

name = 'WhisperX'
version = '3.8.6'
versionsuffix = '-CUDA-%(cudaver)s'
local_pytorch_version = '2.9.1'

homepage = 'https://github.com/m-bain/whisperx'
description = "Automatic Speech Recognition with Word-level Timestamps (& Diarization)."

toolchain = {'name': 'foss', 'version': '2025a'}

##DEPS:
    # OK "ctranslate2>=4.5.0",
    # ok "faster-whisper>=1.2.0",
        # OK ctranslate2>=4.0,<5
        # OK huggingface_hub>=0.21
        # OK tokenizers>=0.13,<1
        # ! onnxruntime>=1.14,<2 
        # ok av>=11
        # OK tqdm
    # ! "nltk>=3.9.1",
    # OK "numpy>=2.1.0",
    # ok "omegaconf>=2.3.0",
    # OK "pandas>=2.2.3",
    # OK "pyannote-audio>=4.0.0",
    # OK "huggingface-hub<1.0.0",
    # OK? "torch~=2.8.0",
    # OK "torchaudio~=2.8.0",
    # ! "torchvision~=0.23.0",
    # OK "torchcodec>=0.6.0,<0.8.0; (sys_platform == 'linux' and platform_machine == 'x86_64') or sys_platform == 'darwin' or sys_platform == 'win32'",
    # "transformers>=4.48.0",
    # OK "triton>=3.3.0; sys_platform == 'linux' and platform_machine == 'x86_64'" # only install triton on x86_64 Linux

builddependencies = [('Cython', '3.0.10')]
dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('PyTorch', local_pytorch_version, versionsuffix),
    ('SciPy-bundle', '2025.06'),
    ('CTranslate2', '4.8.1', versionsuffix),
    # ('NLTK', '3.9.1'),
    # ('Transformers', '4.55.0'),
    # ('ONNX-Runtime', '1.23.2', versionsuffix),
    ('pyannote.audio', '4.0.7', versionsuffix),
    ('huggingface-hub', '1.2.4'),
    ('tokenizers', '0.22.2'),
    ('tqdm', '4.67.1'),
]

# unpin versions of dependencies in WhisperX
# local_whisperx_preinstallopts = (
#     "sed -E -i "
#     r""" '/^[[:space:]]*dependencies[[:space:]]*=[[:space:]]*[[]/"""
#     r""",/^[[:space:]]*]/{s/"([^"<>!=~;[:space:]]+)[^"]*"/"\1"/g}' """
#     "pyproject.toml && "
# )

exts_list = [
    ('faster-whisper', '1.2.1', {
        'source_urls': ['https://github.com/SYSTRAN/faster-whisper/archive/'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'checksums': ['ff0b5428b3a074cd63f580ae73fa21f7d9fd3bba28e0e2e097868d78d5b06f2f'],
    }),
    ('av', '15.1.0', {
        'checksums': ['39cda2dc810e11c1938f8cb5759c41d6b630550236b3365790e67a313660ec85'],
    }),
    ('omegaconf', '2.3.0', {
        'checksums': ['d5d4b6d29955cc50ad50c46dc269bcd92c6e00f5f90d23ab5fee7bfca4ba4cc7'],
    }),
    ('torchvision', ''),  # copy from https://github.com/easybuilders/easybuild-easyconfigs/pull/25924
    (name, version, {
        # 'preinstallopts': local_whisperx_preinstallopts,
        'source_urls': ['https://github.com/m-bain/whisperX/archive/'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'checksums': ['fc0a7c2a72db1c0c280cf8bca75d266c25cd4ca9c44d4768f2f56a6b40d3d98b'],
    }),
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["%(namelower)s -h"]

moduleclass = 'ai'
