name = 'NAMD'
version = '3.0.1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://www.ks.uiuc.edu/Research/namd/'
description = """NAMD is a parallel molecular dynamics code designed for high-performance simulation of
 large biomolecular systems."""

toolchain = {'name': 'foss', 'version': '2024a'}
toolchainopts = {'usempi': False, 'openmp': False, 'pic': True}

# By downloading, you accept the HPC SDK Software License Agreement
# https://docs.nvidia.com/hpc-sdk/eula/index.html
# accept_eula = True
sources = ['NAMD_%(version)s_Source.tar.gz']
# download_instructions = f'Manually obtain {sources[0]} at'
# download_instructions += ' https://www.ks.uiuc.edu/Development/Download/download.cgi?PackageName=NAMD'
# patches = [
#     "%(name)s-%(version)s_Linux-POWER-cuda.patch",
# ]
checksums = [
    '3be0854545c45e58afb439a96708e127aef435d30113cc89adbab8f4b6888733',  # NAMD_2.14_Source.tar.gz
    # 'db4aeb482dfa805c859ea18940026395763169e0257401ee5341ca550029031c',  # NAMD-2.14_Linux-POWER-cuda.patch
]

dependencies = [
    ('Tcl', '8.6.14'),
    ('CUDA', '12.6.0', '', SYSTEM),
]

builddependencies = [
    ('tcsh', '6.24.13'),
]

charm_arch = "multicore-linux-%(arch)s"
charm_extra_cxxflags = '-fpermissive'

moduleclass = 'chem'

