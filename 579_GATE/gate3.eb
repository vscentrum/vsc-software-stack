    }),
    ('opengate_core', version, {
        'source_urls': ['https://github.com/OpenGATE/opengate/archive/'],
        'sources': [{'download_filename': '%(version)s.tar.gz', 'filename': 'opengate-%(version)s.tar.gz'}],
