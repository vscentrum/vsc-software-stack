        # OK? ITK needs to be build with this: -> in ITK-5.4.0 there is FFTW but not FFTWD and FFTWF
            # cmake -DCMAKE_CXX_FLAGS=-std=c++17 \
            # -DBUILD_TESTING=OFF \
            # -DITK_USE_FFTWD=ON \
            # -DITK_USE_FFTWF=ON \
            # -DITK_USE_SYSTEM_FFTW:BOOL=ON
    # ? Opengate_core install deps: ["wget", "colored>1.5", "requests"
        # OK builddeps:  "pybind11>=2.10.0"

builddependencies = [('pybind11', '2.11.1')]
dependencies = [
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'), 
    ('Geant4', '11.3.0'),
    ('ITK', '5.4.0'),  # opengate_core dep
    # ('wget', '1.21.4'),  # opengate_core dep
    ('fmt', '10.2.1'), # opengate_core dep
    # ('ROOT', '6.30.06'), UPDATE?
]

