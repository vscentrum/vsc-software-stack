# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild

easyblock = 'ConfigureMake'

name = 'ViennaRNA'
version = '2.7.1'

homepage = 'https://www.tbi.univie.ac.at/RNA/'
description = """The Vienna RNA Package consists of a C code library and several
stand-alone programs for the prediction and comparison of RNA secondary structures."""

toolchain = {'name': 'gfbf', 'version': '2025b'}
# workaround for:
# plex_functions.c:432:63: error: passing argument 4 of 'vrna_probs_window' from incompatible pointer type
# see also https://github.com/ViennaRNA/ViennaRNA/issues/280
toolchainopts = {'pic': True, 'extra_cflags': "-Wno-error=incompatible-pointer-types"}

source_urls = ['https://www.tbi.univie.ac.at/RNA/download/sourcecode/%(version_major)s_%(version_minor)s_x/']
sources = [SOURCE_TAR_GZ]
patches = ['ViennaRNA-2.7.0-flexiblas-for-RNAxplorer.patch']
checksums = [
    {'ViennaRNA-2.7.1.tar.gz': 'f8bc6bf07886a0015f9ba7379b4ae9dcfc272ecd16cb69243067b07088e841de'},
    {'ViennaRNA-2.7.0-flexiblas-for-RNAxplorer.patch':
     'a5c71e67193d489b9c4f2be6467da5d760f15ad562bb29c5c57f5ae38b3c51b3'},
]

builddependencies = [
    ('Autotools', '20250527'),
    ('flex', '2.6.4'),
    ('pkgconf', '2.4.3'),
    ('Bison', '3.8.2'),
    ('SWIG', '4.3.1'),
    ('Check', '0.15.2'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Perl', '5.40.2'),
    ('GSL', '2.8'),
    ('MPFR', '4.2.2'),
    ('libgd', '2.3.3'),
    ('X11', '20250608'),
]

# Fixes aclocal errors in 2.7.0
#preconfigopts = "autoreconf -f -i && "
# VRNA_NR_SAMPLING_HASH (--enable-NRhash) is broken, don't enable it
configopts = ' '.join([
    '--with-python3',
    '--with-cluster',
    '--with-kinwalker',
    '--enable-floatpf',
])
# Uncomment this if you compile on pre SSE4.1 CPU
# configopts += " --enable-sse "

buildopts = "V=1"

sanity_check_paths = {
    'files': ['bin/RNA%s' % x for x in ['fold', 'eval', 'heat', 'pdist', 'distance',
                                        'inverse', 'plot', 'subopt', 'Lfold', 'cofold',
                                        'paln', 'duplex', 'alifold', 'plfold', 'up',
                                        'aliduplex', 'Lalifold', '2Dfold', 'parconv',
                                        'PKplex', 'plex', 'snoop', 'forester']] +
    ['bin/Kinfold'],
    'dirs': ['lib/perl5/site_perl/%(perlver)s/', 'lib/python%(pyshortver)s/site-packages'],
}

modextrapaths = {
    'PERL5LIB': 'lib/perl5/site_perl/%(perlver)s/',
}

moduleclass = 'bio'
