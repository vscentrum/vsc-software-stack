easyblock = 'PythonBundle'

name = 'CNVkit'
version = '0.9.12-20260127'
versionsuffix = '-R-%(rver)s'
local_commit = 'c049fb93'

homepage = 'https://github.com/etal/cnvkit'
description = """A command-line toolkit and Python library for detecting copy
 number variants and alterations genome-wide from high-throughput sequencing."""

toolchain = {'name': 'foss', 'version': '2025a'}


builddependencies = [('Cython', '3.1.1')]
dependencies = [
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('scikit-learn', '1.7.0'),
    ('Biopython', '1.85'),
    ('matplotlib', '3.10.3'),
    ('networkx', '3.5'),
    # ('Pillow', '11.3.0'),
    ('Pysam', '0.23.3'),
    ('PyYAML', '6.0.2'),
    ('pyfaidx', '0.9.0.3'),
    ('R', '4.5.1'),
    ('R-bundle-Bioconductor', '3.22', versionsuffix),
]

# remove cython from install_requires
_pomegranate_preinstallopts = "sed -i '92d' setup.py && "
# delete and recythonize all the c files to be compatible with new python
_pomegranate_preinstallopts += "find . -name '*.c' -delete && "
        # 'preinstallopts': _pomegranate_preinstallopts,
        # # helps recythonize files
        # 'installopts': "--config-settings=--global-option=build_ext --config-settings=--global-option=--inplace",

exts_list = [
    ('reportlab', '4.4.9', {
        'checksums': ['7cf487764294ee791a4781f5a157bebce262a666ae4bbb87786760a9676c9378'],
    }),
    ('pomegranate', '1.1.2', {
        'checksums': ['bffe01521e8783ef84cb60862ea60161c2130835868d8a37b7d79477b328ad8f'],
    }),
    (name, version, {
        'modulename': 'cnvlib',
        'runtest': "pytest -v test",
        'source_urls': ['https://github.com/etal/cnvkit/archive/'],
        'sources': [{'download_filename': 'c049fb93.tar.gz', 'filename': '%(name)s-%(version)s-c049fb93.tar.gz'}],
        'testinstall': True,
        'checksums': ['16ecf98ba94d1542ce690fad7cf590033086e355c9679de7b534d79b1143d2ec'],
    }),
]

sanity_check_paths = {
    'files': ['bin/cnvkit.py'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = [
    'cnvkit.py --help',
    "python -s -c 'from pomegranate import base; from pomegranate.distributions import NormalDistribution'",
]

moduleclass = 'bio'

# latest commit has fix for numpy v2 -> also it needs pomegranate >= 1.0.0 but this version needs PyTorch -> has no PyTorch for 2025a yet -> go for 2024a