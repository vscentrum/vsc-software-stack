easyblock = 'Tarball'

name = 'MitoFinder'
version = '1.4.2'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://github.com/RemiAllio/MitoFinder'
description = """MitoFinder is a pipeline to assemble mitochondrial genomes and annotate mitochondrial genes from trimmed
read sequencing data"""

toolchain = {'name': 'foss', 'version': '2023a'}

source_urls = ['https://github.com/RemiAllio/MitoFinder/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['2d6d3925fb014777df97f272134143cc518944ae05d000a44ada2862d46ec95a']

# builddependencies = [('Autotools', '20220317')]
dependencies = [
    ('Java', '11', '', SYSTEM),
    ('Python', '2.7.18'),
    ('IDBA-UD', '1.1.3'), # should be v1.1.2
    ('Infernal', '1.1.5'), # should be v1.1.3
    ('tRNAscan-SE', '2.0.12'), # should be v2.0.6
]

postinstallcmds = [
    # "sed -i '2,9d' install.sh && "
    # "rm -rf idba/bin && "
    "ln -s $EBROOTIDBAMINUD/bin idba/bin && " # nor working - update
    # "sed -i '15,38d' install.sh && "
    # create /trnascanSE/infernal-1.1.3/exec dir and link the $EBROOTINFERNAL there (there should be ../exec/bin and ../exec/share)
    # create /trnascanSE/automake-1.13.4/exec dir and link the $EBROOTAUTOMAKE there (there should be ../exec/bin and ../exec/share)
    "cd %(installdir)s/metaspades/bin && ln -s spades.py metaspades.py && "
    'cd %(installdir)s && touch install.sh.ok'
]
# postinstallcmds = ['./install.sh']

fix_python_shebang_for = ['mitofinder']

sanity_check_paths = {
    'files': ['mitofinder'],
    'dirs': [],
}

sanity_check_commands = ['mitofinder -h']

modextrapaths = {'PATH': ''}

moduleclass = 'bio'

