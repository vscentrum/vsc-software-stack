easyblock = 'Tarball'

name = 'MitoFinder'
version = '1.4.2'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://github.com/RemiAllio/MitoFinder'
description = """MitoFinder is a pipeline to assemble mitochondrial genomes and annotate mitochondrial genes from trimmed
read sequencing data"""

toolchain = {'name': 'foss', 'version': '2023a'}

source_urls = ['https://github.com/RemiAllio/MitoFinder/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['2d6d3925fb014777df97f272134143cc518944ae05d000a44ada2862d46ec95a']

# builddependencies = [('Autotools', '20220317')]
dependencies = [
    ('Java', '11', '', SYSTEM),
    ('Python', '2.7.18'),
    ('IDBA-UD', '1.1.3'), # should be v1.1.2
    ('Infernal', '1.1.5'), # should be v1.1.3
    ('tRNAscan-SE', '2.0.12'), # should be v2.0.6
    ('Automake', '1.16.5'),
]

# rename = Popen(args1, stdout=open(os.devnull, 'wb'))
# MitoFinder root: /scratch/gent/vo/001/gvo00117/easybuild/RHEL8/cascadelake-ampere-ib/software/MitoFinder/1.4.2-foss-2023a-Python-2.7.18
# IDBA-UD root: /scratch/gent/vo/001/gvo00117/easybuild/RHEL8/cascadelake-ampere-ib/software/IDBA-UD/1.1.3-GCCcore-12.3.0/
postinstallcmds = [
    # avoid run install.sh
    # replace idba/bin by $EBROOTIDBAMINUD/bin
    "rm -rf %(installdir)s/idba/bin && cd %(installdir)s/idba && ln -s $EBROOTIDBAMINUD/bin && "
    # create link to metaspades.py
    "cd %(installdir)s/metaspades/bin && ln -s spades.py metaspades.py && "
    # create trnascanSE/infernal-1.1.3/exec dir and link the $EBROOTINFERNAL/bin and /share there
    "cd %(installdir)s/trnascanSE && mkdir -p infernal-1.1.3/exec && cd infernal-1.1.3/exec && "
    "ln -s $EBROOTINFERNAL/bin && ln -s $EBROOTINFERNAL/share && "
    # create /trnascanSE/automake-1.13.4/exec dir and link the $EBROOTAUTOMAKE/bin and /share there
    "cd %(installdir)s/trnascanSE && mkdir -p automake-1.13.4/exec && cd automake-1.13.4/exec && "
    "ln -s $EBROOTAUTOMAKE/bin && ln -s $EBROOTAUTOMAKE/share && "
    # create trnascanSE/tRNAscan-SE-2.0/exec dir and link the $EBROOTTRNASCANMINSE/bin and /lib and /include there
    "cd %(installdir)s/trnascanSE && mkdir -p tRNAscan-SE-2.0/exec && cd tRNAscan-SE-2.0/exec && "
    "ln -s $EBROOTTRNASCANMINSE/bin && ln -s $EBROOTTRNASCANMINSE/lib && ln -s $EBROOTTRNASCANMINSE/include && "
    # create mitfi/infernal-1.0.2/exec dir and link the $EBROOTINFERNAL/bin and /share there
    "cd %(installdir)s/mitfi && mkdir -p infernal-1.0.2/exec && cd infernal-1.0.2/exec && "
    "ln -s $EBROOTINFERNAL/bin && ln -s $EBROOTINFERNAL/share && "
    # create install.sh.ok
    'cd %(installdir)s && touch install.sh.ok && '
    # fix mitofinder
    "sed -i 's/os.devnull, \'wb\')/os.devnull, \'wb\'), shell=True/g' mitofinder"
]

fix_python_shebang_for = ['mitofinder', '*.py']

sanity_check_paths = {
    'files': ['mitofinder'],
    'dirs': [],
}

sanity_check_commands = ['mitofinder -h']

modextrapaths = {'PATH': ''}

moduleclass = 'bio'

