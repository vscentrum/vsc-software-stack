#!/usr/bin/env Rscript
suppressPackageStartupMessages(library(SpaGene))

cat("SpaGene version:", as.character(packageVersion("SpaGene")), "\n")

set.seed(123)

nx <- 20; ny <- 20
loc <- as.matrix(expand.grid(x=1:nx, y=1:ny))  # ncell x 2
ncell <- nrow(loc)

ng <- 60
expr <- matrix(rpois(ng*ncell, lambda=1), nrow=ng, ncol=ncell)
rownames(expr) <- c("Gene_cluster1","Gene_cluster2","Gene_cluster3", paste0("Gene", 4:ng))
colnames(expr) <- paste0("Spot", 1:ncell)

in_circle <- function(cx, cy, r) ((loc[,1]-cx)^2 + (loc[,2]-cy)^2) <= r^2
c1 <- which(in_circle(5, 5, 3))
c2 <- which(in_circle(16, 15, 3))
c3 <- which(in_circle(5, 16, 3))

expr["Gene_cluster1", c1] <- expr["Gene_cluster1", c1] + 25
expr["Gene_cluster2", c2] <- expr["Gene_cluster2", c2] + 25
expr["Gene_cluster3", c3] <- expr["Gene_cluster3", c3] + 25

res <- SpaGene(expr=expr, location=loc, normalize=TRUE, topn=30, knn=8, perm=100, minN=0)
stopifnot(is.list(res), all(c("normexp","spagene_res") %in% names(res)))
stopifnot(all(c("score","zval","pval","adjp") %in% colnames(res$spagene_res)))  # per docs/implementation :contentReference[oaicite:1]{index=1}

tab <- res$spagene_res[order(res$spagene_res$adjp),]
cat("Top hits (lowest adjp):\n")
print(head(tab, 10))

hits <- rownames(tab)[tab$adjp < 0.05]
cat("Significant genes (adjp<0.05):", paste(hits, collapse=", "), "\n")

expected <- c("Gene_cluster1","Gene_cluster2","Gene_cluster3")
if (!all(expected %in% hits)) {
  missing <- expected[!(expected %in% hits)]
  stop("FAIL: expected clustered genes not detected: ", paste(missing, collapse=", "))
}

pat <- FindPattern(res, cutoff=0.05, nPattern=2)
stopifnot(is.list(pat), all(c("pattern","genepattern","patternw") %in% names(pat)))  # per docs/implementation :contentReference[oaicite:2]{index=2}
stopifnot(nrow(pat$pattern) == 2, ncol(pat$pattern) == ncell)

cat("PASS: SpaGene + FindPattern ran successfully and detected expected spatial genes.\n")
