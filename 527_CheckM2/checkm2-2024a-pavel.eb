easyblock = 'PythonBundle'

name = 'CheckM2'
version = '1.1.0'

homepage = 'https://github.com/chklovski/CheckM2/'
description = "Assessing the quality of metagenome-derived genome bins using machine learning"

toolchain = {'name': 'foss', 'version': '2024a'}

