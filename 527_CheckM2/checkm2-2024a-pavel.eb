    ('CMake', '3.29.3'),
    ('scikit-build-core', '0.10.6'),
]
dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05'),
    ('DIAMOND', '2.1.11'),
    # ('TensorFlow', '2.13.0'),
