easyblock = 'ConfigureMake'

name = 'cuDF-source'
version = '24.10.01'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/rapidsai/cudf'
description = """Benchmark-only source-built cuDF 24.10.01 install."""

toolchain = {'name': 'foss', 'version': '2024a'}

source_urls = ['https://github.com/rapidsai/cudf/archive/']
sources = [{
    'download_filename': 'v%(version)s.tar.gz',
    'filename': '%(name)s-%(version)s.tar.gz',
}]
checksums = ['daa270c1e9223f098823491606bad2d9b10577d4bea8e543ae80265f1cecc0ed']

builddependencies = [
    ('CMake', '3.31.8'),
    ('Cython', '3.0.10'),
]

dependencies = [
    ('CUDA', '12.6.0', '', SYSTEM),
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05'),
    ('Arrow', '17.0.0'),
    ('numba', '0.60.0'),
    ('CUDA-Python', '12.6.2.post1', '-CUDA-%(cudaver)s'),
]


# build.sh handles the actual build+install
# skipsteps = ['configure']
skipsteps = ['build', 'install']

preconfigopts = (
    'export INSTALL_PREFIX=%(installdir)s && '
    'export CUDACXX=$CUDA_HOME/bin/nvcc && '
    'export PARALLEL_LEVEL=%(parallel)s && '
)

configure_without_installdir = True
configure_cmd = './build.sh libcudf cudf'
# buildopts = 'libcudf cudf'

# build.sh already installs into $INSTALL_PREFIX
# install_cmd = 'true'

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages/cudf'],
}

sanity_check_commands = [
    'python -sc "python -m pip check"',
    # "python -c \"import cudf; print(cudf.__version__)\"",
    # "python -c \"import cudf; df=cudf.DataFrame({'a':[1,2,3]}); print(int(df['a'].sum()))\" | grep 6",
]

moduleclass = 'data'
