#FROM PR 24667
easyblock = 'PythonBundle'

name = 'CUDA-Python'
# Warning: major versions of CUDA and CUDA-Python are tied (not minor) - pick latest v12.x.x
version = '12.9.2'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://nvidia.github.io/cuda-python/'
description = "Python bindings for CUDA"
github_account = 'NVIDIA'

toolchain = {'name': 'gfbf', 'version': '2024a'}

builddependencies = [
    ('Cython', '3.0.10'),
]
dependencies = [
    ('CUDA', '12.6.0', '', SYSTEM),
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05'),
    ('setuptools', '80.9.0'),
]

local_cuda_python_sources = [{'download_filename': f'v{version}.tar.gz', 'filename': f'{name}-{version}.tar.gz'}]
local_cuda_python_source_urls = ['https://github.com/%(github_account)s/cuda-python/archive']

exts_list = [
    ('pyclibrary', '0.3.0', {
        'checksums': ['8a3eaa9ab728c11b077644275af4e05ca24ddcad491f47eb45b75db6be52c654'],
    }),
    ('cuda-bindings', version, {
        'modulename': 'cuda.bindings',
        'source_urls': local_cuda_python_source_urls,
        'sources': local_cuda_python_sources,
        'start_dir': 'cuda_bindings',
        'checksums': ['14ed346e848f796929516ebce1e3b33567c4f285abf44aa767ec8e9542ca6a68'],
    }),
    ('cuda-core', '0.3.1', {
        'modulename': 'cuda.core',
        'source_urls': local_cuda_python_source_urls,
        'sources': local_cuda_python_sources,
        'start_dir': 'cuda_core',
        'checksums': ['14ed346e848f796929516ebce1e3b33567c4f285abf44aa767ec8e9542ca6a68'],
    }),
    ('cuda-pathfinder', '1.1.0', {
        'modulename': 'cuda.pathfinder',
        'source_urls': local_cuda_python_source_urls,
        'sources': local_cuda_python_sources,
        'start_dir': 'cuda_pathfinder',
        'checksums': ['14ed346e848f796929516ebce1e3b33567c4f285abf44aa767ec8e9542ca6a68'],
    }),
    ('cuda-python', version, {
        # this is only metapackage
        'modulename': False,
        'source_urls': local_cuda_python_source_urls,
        'sources': local_cuda_python_sources,
        'start_dir': 'cuda_python',
        'checksums': ['14ed346e848f796929516ebce1e3b33567c4f285abf44aa767ec8e9542ca6a68'],
    }),
]

sanity_check_commands = [
    "python -sc 'from cuda import cuda, nvrtc'",
    "python -sc 'from cuda.bindings import driver, nvrtc'",
]

moduleclass = 'lib'

