    # !!OK?? ucx-py-cu12 0.40.0 requires libucx-cu12<1.18,>=1.15.0, which is not installed. -> add to the CUDA-wheel-bundle (UCX is dep of NCCL)
    # ok distributed-ucxx-cu12 0.40.0 requires ucxx-cu12==0.40.*, which is not installed.

dependencies = [
    ('CUDA', '12.6.0', '', SYSTEM),
    ('Python', '3.12.3'),
    ('CUDA-Python', '12.6.2.post1', versionsuffix),
    ('CUDA-wheel-bundle', '%(cudaver)s', versionsuffix),  # provides nvidia-nccl-cu12-2.26.2.post1, libucx-cu12, nvidia-cublas-cu12,...
    ('SciPy-bundle', '2024.05'),
    ('Arrow', '17.0.0'),
    ('numba', '0.60.0'),
    ('dask', '2024.9.1'),
]

exts_default_options = {'source_urls': [PYPI_SOURCE, 'https://pypi.nvidia.com/%(name)s-cu%(cudamajver)s']}
_rapids_whl_name = '%(name)s_cu%(cudamajver)s-%(version)s-'
_rapids_whl_cp_version = 'cp%(pymajver)s%(pyminver)s-cp%(pymajver)s%(pyminver)s'
# _rapids_whl_linux = '-manylinux_2_24_%(arch)s.manylinux_2_28_%(arch)s.whl'
# _rapids_tmpl = _rapids_whl_name + _rapids_whl_cp_version + _rapids_whl_linux
_rapids_tmpl = _rapids_whl_name + _rapids_whl_cp_version

