        # bin  ChangeLog  COPYING  demo  doc  ext  int  lib  main  python  README  setup.py  src  tests  TODO

# INSTALL:
    # 1: create mod dir in builddir/modpipe-2.3.1/ext -> builddir/modpipe-2.3.1/ext/mod
        # then run bash commands which replace Installer
    # ?2: move guess-arch.sh to builddir/modpipe-2.3.1/ext/mod/bin
    # 3. Rename $MODPIPE/ext/mod/bin/modpy.sh to modpy.sh.in
    # 4. Edit first 2 lines of modpy.sh.in:
        # TOPDIR="@MODPIPEBASE@/ext/mod" -> /tmp/vsc47063/easybuild/build/ModPipe/2.3.1/foss-2025b/modpipe-2.3.1
        # EXETYPE=`${TOPDIR}/bin/guess-arch.sh set` or 'x86_64-intel8'

dependencies = [
    ('Perl', '5.40.2'),
    # ('Perl-bundle-CPAN', '5.40.2'),
    ('Python', '3.13.5'),
    ('GLib', '2.85.3'),
    ('BLAST', '2.2.26', '-Linux_x86_64', SYSTEM),
    ('HH-suite', '3.3.0-2025-08-12'),
]

local_modeller_cmds = "mkdir %(builddir)s/modpipe-2.3.1/ext/mod && "
local_modeller_cmds += "ls -al"

default_easyblock = 'CmdCp'
components = [
    ('Modeller', '10.7', {
        'source_urls': ['https://salilab.org/modeller/10.7/'],
        'sources': [SOURCELOWER_TAR_GZ],
        # 'start_dir': '%(namelower)s-%(version)s',
        # 'cmds_map': [('.*', local_modeller_cmds)],
        'build_cmd': local_modeller_cmds,
        # 'files_to_copy': [(['libm1qn3.a', 'libddot.a'], 'lib')],
        'checksums': ['b81ffee26841ef96470341889fa4af560f968cf35ef990d95480c7eb7a5b5c8f'],
    }),
    (name, version, {
        'source_urls': ['https://salilab.org/modpipe/'],
        'sources': [SOURCELOWER_TAR_GZ],
        'checksums': ['a006f436305d5f582f9ce461c73f8f02e1eb6fd416705276373697715209a4a6'],
        # 'cmds_map': [('.*', "cp %(name)s-%(version)s%(versionsuffix)s tbl2asn")],
        # 'files_to_copy': [(['tbl2asn'], 'bin')],
    }),
]

fix_perl_shebang_for = ['*.pl']

sanity_check_paths = {
    'files': ['%(namelower)s.pl'],
    'dirs': ['lib/perl5/site_perl'],
}

# sanity_check_commands = [
#     "%(namelower)s.pl -v",
#     "%(namelower)s.pl -h 2>&1 | grep 'pattern.*in.*output'",
# ]

