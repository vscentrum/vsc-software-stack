easyblock = 'PythonPackage'

name = 'ModPipe'
version = '2.3.1'
versionsuffix =  '-Linux_x86_64'
_modeller_version = '10.7'

homepage = 'https://salilab.org/modpipe'
description = """
ModPipe is a completely automated software pipeline that can calculate protein structure models for a large number
of sequences with almost no manual intervention. In the simplest case, it takes as input a sequence identifier and
a configuration file and produces one or more comparative models for that sequence. 
"""

toolchain = {'name': 'foss', 'version': '2025b'}

source_urls = ['https://salilab.org/modpipe/']
sources = [
    SOURCELOWER_TAR_GZ,
    {
        'source_urls': [f'https://salilab.org/modeller/{_modeller_version}/'],
        'filename': f'modeller-{_modeller_version}.tar.gz',
    },
]
checksums = [
    {'modpipe-2.3.1.tar.gz': 'a006f436305d5f582f9ce461c73f8f02e1eb6fd416705276373697715209a4a6'},
    {'modeller-10.7.tar.gz': 'b81ffee26841ef96470341889fa4af560f968cf35ef990d95480c7eb7a5b5c8f'},
]

# DEPS:
    # MODELLER - this needs to be installed to $MODPIPE/ext/mod/ sources + 
        # Move the guess-arch.sh script from the ext directory to $MODPIPE/ext/mod/bin/ +
        # Rename $MODPIPE/ext/mod/bin/modpy.sh to modpy.sh.in; edit so the first two lines read:
            # TOPDIR="@MODPIPEBASE@/ext/mod"
            # EXETYPE=`${TOPDIR}/bin/guess-arch.sh set`
        # https://salilab.org/modeller/10.7/modeller-10.7.tar.gz
        # DEPS:
            # glibc >= 2.3
        # license_key: MODELIRANJE
    # OK BLAST
        # ModPipe is tested with BLAST 2.2.13
        # add: setup.py --with-blast=$EBROOTBLAST
    # OK HH-suite
        # ModPipe is tested with hhsuite-2.0.16-linux-x86_64.tar.gz
        # --with-hhsuite=$EBROOTHHMINSUITE
    # CD-HIT (optional)
        # ModPipe is tested with CD-HIT 2007-0131
        # --with-cd-hit=...
        # or disable with: --with-cd-hit=no


# now I have:
    # /tmp/vsc47063/easybuild/build/ModPipe/2.3.1/foss-2025b-Linux_x86_64 = builddir
    # /tmp/vsc47063/easybuild/build/ModPipe/2.3.1/foss-2025b-Linux_x86_64/modpipe-2.3.1 = start_dir
    # modeller-10.7/
        # bin  ChangeLog  doc  examples  Install  INSTALLATION  lib  modlib  README  src
    # modpipe-2.3.1/
        # bin  ChangeLog  COPYING  demo  doc  ext  int  lib  main  python  README  setup.py  src  tests  TODO

# INSTALL:
    # EXECUTABLE_TYPE = x86_64-intel8
    # 1: create mod dir in builddir/modpipe-2.3.1/ext -> builddir/modpipe-2.3.1/ext/mod
        # then run bash commands which replace Installer
            # README INSTALLATION doc examples modlib src -> /mod
            # bin/*.top bin/lib bin/mod10.7_${EXECUTABLE_TYPE} -> /mod/bin
            # lib/${EXECUTABLE_TYPE} -> /mod/lib/
    # ?2: move guess-arch.sh to builddir/modpipe-2.3.1/ext/mod/bin -> it is not probably used anymore, EXECUTABLE_TYPE10v7 is set
    # 3. Rename $MODPIPE/ext/mod/bin/modpy.sh to modpy.sh.in
    # 4. Edit first 2 lines of modpy.sh.in:
        # TOPDIR="@MODPIPEBASE@/ext/mod" -> /tmp/vsc47063/easybuild/build/ModPipe/2.3.1/foss-2025b/modpipe-2.3.1
        # EXETYPE=`${TOPDIR}/bin/guess-arch.sh set` or 'x86_64-intel8'

dependencies = [
    ('Perl', '5.40.2'),
    ('Python', '3.13.5'),
    ('GLib', '2.85.3'),
    ('BLAST', '2.2.26', '-Linux_x86_64', SYSTEM),
    ('HH-suite', '3.3.0-2025-08-12'),
    ('PyYAML', '6.0.2'),
]

# Install Modeller-10.7 into the builddir of ModPipe - replace interactive install script
# export MODELLER_LICENSE_KEY=your license key or this will fail
_modeller_exe_version = '10v7'
_modeller_installdir = '%(builddir)s/modpipe-%(version)s/ext/mod'
_modeller_builddir = f'%(builddir)s/modeller-{_modeller_version}'
_cfg = f'{_modeller_installdir}/modlib/modeller/config.py'
local_modeller_cmds = (
    f"mkdir -p {_modeller_installdir}/bin {_modeller_installdir}/lib && "
    f"cd {_modeller_builddir} && cp -a README INSTALLATION doc examples modlib src {_modeller_installdir} && "
    f"cd {_modeller_builddir}/bin && "
    f"cp -a *.top lib mod{_modeller_version}_x86_64-intel8 {_modeller_installdir }/bin && "
    f"cd {_modeller_builddir}/lib && cp -a x86_64-intel8 {_modeller_installdir}/lib && "
    f"sed -e 's/EXECUTABLE_TYPE{_modeller_exe_version}=xxx/EXECUTABLE_TYPE{_modeller_exe_version}=x86_64-intel8/' "
    rf"-e 's|MODINSTALL{_modeller_exe_version}=xxx|MODINSTALL{_modeller_exe_version}=\"{_modeller_installdir}\"|' "
    f'{_modeller_builddir}/bin/modscript > {_modeller_installdir}/bin/mod{_modeller_version} && '
    rf"sed -e 's|@TOPDIR@|\"{_modeller_installdir}\"|' -e 's/@EXETYPE@/x86_64-intel8/' "
    f'{_modeller_builddir}/bin/modpy.sh.in > {_modeller_installdir}/bin/modpy.sh && '
    f'chmod a+x {_modeller_installdir}/bin/mod{_modeller_version} {_modeller_installdir}/bin/modpy.sh && '
    # f'printf "%s\\n" "import os" >> "{_modeller_installdir}/modlib/modeller/config.py" && '
    f'printf "%s\n" "install_dir = \'{_modeller_installdir}\'" >> "{_cfg}" && '
    # f'printf "%s\n" "license = __import__('os').getenv('MODELLER_LICENSE_KEY', 'set MODELLER_LICENSE_KEY with your license key.')" > "{_modeller_installdir}/modlib/modeller/config.py" && '
    # f'printf "%s\n" "license = os.getenv(\'MODELLER_LICENSE_KEY\', \'set MODELLER_LICENSE_KEY with your license key.\')" >> "{_modeller_installdir}/modlib/modeller/config.py" && '
    """printf "%s\n" "license = __import__('os').getenv('MODELLER_LICENSE_KEY', """
    f"""'set MODELLER_LICENSE_KEY with your license key.')" > "{_cfg}" && """
    f'cp %(builddir)s/modpipe-%(version)s/ext/guess-arch.sh {_modeller_installdir}/bin/guess-arch.sh && '
    "cd %(start_dir)s && "
)

# install by 'python setup.py'
use_pip = False

# the paths in scripts are changed during the python setup.py based on cwd
buildininstalldir = True

# do not use installstep - can not get rid of --prefix=
# skipsteps = ['build']
# preinstallopts = local_modeller_cmds
# fix path of HHPaths.pm from HH-suite
# preinstallopts += "sed -i 's|lib/hh/scripts/HHPaths.pm|scripts/HHPaths.pm|' %(builddir)s/modpipe-2.3.1/setup.py && "
# install_target = '--with-blast=$EBROOTBLAST/bin --with-hhsuite=$EBROOTHHMINSUITE'

skipsteps = ['install']
prebuildopts = local_modeller_cmds
# fix path of HHPaths.pm from HH-suite
prebuildopts += "sed -i 's|lib/hh/scripts/HHPaths.pm|scripts/HHPaths.pm|' %(builddir)s/modpipe-2.3.1/setup.py && "
buildcmd = '--with-blast=$EBROOTBLAST/bin --with-hhsuite=$EBROOTHHMINSUITE'

# clean installdir
postinstallcmds = [f"rm -r %(builddir)s/modeller-{_modeller_version}"]

fix_perl_shebang_for = ['*.pl']
fix_python_shebang_for = ['*.py']

sanity_check_paths = {
    'files': ['%(namelower)s-%(version)s/bin/%(namelower)s'],
    'dirs': ['%(namelower)s-%(version)s/bin', '%(namelower)s-%(version)s/lib'],
}

sanity_check_commands = ['%(namelower)s help']

# export HHLIB = $EBROOTHHMINSUITE -> already set in hh-suite ec
modextrapaths = {
    'PATH': '%(namelower)s-%(version)s/bin',
    'PERL5LIB': '%(namelower)s-%(version)s/lib/perl',
    'PYTHONPATH': '%(namelower)s-%(version)s/lib/python'
}

moduleclass = 'tools'

# ModPipe was not configured with CE
# ModPipe was not configured with JESS
# SPASM is not available, because ModPipe was not configured with it, --with-spasm
# ModPipe was not configured with CD-HIT
# ModPipe was not configured with TMalign
# ModPipe was not configured with SEG

