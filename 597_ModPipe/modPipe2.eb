easyblock = 'PythonPackage'

name = 'ModPipe'
version = '2.3.1'
versionsuffix =  '-Linux_x86_64'

homepage = 'https://salilab.org/modpipe'
description = """
ModPipe is a completely automated software pipeline that can calculate protein structure models for a large number
of sequences with almost no manual intervention. In the simplest case, it takes as input a sequence identifier and
a configuration file and produces one or more comparative models for that sequence. 
"""

toolchain = {'name': 'foss', 'version': '2025b'}
# https://salilab.org/modpipe/modpipe-2.3.1.tar.gz
source_urls = ['https://salilab.org/modpipe/']
sources = [
    # {
    #     'download_filename': SOURCELOWER_TAR_GZ,
    #     'filename': '%(namelower)s-%(version)s.tar.gz',
    # },
    SOURCELOWER_TAR_GZ,
    {
        'source_urls': ['https://salilab.org/modeller/10.7/'],
        'filename': 'modeller-10.7.tar.gz',
        # 'extract_cmd': "tar -C %(namelower)s-%(version)s/third_party/METIS --strip-components=1 -xf %s",
    },
]
checksums = [
    {'modpipe-2.3.1.tar.gz': 'a006f436305d5f582f9ce461c73f8f02e1eb6fd416705276373697715209a4a6'},
    {'modeller-10.7.tar.gz': 'b81ffee26841ef96470341889fa4af560f968cf35ef990d95480c7eb7a5b5c8f'},
]

# sources = [SOURCELOWER_TAR_GZ]
# DEPS:
    # MODELLER - this needs to be installed to $MODPIPE/ext/mod/ sources + 
        # Move the guess-arch.sh script from the ext directory to $MODPIPE/ext/mod/bin/ +
        # Rename $MODPIPE/ext/mod/bin/modpy.sh to modpy.sh.in; edit so the first two lines read:
            # TOPDIR="@MODPIPEBASE@/ext/mod"
            # EXETYPE=`${TOPDIR}/bin/guess-arch.sh set`
        # https://salilab.org/modeller/10.7/modeller-10.7.tar.gz
        # DEPS:
            # glibc >= 2.3
        # license_key: MODELIRANJE
    # OK BLAST
        # ModPipe is tested with BLAST 2.2.13
        # add: setup.py --with-blast=$EBROOTBLAST
    # OK HH-suite
        # ModPipe is tested with hhsuite-2.0.16-linux-x86_64.tar.gz
        # --with-hhsuite=$EBROOTHHMINSUITE
    # CD-HIT (optional)
        # ModPipe is tested with CD-HIT 2007-0131
        # --with-cd-hit=...


# now I have /tmp/vsc47063/easybuild/build/ModPipe/2.3.1/foss-2025b-Linux_x86_64 = builddir
    # /tmp/vsc47063/easybuild/build/ModPipe/2.3.1/foss-2025b-Linux_x86_64/modpipe-2.3.1 = start_dir
    # modeller-10.7/
        # bin  ChangeLog  doc  examples  Install  INSTALLATION  lib  modlib  README  src
    # modpipe-2.3.1/
        # bin  ChangeLog  COPYING  demo  doc  ext  int  lib  main  python  README  setup.py  src  tests  TODO

# INSTALL:
    # EXECUTABLE_TYPE = x86_64-intel8
    # 1: create mod dir in builddir/modpipe-2.3.1/ext -> builddir/modpipe-2.3.1/ext/mod
        # then run bash commands which replace Installer
            # README INSTALLATION doc examples modlib src -> /mod
            # bin/*.top bin/lib bin/mod10.7_${EXECUTABLE_TYPE} -> /mod/bin
            # lib/${EXECUTABLE_TYPE} -> /mod/lib/
    # ?2: move guess-arch.sh to builddir/modpipe-2.3.1/ext/mod/bin
    # 3. Rename $MODPIPE/ext/mod/bin/modpy.sh to modpy.sh.in
    # 4. Edit first 2 lines of modpy.sh.in:
        # TOPDIR="@MODPIPEBASE@/ext/mod" -> /tmp/vsc47063/easybuild/build/ModPipe/2.3.1/foss-2025b/modpipe-2.3.1
        # EXETYPE=`${TOPDIR}/bin/guess-arch.sh set` or 'x86_64-intel8'

dependencies = [
    ('Perl', '5.40.2'),
    # ('Perl-bundle-CPAN', '5.40.2'),
    ('Python', '3.13.5'),
    ('GLib', '2.85.3'),
    ('BLAST', '2.2.26', '-Linux_x86_64', SYSTEM),
    ('HH-suite', '3.3.0-2025-08-12'),
]

local_modeller_cmds = "mkdir -p %(builddir)s/modpipe-2.3.1/ext/mod/bin %(builddir)s/modpipe-2.3.1/ext/mod/lib && "
local_modeller_cmds += "cd %(builddir)s/modeller-10.7 && cp -a README INSTALLATION doc examples modlib src %(builddir)s/modpipe-2.3.1/ext/mod && "
local_modeller_cmds += "cd %(builddir)s/modeller-10.7/bin && cp -a *.top lib mod10.7_x86_64-intel8 %(builddir)s/modpipe-2.3.1/ext/mod/bin && "
local_modeller_cmds += "cd %(builddir)s/modeller-10.7/lib && cp -a x86_64-intel8 %(builddir)s/modpipe-2.3.1/ext/mod/lib && "
# local_modeller_cmds += r"sed -i -e 's/EXECUTABLE_TYPE10v7=xxx/EXECUTABLE_TYPE10v7=x86_64-intel8/' -e 's|MODINSTALL10v7=xxx|MODINSTALL10v7=\"%(builddir)s/modpipe-2.3.1/ext/mod\"|' "
local_modeller_cmds += r"sed -e 's/EXECUTABLE_TYPE10v7=xxx/EXECUTABLE_TYPE10v7=x86_64-intel8/' -e 's|MODINSTALL10v7=xxx|MODINSTALL10v7=\"%(builddir)s/modpipe-2.3.1/ext/mod\"|' "
local_modeller_cmds += '%(builddir)s/modeller-10.7/bin/modscript > %(builddir)s/modpipe-2.3.1/ext/mod/bin/mod10.7 && '
# local_modeller_cmds += r"sed -i -e 's|@TOPDIR@|\"%(builddir)s/modpipe-2.3.1/ext/mod\"|' -e 's/@EXETYPE@/x86_64-intel8/' "
local_modeller_cmds += r"sed -e 's|@TOPDIR@|\"%(builddir)s/modpipe-2.3.1/ext/mod\"|' -e 's/@EXETYPE@/x86_64-intel8/' "
local_modeller_cmds += '%(builddir)s/modeller-10.7/bin/modpy.sh.in > %(builddir)s/modpipe-2.3.1/ext/mod/bin/modpy.sh && '
local_modeller_cmds += 'chmod a+x %(builddir)s/modpipe-2.3.1/ext/mod/bin/mod10.7 %(builddir)s/modpipe-2.3.1/ext/mod/bin/modpy.sh && '
local_modeller_cmds += "export MODELLER_KEY=MODELIRANJE && "
local_modeller_cmds += r'printf "install_dir = \'%(builddir)s/modpipe-2.3.1/ext/mod\'\nlicense = \'${MODELLER_KEY}\'\n" > "%(builddir)s/modpipe-2.3.1/ext/mod/modlib/modeller/config.py" && '
local_modeller_cmds += 'cp %(builddir)s/modpipe-2.3.1/ext/guess-arch.sh %(builddir)s/modpipe-2.3.1/ext/mod/bin/guess-arch.sh && '
local_modeller_cmds += "cd %(start_dir)s && "

preinstallopts = local_modeller_cmds
use_pip = False
buildcmd = '--with-blast=$EBROOTBLAST --with-hhsuite=$EBROOTHHMINSUITE'
fix_perl_shebang_for = ['*.pl']
fix_python_shebang_for = ['*.py']

sanity_check_paths = {
    'files': ['%(namelower)s.pl'],
    'dirs': ['lib/perl5/site_perl'],
}

# sanity_check_commands = [
#     "%(namelower)s.pl -v",
#     "%(namelower)s.pl -h 2>&1 | grep 'pattern.*in.*output'",
# ]

# modextrapaths = {
#     'PATH': '',
#     'PERL5LIB': 'lib/perl5/site_perl',
# }

moduleclass = 'tools'

