]

for _provider, _owner, _repo, _commit, _name in _github_repos:
    sources.append({
        'filename': '%s-%s.tar.xz' % (_name, _commit[:8]),
        'git_config': {
            'url': f'https://{_provider}.com/{_owner}',
            'repo_name': _repo,
            'commit': _commit,
            'clone_into': _name,
        },
    })

