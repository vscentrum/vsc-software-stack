easyblock = 'Bundle'

name = 'fortranGIS'
version = '3.0-1'

homepage = 'https://github.com/ARPA-SIMC/fortrangis'
description = """FortranGIS project includes a collection of Fortran interfaces to some common
Open Source GIS (Geographic Information System) software libraries, plus some more Fortran-specific tools."""

toolchain = {'name': 'intel', 'version': '2025b'}
# toolchainopts = {'usempi': True}
toolchainopts = {'pic': True}

# source_urls = ['https://github.com/ARPA-SIMC/fortrangis/archive/']
# sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
# checksums = ['c452f2cbaf870627aefef36d872cb5c2a1f13d6fe1c31e2e7fa754fcdaa98fa3']

# patches = ['%(name)s-3.6.2_fix-python-CC-CXX.patch']

builddependencies = [
    ('CMake', '3.31.8'),
    # PROJ
    ('pkgconf', '2.4.3'),
    ('googletest', '1.17.0'),
    # ('pkgconf', '2.4.3'),
    # ('Bison', '3.8.2'),
]
dependencies = [
    ('XZ', '5.8.1'),
    ('SQLite', '3.50.1'),
    ('LibTIFF', '4.7.0'),
    ('cURL', '8.14.1'),
    ('GDAL', '3.11.3'),
    # ('nlohmann_json', '3.12.0'),
]


default_easyblock = 'CMakeMake'

components = [
    ('PROJ', '7.2.1', {
        'source_urls': ['https://download.osgeo.org/proj/'],
        'sources': [SOURCELOWER_TAR_GZ],
        'start_dir': '%(namelower)s-%(version)s',
        'checksums': ['b384f42e5fb9c6d01fe5fa4d31da2e91329668863a684f97be5d4760dbbf0a14'],
    }),
    (name, version, {
        'source_urls': ['https://github.com/ARPA-SIMC/fortrangis/archive/'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'configopts': '-DBUILD_SHAPELIB=OFF -DCMAKE_Fortran_FLAGS="$FFLAGS -I/%(start_dir)s/include"',
        'checksums': ['c452f2cbaf870627aefef36d872cb5c2a1f13d6fe1c31e2e7fa754fcdaa98fa3'],
    })
]

# configopts = '-DBUILD_SHAPELIB=OFF -DCMAKE_Fortran_FLAGS="$FFLAGS -I/%(start_dir)s/include"'

# prebuildopts = "sed -i '22 a include_directories(${PROJECT_SOURCE_DIR}/include)' CMakeLists.txt && "

# # iterative build for both static and shared libraries
# local_configopts_common = "-DGDAL_USE_INTERNAL_LIBS=OFF -DGDAL_USE_MYSQL=OFF -DGDAL_USE_POPPLER=OFF "
# local_configopts_common += "-DGEOTIFF_INCLUDE_DIR=$EBROOTLIBGEOTIFF/include -DPython_ROOT=$EBROOTPYTHON "

# configopts = [
#     local_configopts_common + "-DBUILD_SHARED_LIBS=OFF",
#     local_configopts_common
# ]


# sanity_check_paths = {
#     'files': ['lib/libgdal.a', f'lib/libgdal.{SHLIB_EXT}'],
#     'dirs': ['bin', 'include', 'lib/python%(pyshortver)s/site-packages'],
# }

# sanity_check_commands = ["python -c 'import osgeo.%(namelower)s'"]

moduleclass = 'geo'

