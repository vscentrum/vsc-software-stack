easyblock = 'CMakeMake'

name = 'EnergyPlus'
version = '23.2.0'
local_dashversion = '23-2-0'

homepage = 'https://energyplus.net/'

description = """EnergyPlus is a whole building energy simulation program that engineers, architects, and researchers use to model both energy consumption—for heating, cooling, ventilation, lighting and plug and process loads—and water use in buildings."""

toolchain = {'name': 'foss', 'version': '2022a'}
toolchainopts = {'usempi': False, 'openmp': True}

source_urls = ['https://github.com/NREL/%(name)s/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']
checksums = ['f4df81d8b233ee511276d471c5754b5e9de3080128b8162cf47d72349d549315']

builddependencies = [
    ('CMake', '3.24.3'),
    ('git', '2.36.0', '-nodocs'),
]

dependencies = [
    ('Python', '3.10.4'),
    ('X11', '20220504'),
    ('lxml', '4.9.1'),
]

configopts = '-DBUILD_FORTRAN=yes -DLINK_WITH_PYTHON=yes '

install_target_subdir = 'bin'

exts_defaultclass = 'PythonPackage'
exts_default_options = {
    'download_dep_fail': True,
    'sanity_pip_check':  False,
    'source_urls':       [PYPI_SOURCE],
    'use_pip':           True,
}

exts_list = [
    ('beautifulsoup4', '4.8.0', {'modulename': 'bs4', 'unpack_sources': False, 'source_tmpl': 'beautifulsoup4-%(version)s-py3-none-any.whl'}),
    ('soupsieve', '2.5', {'unpack_sources': False, 'source_tmpl': 'soupsieve-%(version)s-py3-none-any.whl'}),
    ('munch', '4.0.0'),
    ('pydot3k', '1.0.17', {'modulename': 'pydot'}),
    ('tinynumpy', '1.2.1'),
    ('eppy', '0.5.63'),
]

exts_filter = ("python -c 'import %(ext_name)s'", "")

postinstallcmds = [
    'cp %%(builddir)s/easybuild_obj/Products/V%s-Energy+.idd %%(installdir)s/bin' % (local_dashversion),
    'ln -s %%(installdir)s/bin/V%s-Energy+.idd %%(installdir)s/bin/Energy+.idd' % (local_dashversion),
    'ln -s ${EBROOTPYTHON}/lib/python%(pyshortver)s %(installdir)s/bin/python_standard_lib',
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': [
        'bin',
        'bin/python_standard_lib',
    ],
}

modextrapaths = {
    'PYTHONPATH': 'lib/python%(pyshortver)s/site-packages',
}

moduleclass = 'phys'
