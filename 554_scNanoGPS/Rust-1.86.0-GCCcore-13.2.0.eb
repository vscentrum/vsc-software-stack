    ('binutils', '2.40'),
    ('CMake', '3.27.6'),
    ('Python', '3.11.5'),
    ('Ninja', '1.11.1'),
    ('pkgconf', '2.0.3'),
    ('patchelf', '0.18.0'),  # only required when RPATH linking is enabled
]

dependencies = [
    ('OpenSSL', '3', '', SYSTEM),
]

moduleclass = 'lang'

