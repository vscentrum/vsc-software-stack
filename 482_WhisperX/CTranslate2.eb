easyblock = 'CMakeMake'

name = 'CTranslate2'
version = '4.5.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://opennmt.net/CTranslate2/'
description = "Fast inference engine for Transformer models."

toolchain = {'name': 'foss', 'version': '2023a'}
# toolchainopts = {'openmp': True}
# toolchainopts = {'pic': True, 'optarch': False}

# source_urls = ['https://github.com/OpenNMT/CTranslate2/archive/']
# sources = [{
#     "download_filename": "v%(version)s.tar.gz",
#     "filename": SOURCE_TAR_GZ,
# }]
# checksums = ['f3040c7c3da5dde022fdc16906c279f3f936c6e79f3df8f998c908bb01a77cfe']

sources = [{
    'filename': '%(namelower)s_v%(version)s_recursive.tar.gz',
    'git_config': {
        'url': 'https://github.com/OpenNMT',
        'repo_name': 'CTranslate2',
        'tag': 'v%(version)s',
        'recursive': True,
        'keep_git_dir': True,
    }
}]
checksums = [None]

builddependencies = [
    # ('flex', '2.6.4'),
    # ('Bison', '3.8.2'),
    ('CMake', '3.26.3'),
    # ('pkgconf', '1.9.5'),
]

dependencies = [
    ('CUDA', '12.1.1', '', SYSTEM),
    ('Python', '3.11.3'),
    ('spdlog', '1.11.0'),
    # cpu_features UPDATE
    ('CUTLASS', '3.4.0', versionsuffix),
    ('cxxopts', '3.0.0', '', SYSTEM),
    ('googletest', '1.13.0'),
    # ruy CREATE
    # thrust - not in EB but maybe in AMGX/2.4.0 ?
]

# configopts = '-DOPENMP_RUNTIME=COMP -DWITH_CUDA=ON -DWITH_MKL=OFF -DWITH_CUDNN=ON -DCUDA_DYNAMIC_LOADING=ON -DENABLE_CPU_DISPATCH=OFF'
configopts = '-DOPENMP_RUNTIME=COMP -DWITH_CUDA=ON -DWITH_MKL=OFF -DENABLE_CPU_DISPATCH=OFF'

