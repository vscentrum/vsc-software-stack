    #         {'torchaudio-2.1.2_transform_test_tol.patch':
    #          '6036deb2d7ac405f1267f5bd3da5d6221e39aa170b1a5bcf868f6e56d3705d08'},
    #     ],
    # }),
    ('faster-whisper', '1.0.0', {
        'checksums': ['38db6fcfbd4ce1bf5027fbb4310ef8ed4d2f0b37674b1f2d833e172c352c89d7'],
    }),
    ('pyannote.audio', '3.1.1', {
        'sources': ['pyannote.audio-%(version)s.tar.gz'],
        'checksums': ['b6562d46b5d5d616c1887cafd5aab3f7d19ecf6b3312fc6c4f72f37332fcd408'],
    }),
    (name, version, {
        'preinstallopts': "sed -i 's/==/>=/g' requirements.txt && sed -i 's/==/>=/g' setup.py &&",
        'source_urls': ['https://github.com/m-bain/whisperX/archive/'],
        'sources': ['v%(version)s.tar.gz'],
        'checksums': ['67246b330eaede1539df96627b61d21c510ffd912841d3adf878ca78d46f2235'],
    }),
]

sanity_check_paths = {
    'files': ['bin/whisperx'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

# sanity_check_commands = ["whisperx --help"]

sanity_pip_check = True

moduleclass = 'ai'

