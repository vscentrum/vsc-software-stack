easyblock = 'PythonBundle'

name = 'WhisperX'
version = '3.2.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/m-bain/whisperx'
description = "Automatic Speech Recognition with Word-level Timestamps (& Diarization)."

toolchain = {'name': 'foss', 'version': '2023a'}

# DEPS:
    # OK torch>=2
    # OK torchaudio>=2
    # OK? faster-whisper==1.0.0
    # OK CREATED ctranslate2==4.4.0
    # OK transformers
    # OK pandas
    # OK setuptools>=65
    # OK nltk

dependencies = [
    ('CUDA', '12.1.1', '', SYSTEM),
    ('Python', '3.11.3'),
    ('SciPy-bundle', '2023.07'),
    ('PyTorch-bundle', '2.1.2', versionsuffix),
    ('NLTK', '3.8.1'),
    ('Transformers', '4.39.3'),
    ('CTranslate2', '4.5.0', versionsuffix),
    ('FFmpeg', '6.0'),
]

use_pip = True

exts_list = [
    ('faster-whisper', '1.1.0', {
        'checksums': ['cea4bba5d4527173fdbacafa56f2ffb17dd322688f6c3fdf5fd7b6b6c193ce17'],
    }),
    ('pyannote.audio', '3.3.2', {
        'sources': ['pyannote_audio-%(version)s.tar.gz'],
        'checksums': ['b2115e86b0db5faedb9f36ee1a150cebd07f7758e65e815accdac1a12ca9c777'],
    }),
    (name, version, {
        'source_urls': ['https://github.com/m-bain/whisperX/archive/'],
        'sources': ['v%(version)s.tar.gz'],
        'checksums': ['67246b330eaede1539df96627b61d21c510ffd912841d3adf878ca78d46f2235'],
    }),
]

sanity_check_paths = {
    'files': ['bin/whisperx'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["whisperx --help"]

sanity_pip_check = True

moduleclass = 'ai'
