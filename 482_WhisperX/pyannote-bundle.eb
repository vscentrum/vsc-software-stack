easyblock = 'PythonBundle'

name = 'pyannote-bundle'
version = '2025.02'
local_pytorch_version = '2.1.2'
local_cuda_version = '-CUDA-%(cudaver)s'
versionsuffix = '-PyTorch-' + local_pytorch_version + local_cuda_version


homepage = 'https://github.com/pyannote'
description = "pyannote is an open-source toolkit for speaker diarization."

toolchain = {'name': 'foss', 'version': '2023a'}

# DEPS:
# ok asteroid-filterbanks >=0.4
# OK einops >=0.6.0
# ok huggingface_hub >= 0.13.0
# OK lightning >= 2.0.1
# ok omegaconf >=2.1,<3.0
# ok pyannote.core >= 5.0.0
# ok pyannote.database >= 5.0.1
# ok pyannote.metrics >= 3.2
# ok pyannote.pipeline >= 3.0.1
# ok pytorch_metric_learning >= 2.1.0
# OK pypi rich >= 12.0.0
# ok semver >= 3.0.0
# ok soundfile >= 0.12.1
# ok speechbrain >= 1.0.0
# OK tensorboardX >= 2.6
# OK torch >= 2.0.0
# ok torch_audiomentations >= 0.11.0
# OK torchaudio >= 2.2.0
# ok torchmetrics >= 0.11.0

# ok omegaconf 2.3.0 requires antlr4-python3-runtime, which is not installed.
# ok speechbrain 1.0.2 requires hyperpyyaml, which is not installed.
# ok pytorch-metric-learning 2.8.1 requires scikit-learn, which is not installed.
# ok torch-audiomentations 0.11.1 requires julius, which is not installed.
# OK CREATED torch-audiomentations 0.11.1 requires librosa, which is not installed.
# ok torch-audiomentations 0.11.1 requires torch-pitch-shift, which is not installed.
# ok pyannote-pipeline 3.0.1 requires optuna, which is not installed.
# ok pyannote-pipeline 3.0.1 requires scikit-learn, which is not installed.
# ok pyannote-database 5.0.1 requires typer, which is not installed.
# ok pyannote-metrics 3.2.1 requires matplotlib, which is not installed.
# ok pyannote-metrics 3.2.1 requires scikit-learn, which is not installed.
# ! pyannote-audio 3.3.2 has requirement torchaudio>=2.2.0, but you have torchaudio 0.16.2.
# OK hyperpyyaml 1.2.2 requires ruamel-yaml, which is not installed.
# ok torch-pitch-shift 1.2.5 requires primepy, which is not installed.
# ok omegaconf 2.3.0 has requirement antlr4-python3-runtime==4.9.*, but you have antlr4-python3-runtime 4.13.2.

builddependencies = [('PDM', '2.12.4')]
dependencies = [
    ('CUDA', '12.1.1', '', SYSTEM),
    ('Python', '3.11.3'),
    ('PyTorch-bundle', '2.1.2', local_cuda_version),
    ('Lightning', '2.2.1', local_cuda_version),
    ('tensorboardX', '2.6.2.2'),
    ('librosa', '0.10.1', local_cuda_version),
    ('scikit-learn', '1.3.1'),
    ('Optuna', '3.5.0'),
    ('einops', '0.7.0'),
    ('matplotlib', '3.7.2'),
    ('ruamel.yaml', '0.17.32'),
    # ('PyTorch-Lightning', '2.2.0.post0', '-CUDA-%(cudaver)s'),
    # ('SciPy-bundle', '2023.07'),
    # ('PyYAML', '6.0'),
    # ('matplotlib', '3.7.2'),
    # ('sympy', '1.12'),
    # ('typer', '0.9.0'),
    # ('torchaudio', '2.2.0', versionsuffix),
    # ('torch-audiomentations', '0.11.1', versionsuffix),
    # ('huggingface-hub', '0.20.3'),
    # ('asteroid-filterbanks', '0.4.0', versionsuffix),
    # ('speechbrain', '0.5.16', versionsuffix),
    # ('pytorch-metric-learning', '2.4.1', versionsuffix),
    # ('semver', '3.0.2'),
    # ('omegaconf', '2.3.0', '-Java-11'),
    # ('lightning', '2.2.0.post0', versionsuffix),
]

