easyblock = 'PythonBundle'

name = 'funannotate'
version = '1.8.17'

homepage = 'https://funannotate.readthedocs.io'
description = """funannotate is a pipeline for genome annotation (built specifically for fungi, but will also work
 with higher eukaryotes)"""

toolchain = {'name': 'foss', 'version': '2023a'}

# see also https://github.com/nextgenusfs/funannotate/blob/master/docs/dependencies.rst
dependencies = [
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05'),
    ('Biopython', '1.83'), # no config yet
    ('GOATOOLS', '1.4.5'), # no config yet
    ('matplotlib', '3.9.2'),
    ('scikit-learn', '1.3.1'), # no config yet
    ('Seaborn', '0.13.2'),
    ('tbl2asn', '20230713'), # open pr #21803
    ('DBD-mysql', '4.050'), # open pr #21813
    ('CodingQuarry', '2.0'), # no config yet
    ('Trinity', '2.15.2'), # no config yet
    ('AUGUSTUS', '3.5.0'), # no config yet
    ('BamTools', '2.5.2'),
    ('BEDTools', '2.31.1'),
    ('BLAST+', '2.14.1'),  # provides makeblastdb, tblastn # no config yet
    ('BLAT', '3.7'), # no config yet
    ('DIAMOND', '2.1.8'), # no config yet
    ('eggnog-mapper', '2.1.12'), # no config yet
    ('ETE', '3.1.3'), # no config yet
    ('Exonerate', '2.4.0'), # no config yet
    ('FASTA', '36.3.8i'), # no config yet
    ('GlimmerHMM', '3.0.4c'), # no config yet
    ('GMAP-GSNAP', '2024-09-18'),  # provides gmap
    ('GeneMark-ET', '4.72'),  # provides gmes_petap.pl # no config yet
    ('HISAT2', '2.2.1'), # no config yet
    ('HMMER', '3.4'),  # provides hmmscan, hmmsearch # no config yet
    ('kallisto', '0.51.1'), # no config yet
    ('MAFFT', '7.520', '-with-extensions'), # no config yet
    ('minimap2', '2.26'), # no config yet
    ('pigz', '2.8'), # no config yet
    ('Proteinortho', '6.3.2'), # no config yet
    ('Kent_tools', '468'),  # provides pslCDnaFilter # no config yet
    ('Salmon', '1.10.3'), # no config yet
    ('SAMtools', '1.21'), 
    ('SignalP', '6.0h', '-fast'), # no config yet
    ('SNAP-HMM', '20221022'), # no config yet
    ('StringTie', '2.2.3'), # no config yet
    ('tRNAscan-SE', '2.0.12'), # no config yet
    ('tantan', '50'), # no config yet
    ('trimAl', '1.4.1'), # no config yet
    ('Trimmomatic', '0.39', '-Java-11', SYSTEM), 
    ('BioPerl', '1.7.8'),
    ('EVidenceModeler', '2.1.0'), # no config yet
]

use_pip = True

exts_list = [
    ('distro', '1.9.0', {
        'checksums': ['2fa77c6fd8940f116ee1d6b94a2f90b13b5ea8d019b98bc8bafdcabcdd9bdbed'],
    }),
    ('natsort', '8.4.0', {
        'checksums': ['45312c4a0e5507593da193dedd04abb1469253b601ecaf63445ad80f0a1ea581'],
    }),
    (name, version, {
        'checksums': ['bdadfd7a5636383c1c40c26dab37c5908a77e8c4064adced84f1ba9e86187a04'],
        'preinstallopts': (
            """sed -i 's|REQUIRES_PYTHON = ">=3.6.0, <3.10"|REQUIRES_PYTHON = ">=3.6.0"|' setup.py && """
            """sed -i 's|"biopython<1.80",|"biopython",|' setup.py && """
        )
    }),
]

sanity_check_paths = {
    'files': ['bin/funannotate'],
    'dirs': [],
}

modextrapaths = {
    'GENEMARK_PATH': '$EBROOTGENEMARKMINET',
}

sanity_check_commands = [
    "funannotate --help 2>&1 | grep 'Usage:[ ]*funannotate'",
    "funannotate check --show-versions",
]


sanity_pip_check = True

moduleclass = 'bio'
