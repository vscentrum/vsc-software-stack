# test4: OK!
    # = pass without the test errors
    # -> --deselect=tests/experimental_rnn_test.py::RnnTest::test_struct_encoding_determinism
    # -> --deselect=tests/cudnn_fusion_test.py::CudnnFusionTest::test_cudnn_fusion0
