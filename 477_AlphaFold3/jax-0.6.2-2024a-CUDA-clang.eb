# tests3:
    # <- log3.txt <- 3 errors
    # -> export CUDA_VISIBLE_DEVICES=0
    # -> export JAX_DEFAULT_MATMUL_PRECISION=highest or export NVIDIA_TF32_OVERRIDE=0
        # InterpretTest::test_matmul_example fails tolerance (tight atol=1e-4)
        # On Ampere/Hopper, cuBLAS uses TF32 by default for FP32 matmul; TF32 trades a bit of accuracy for speed, and it’s exactly the kind of ~4e‑4 absolute error you’re seeing.
    # -> pytest -n 1 -k "not pallas"
        # Those pallas/ops_test.py::dot* configs request 128 KB shared memory
        # on sm_86 GPUs the per‑block shared‑mem limit is ~99 KB (100 KB minus 1 KB reserved), so these kernels cannot run by design
        # There is no flag that raises the 99 KB limit on sm_86; that limit is architectural. Build & run those tests on A100/H100 machines if you want to exercise them.
    # -> export XLA_FLAGS="--xla_gpu_cuda_data_dir=$EBROOTCUDA"
        # MLIR→PTX compilation needs libdevice (bitcode) and XLA can’t find it under hermetic CUDA unless you tell it where your CUDA toolkit lives.
        # XLA looks for nvvm/libdevice/libdevice.10.bc under that tree
