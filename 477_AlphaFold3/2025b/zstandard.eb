# Author: Lara Peeters
# Org: Ghent University
easyblock = 'PythonPackage'

name = 'zstandard'
version = '0.25.0'

homepage = 'https://github.com/indygreg/python-zstandard'
description = '''This project provides Python bindings for interfacing with the Zstandard compression library.
A C extension and CFFI interface are provided.'''

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/indygreg/python-zstandard/archive/refs/tags/']
sources = ['%(version)s.tar.gz']
checksums = ['f29233338bcef11f233737eb58aba85074f0fd3163bec1a20303de1270e6fb16']

builddependencies = [('binutils', '2.44')]
dependencies = [
    ('Python', '3.13.5'),
    ('cffi', '1.17.1'),
    ('zstd', '1.5.7')
]

moduleclass = 'bio'
