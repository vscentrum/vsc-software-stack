easyblock = 'JuliaBundle'

name = 'PEPSKit.jl'
version = '0.3.0'
local_juliaver = '1.10.5'
versionsuffix = '-R-%%(rver)s-Julia-%s' % local_juliaver

homepage = 'https://github.com/QuantumKitHub/PEPSKit.jl'
description = """Tools for working with projected entangled-pair states"""

toolchain = SYSTEM

dependencies = [
    ('Julia', local_juliaver, '-linux-%s' % ARCH, SYSTEM),
]

exts_default_options = {
    'source_tmpl': 'v%(version)s.tar.gz',
}

exts_list = [
    ('VectorInterface.jl', '0.5.0', {
        'source_urls': ['https://github.com/Jutho/VectorInterface.jl/archive/'],
        'checksums': ['4ec978b47e5fff9a5e7d484f89da992d780e62bf6ab24a8656d0279f2f6bb472'],
    }),
    ('TensorOperations.jl', '5.1.3', {
        'source_urls': ['https://github.com/Jutho/TensorOperations.jl/archive/'],
        'checksums': ['1b22dca5ad2d39a887763e1440165a6e52adb4db42262916cf5367a8fc5716e9'],
    }),
    ('TensorKitSectors.jl', '0.1.1', {
        'source_urls': ['https://github.com/QuantumKitHub/TensorKitSectors.jl/archive/'],
        'checksums': ['eb7a18389fde1c03e621dfb7e506fe1168d391c2186a514fd0e608deba1f120d'],
    }),
    ('TensorKit', '0.14.2', {
        'source_urls': ['https://github.com/Jutho/TensorKit.jl/archive/'],
        'checksums': ['d3cde6aeed8f8f95e6d26e1d0ea1dab007b4f7ea8412ea05c5d92a230478ad1c'],
    }),
    (name, version, {
        'source_urls': ['https://github.com/QuantumKitHub/PEPSKit.jl/archive/'],
        'checksums': ['cfec2de82d159f7247066459eb934c7b7dcca31b15ca8daa47fbd4a5c3122a7c'],
    }),
]

# local_julia_env = "%(installdir)s/environments/v" + '.'.join(local_juliaver.split('.')[:2])
#
# sanity_check_commands = [
#     """julia -e 'using Pkg; Pkg.activate("%s"); Pkg.test("%%(name)s")'""" % local_julia_env,
# ]

sanity_check_paths = {
    'files': [],
    'dirs': ['packages/%(name)s'],
}

moduleclass = 'tools'

