# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild

easyblock = 'PythonBundle'

name = 'MACS3'
version = '3.0.1'

homepage = 'https://github.com/taoliu/MACS'
description = "Model Based Analysis for ChIP-Seq data"

toolchain = {'name': 'gfbf', 'version': '2023b'}

builddependencies = [
    ('Cython', '3.0.10'),
]
dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('scikit-learn', '1.3.2'),
]

exts_list = [
    ('hmmlearn', '0.3.3', {
        'checksums': ['1d3c5dc4c5257e0c238dc1fe5387700b8cb987eab808edb3e0c73829f1cc44ec'],
    }),
    ('cykhash', '2.0.1', {
        'checksums': ['b4794bc9f549114d8cf1d856d9f64e08ff5f246bf043cf369fdb414e9ceb97f7'],
    }),
    (name, version, {
        'modulename': name,
        'checksums': ['b07ca6e84a71aab29589f63e3dff96049aa6739e055a629125b31c788c877016'],
    }),
]

# sanity_check_paths = {
#     'files': ['bin/macs2'],
#     'dirs': ['lib/python%(pyshortver)s/site-packages'],
# }

sanity_check_commands = [('%(namelower)s --version')]

moduleclass = 'bio'
