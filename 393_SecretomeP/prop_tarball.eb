easyblock = 'Tarball'

name = 'ProP'
version = '1.0c'
versionsuffix = '-Linux'

homepage = 'https://services.healthtech.dtu.dk/services/ProP-1.0/'
description = """The ProP 1.0 server predicts arginine and lysine propeptide cleavage sites in eukaryotic
protein sequences using an ensemble of neural networks. Furin-specific prediction is the default.
It is also possible to perform a general proprotein convertase (PC) prediction."""

toolchain = {'name': 'foss', 'version': '2023a'}

# no public download url
# downloaded from https://services.healthtech.dtu.dk/services/ProP-1.0/
sources = ['%(namelower)s-%(version)s.Linux.tar.Z']
patches = [
    'patch12-prop.patch',
    'patch2-furin.patch'
]
checksums = [
    {'prop-1.0c.Linux.tar.Z': 'd6686b0bad2cd82ca0ec87fb7503838a70b8cbd6040542c2e50101d3ac12d6ed'},
    {'patch12-prop.patch': '827a9b57bd81468403d2cd1f0805bbfd2cd6c2dadf4877c37846b248545d3f2a'},
    {'patch2-furin.patch': '3c874b67207aa92f988ce2e9d9289c80c2092c1e8d377dc54a72920a86ed8a9f'},
]

# builddependencies = [
#     ('gawk', '5.3.0'),
# ]

# patches = ['patch3-prop.patch']
dependencies = [
    ('Perl', '5.36.1'),
    ('Perl-bundle-CPAN', '5.36.1'),
    ('SignalP', '6.0h', '-fast'),
    ('gawk', '5.3.0'),
    ('tcsh', '6.24.10'),
    ('patchelf', '0.18.0'),
    ('QIIME2', '2020.11', '', SYSTEM),  # for libgfortran.so.3
]

preinstall_cmd = "sed -i 's|#! /usr/bin/nawk -f|#! /usr/bin/env -S gawk -f|' bin/in2how && "
preinstall_cmd += 'chmod +x bin/in2how && '
preinstall_cmd += "sed -i 's|#! /usr/freeware/bin/gawk -f|#! /usr/bin/env -S gawk -f|' bin/fasta2dir && "
preinstall_cmd += 'chmod +x bin/fasta2dir && '
preinstall_cmd += "sed -i 's|#! /usr/bin/nawk -f|#! /usr/bin/env -S gawk -f|' bin/gethow && "
preinstall_cmd += 'chmod +x bin/gethow && '
# preinstall_cmd += 'ln -s prop bin/prop && '
preinstall_cmd += 'export BINDIR=%(installdir)s/bin'

postinstallcmds = [
    "mkdir %(installdir)s/lib",
    "cd %(installdir)s/lib && ln -s $EBROOTGCC/lib/libgfortran.so.5 libgfortran.so.3",
    # "patchelf --force-rpath --set-rpath '$ORIGIN:$ORIGIN/../lib' %(installdir)s/how/how98_Linux_v2",
]

# postinstallcmds = [
# #     'mv %(installdir)s/%(namelower)s %(installdir)s/bin/%(namelower)s',
# #     # 'mkdir -m 777 $HOME/ProP/tmp',
#     'ln -s prop bin/prop',
# ]

# preinstall_cmd =
# prebuildopts = 'rm %(start_dir)s/tools_opera_ms/samtools && '
# prebuildopts += 'cd %(start_dir)s/tools_opera_ms && ln -s $EBROOTSAMTOOLS/bin/samtools && '
# prebuildopts += 'cd %(start_dir)s &&'
# buildopts = 'CFLAGS="$CFLAGS" BINDIR=%(installdir)s/bin MANDIR=%(installdir)s/man/cat1'

# parallel = 1
# start_dir = 'src'
# build_cmd_targets = 'all install'  # install copies binaries to ../bin

# files_to_copy = ['bin', 'data', 'LICENSE']
# files_to_copy = ['*']

modextrapaths = {
    'PATH': '',
    'LD_LIBRARY_PATH': 'lib',
}

sanity_check_paths = {
    'files': [
        '%(namelower)s',
        # 'bin/%(namelower)s'
    ],
    'dirs': ['bin'],
}

# sanity_check_paths = {
#     'files': ['bin/%(namelower)s'],
#     'dirs': [],
# }

# my_test_cmd = 'prop test/four.fsa'

moduleclass = 'bio'

