easyblock = 'MakeCp'

name = 'SecretomP'
version = '1.0h'

homepage = 'https://services.healthtech.dtu.dk/services/SecretomeP-2.0/'
description = """The SecretomeP 2.0 server produces ab initio predictions of non-classical i.e. not signal peptide
triggered protein secretion. The method queries a large number of other feature prediction servers to obtain
information on various post-translational and localizational aspects of the protein, which are integrated into
the final secretion prediction."""

toolchain = {'name': 'foss', 'version': '2023a'}

sources = [SOURCE_TAR_GZ]

# DEPS:
    # OK perl 
    # OK gawk
    # ProP 1.0 https://services.healthtech.dtu.dk/services/ProP-1.0/
    # PSORT II -> Lara should have zip from user
    # OK CREATED seg -> https://directory.fsf.org/wiki/Seg ?
    # OK CREATED - TMHMM 2.0 -> https://services.healthtech.dtu.dk/services/TMHMM-2.0/
    # OK? SignalP 3.0

builddependencies = [
    ('gawk', '5.3.0'),
]
dependencies = [
    ('Perl', '5.36.1'),
    ('Perl-bundle-CPAN', '5.36.1'),
    ('SignalP', '6.0h', '-fast'),
    ('TMHMM', '2.0c'),
    ('Seg', '0.0.20000620'),
    #Prop
    #PSORT II
]

# prebuildopts = 'rm %(start_dir)s/tools_opera_ms/samtools && '
# prebuildopts += 'cd %(start_dir)s/tools_opera_ms && ln -s $EBROOTSAMTOOLS/bin/samtools && '
# prebuildopts += 'cd %(start_dir)s &&'
# buildopts = 'CFLAGS="$CFLAGS"'

# parallel = 1
# start_dir = 'src'
# build_cmd_targets = 'all install'  # install copies binaries to ../bin

files_to_copy = ['bin', 'data', 'LICENSE']

sanity_check_paths = {
    'files': ['bin/chkparse', 'bin/psipass2', 'bin/psipred', 'bin/seq2mtx'],
    'dirs': ['bin', 'data'],
}

moduleclass = 'bio'
