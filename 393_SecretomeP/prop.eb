easyblock = 'MakeCp'

name = 'ProP'
version = '1.0c'
versionsuffix = '-Linux'

homepage = 'https://services.healthtech.dtu.dk/services/ProP-1.0/'
description = """The ProP 1.0 server predicts arginine and lysine propeptide cleavage sites in eukaryotic
protein sequences using an ensemble of neural networks. Furin-specific prediction is the default.
It is also possible to perform a general proprotein convertase (PC) prediction."""

toolchain = {'name': 'foss', 'version': '2023a'}

# no public download url
# downloaded from https://services.healthtech.dtu.dk/services/ProP-1.0/
sources = ['%(namelower)s-%(version)s.Linux.tar.Z']
checksums = ['d6686b0bad2cd82ca0ec87fb7503838a70b8cbd6040542c2e50101d3ac12d6ed']

builddependencies = [
    ('gawk', '5.3.0'),
]
dependencies = [
    ('Perl', '5.36.1'),
    ('Perl-bundle-CPAN', '5.36.1'),
    ('SignalP', '6.0h', '-fast'),
]

# prebuildopts = 'rm %(start_dir)s/tools_opera_ms/samtools && '
# prebuildopts += 'cd %(start_dir)s/tools_opera_ms && ln -s $EBROOTSAMTOOLS/bin/samtools && '
# prebuildopts += 'cd %(start_dir)s &&'
buildopts = 'CFLAGS="$CFLAGS" BINDIR=%(installdir)s/bin MANDIR=%(installdir)s/man/cat1'

# parallel = 1
# start_dir = 'src'
# build_cmd_targets = 'all install'  # install copies binaries to ../bin

# files_to_copy = ['bin', 'data', 'LICENSE']
files_to_copy = ['*']

modextrapaths = {'PATH': ''}

# sanity_check_paths = {
#     'files': ['bin/chkparse', 'bin/psipass2', 'bin/psipred', 'bin/seq2mtx'],
#     'dirs': ['bin', 'data'],
# }

moduleclass = 'bio'

# E1:
    # -> edit makefile BINDIR and MANDIR
    # <- during make -j 8
    # cp prop /usr/opt/bin
    # cp: cannot create regular file '/usr/opt/bin': No such file or directory