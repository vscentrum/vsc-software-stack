easyblock = 'Bundle'

name = 'R-bundle-CRAN'
version = '2025.11'
versionsuffix = '-dRiftDM'

homepage = 'https://www.r-project.org/'
description = "Bundle of R packages from CRAN"

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('pkgconf', '2.4.3'),
    ('Xvfb', '21.1.18'),
    ('Autotools', '20250527'),
    ('CMake', '4.0.3'),
]

dependencies = [
    ('R-bundle-CRAN', '2025.11'),
    # ('R', '4.5.2'),
    # ('libxml2', '2.14.3'),  # for XML
    # ('GMP', '6.3.0'),  # for igraph
    # ('NLopt', '2.10.0'),  # for nlopt
    # ('FFTW', '3.3.10'),  # for fftw
    # ('libsndfile', '1.2.2'),  # for seewave
    # ('ICU', '77.1'),  # for rJava & gdsfmt
    # ('HDF5', '1.14.6'),  # for hdf5r
    # ('UDUNITS', '2.2.28'),  # for units
    # ('GSL', '2.8'),  # for RcppGSL
    # ('ImageMagick', '7.1.2-7'),
    # ('GLPK', '5.0'),  # for Rglpk
    # ('nodejs', '22.17.1'),  # for V8 (required by rstan)
    # ('GDAL', '3.11.3'),  # for sf
    # ('MPFR', '4.2.2'),  # for Rmpfr
    # ('PostgreSQL', '17.5'),  # for RPostgreSQL
]

# Some R extensions (mclust, quantreg, waveslim for example) require the math library (-lm) to avoid undefined symbols.
# Adding it to FLIBS makes sure it is present when needed.
preconfigopts = 'export FLIBS="$FLIBS -lm" && '

configopts = "--with-pic --enable-threads --enable-R-shlib"
# some recommended packages may fail in a parallel build (e.g. Matrix), and
# we're installing them anyway below
configopts += " --with-recommended-packages=no"

exts_defaultclass = 'RPackage'

exts_default_options = {
    'source_urls': [
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',  # package archive
        'https://cran.r-project.org/src/contrib/',  # current version of packages
        'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
    ],
    'source_tmpl': '%(name)s_%(version)s.tar.gz',
}

# !! order of packages is important !!
# packages updated on 5 November 2025
exts_list = [
    ('dfoptim', '2023.1.0', {
        'checksums': ['c436a6d866c94fc71e71a1f6a39bee9245aea1a062dc8dba3b2b229b88d05c30'],
    }),
    ('nanonext', '1.7.2', {
        'checksums': ['6ecb1eb986971968e9c920912223b403554055e9a36ecf0343b9bc84fc5331d1'],
    }),
    ('mirai', '2.5.3', {
        'checksums': ['17a5b48b3bb21498a09f289099d03646a57136555a3ceb0105e45400722a8eda'],
    }),
    ('dRiftDM', '0.3.1', {
        'checksums': ['7b3b45b56a3563d737d286df99c2bea75e79d1e4a56d39a0933f3bad6f4a6b0c'],
    }),
]

modextrapaths = {'R_LIBS_SITE': ''}

sanity_check_paths = {
    'files': [],
    'dirs': ['dRiftDM'],
}

moduleclass = 'lang'
