easyblock = 'Cargo'

name = 'subset-bam'
version = '1.1.0'

homepage = 'https://github.com/10XGenomics/subset-bam'
description = """subset-bam is a tool to subset a 10x Genomics BAM file based on a tag, 
most commonly the cell barcode tag."""

