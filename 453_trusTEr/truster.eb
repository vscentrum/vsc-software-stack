dependencies = [
    ('Python', '3.11.3'),
    # ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    ('CellRanger', '8.0.1', '', SYSTEM),
    ('R', '4.3.2'),
    ('R-bundle-CRAN', '2023.12'),
    ('Seurat', '5.1.0', '-R-%(rver)s'),
    ('STAR', '2.7.11a'),
    ('velocyto', '0.17.17'),
    ('TEtranscripts' '2.2.3'),
]

use_pip = True

exts_list = [
    ('truster', version, {
        'checksums': ['36081b7aac1988566b0d42278f77671faabe17725006e56865b0ec5f7374e185'],
    }),
]

    # (name, version, {
