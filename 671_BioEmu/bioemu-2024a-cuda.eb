    ('matplotlib', '3.9.2'),
    ('Biopython', '1.84'),
    ('dm-tree', '0.1.9'),
    ('dm-haiku', '0.0.14', versionsuffix),
    ('MDTraj', '1.10.3'),
    ('mygene', '3.2.2'),
    ('tqdm', '4.66.5'),
    ('HF-Datasets', '4.0.0'),
    ('Hydra', '1.3.2'),
    ('einops', '0.8.1'),
    ('ml-collections', '1.1.0'),
    ('absl-py', '2.1.0'),
]

