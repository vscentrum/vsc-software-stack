postinstallcmds = [
    # copy notebooks to installation directory
    "cp -r notebooks %(installdir)s/",
]

sanity_check_paths = {
    'files': ['bin/bio', 'bin/typer'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/', 'notebooks'],
}

sanity_check_commands = [
    "python -m bioemu.sample --help",
]

modloadmsg = """
%(name)s notebooks are located in $EBROOTBIOEMU/notebooks
"""

moduleclass = 'bio'
