        'checksums': ['3b208f05c736de98fb343310d090dcc4d8c78b2a89ea4f32b837c586270a9cbf'],
    }),
    ('ihm', '2.8', {
        'checksums': ['528a6efe9c6576ace3b33cfde531f177a17e791ff365039582620b6ad9fbe441'],
    }),
    ('modelcif', '1.6', {
        'checksums': ['b1bf0751f0e2d1ea6da7a0a8a92efd2754428ae50bc3bfbff8e015183e978b19'],
