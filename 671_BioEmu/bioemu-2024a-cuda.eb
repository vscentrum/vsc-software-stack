    ('CUDA', '12.6.0', '', SYSTEM),
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05'),
    ('PyTorch-Geometric', '2.6.1', versionsuffix),
    ('PyTorch-bundle', '2.7.1', versionsuffix),
