def run_test(name, code, env, timeout):
    if code is None:
        command = [sys.executable, "-X", "faulthandler", "-m", "bioemu.sample", "--help"]
    else:
        command = [sys.executable, "-X", "faulthandler", "-c", textwrap.dedent(code)]
    try:
        result = subprocess.run(command, env=env, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, f"Timed out after {timeout} seconds"
    output = (result.stdout + result.stderr).strip()
    if result.returncode == 0:
        details = result.stdout.strip().splitlines()
        return True, " | ".join(details[-2:]) if details else "OK"
    if result.returncode < 0:
        try:
            reason = signal.Signals(-result.returncode).name
        except ValueError:
            reason = f"signal {-result.returncode}"
        reason = f"Process terminated by {reason}"
    else:
        reason = f"Exit code {result.returncode}"
    lines = output.splitlines()
    if len(lines) > 45:
        lines = lines[:18] + [f"... ({len(lines) - 36} lines omitted) ..."] + lines[-18:]
    return False, reason + "\n" + "\n".join(line[:400] for line in lines)


def main():
    parser = argparse.ArgumentParser(description="Offline BioEmu 1.4.0 installation smoke test")
    parser.add_argument("--cuda", action="store_true", help="Require PyTorch and JAX GPU execution")
    parser.add_argument("--timeout", type=int, default=120, help="Per-check timeout in seconds")
    args = parser.parse_args()
    print(f"BioEmu smoke test: Python {sys.version.split()[0]} ({sys.executable})", flush=True)
    with tempfile.TemporaryDirectory(prefix="bioemu-smoke-") as tmp:
        home = Path(tmp) / "home"
        home.mkdir()
        env = os.environ.copy()
        env.update({
            "HOME": str(home),
            "XDG_CACHE_HOME": str(home / ".cache"),
            "HF_HUB_OFFLINE": "1",
            "HF_DATASETS_OFFLINE": "1",
            "JAX_PLATFORMS": "cuda" if args.cuda else "cpu",
            "BIOEMU_SMOKE_DEVICE": "cuda" if args.cuda else "cpu",
            "TF_CPP_MIN_LOG_LEVEL": "2",
        })
        results = []
        for name, code in [("BioEmu CLI --help", None), *TESTS]:
            success, details = run_test(name, code, env, args.timeout)
            results.append((name, success))
            print(f"[{'PASS' if success else 'FAIL'}] {name}", flush=True)
            if success:
                if details:
                    print(f"       {details}", flush=True)
            else:
                for line in details.splitlines():
                    print(f"       {line}", flush=True)
    passed = sum(success for _, success in results)
    print(f"\nResult: {passed}/{len(results)} checks passed")
    if passed < len(results):
        print("Note: failures are independent; a failed TensorFlow/AlphaFold import may prevent full sampling.")
    else:
        print("Core installation checks passed (pretrained-model sampling was not tested).")
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
