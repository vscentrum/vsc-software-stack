    # OK dill>0.3.1

builddependencies = [
    ('hatchling', '1.27.0'),
    ('scikit-learn', '1.7.1'),  # tests
]
dependencies = [
    ('CUDA', '12.9.1', '', SYSTEM),
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('PyTorch', '2.9.1', versionsuffix),
    ('pyro-ppl', '1.9.1', versionsuffix),
    ('matplotlib', '3.10.5'),
    ('IPython', '9.4.0'),
    ('anndata', '0.12.16'),
    ('jupyter-server', '2.17.0'),
    # ('loompy', '3.0.8'),
    ('PyTables', '3.10.2'),
    # ('Qtconsole', '5.6.0'),
    ('dill', '0.4.0'),
    ('lxml', '6.0.0'),
]

