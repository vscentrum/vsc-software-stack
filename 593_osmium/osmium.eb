easyblock = 'CMakeMake'

name = 'osmium-tool'
version = '1.18.0'

homepage = 'https://osmcode.org/osmium-tool/index.html'
description = "Command line tool for working with OpenStreetMap data based on the Osmium library."

toolchain = {'name': 'foss', 'version': '2025b'} # 14.3.0

source_urls = ['https://github.com/osmcode/osmium-tool/archive/']
sources = [{
    'download_filename': 'v%(version)s.tar.gz',
    'filename': SOURCE_TAR_GZ,
}]
checksums = ['5438f57043c9df05137ca4bd1b1e4a5fb1c9c8c49cb4bec43a5f1ef30ed68fb5']

# DEPS:
    # OK You need a C++14 compliant compiler.
    # OK Libosmium (>= 2.16.0) aka libosmium2 -> 25a: NO, 25b: NO -> CREATE
    # OK Protozero (>= 1.6.3) aka libprotozero -> 25a: NO, 25b: NO -> CREATE
    # OK boost-program-options (>= 1.55) aka Boost -> 25a: Yes, 25b: Yes
    # OK bz2lib -> 25a: Yes, 25b: Yes
    # OK zlib -> 25a: Yes, 25b: Yes
    # OK Expat -> 25a: Yes, 25b: Yes
    # OK cmake
    # OK LZ4 (optional) -> 25a: Yes, 25b: Yes
    # OK Pandoc (optional, for docs) -> yes (SYSTEM)

builddependencies = [
    ('CMake', '4.0.3'),
    ('Pandoc', '3.6.2', '', SYSTEM),
]

dependencies = [
    ('libosmium', '2.15.4'),
    ('protozero', '1.8.1'),
    ('Boost', '1.88.0'),
    ('bzip2', '1.0.8'),
    ('zlib', '1.3.1'),
    ('expat', '2.7.1'),
    ('lz4', '1.10.0'),
]

# TEST
# Call ctest in the build directory to run the tests after build.
runtest = True

# preconfigopts = "rm -rf %(installdir)s && "

# installopts = "install-prebuilds"

# sanity_check_paths = {
#     'files': ['bin/mustrun', 'bin/wrap.py', 'include/mustConfig.h', 'lib/libpnmpif.so', f'lib/libpnmpi.{SHLIB_EXT}'],
#     'dirs': ['include/pnmpi', 'lib64/pnmpi-modules', 'modules', 'share', 'specifications', 'src'],
# }

moduleclass = 'tools'
