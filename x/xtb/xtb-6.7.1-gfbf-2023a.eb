easyblock = 'MesonNinja'

name = 'xtb'
version = '6.7.1'

homepage = 'https://xtb-docs.readthedocs.io'
description = """ xtb - An extended tight-binding semi-empirical program package. """

toolchain = {'name': 'gfbf', 'version': '2023a'}

github_account = 'grimme-lab'
source_urls = [GITHUB_LOWER_SOURCE]
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
checksums = ['52506a689147cdb4695bf1c666158b6d6d6b31726fecaa5bf53af7f4e3f3d20d']

builddependencies = [
    ('Meson', '1.1.1'),
    ('Ninja', '1.11.1'),
    ('pkgconf', '1.9.5'),
]

# Dependencies based on xtb release
preconfigopts = "sed -i 's/head/2eebe24/' %(builddir)s/%(namelower)s-%(version)s/subprojects/cpx.wrap && "
preconfigopts += "sed -i 's/head/77f65c6/' %(builddir)s/%(namelower)s-%(version)s/subprojects/mctc-lib.wrap && "
preconfigopts += "sed -i 's/head/8baa4fc/' %(builddir)s/%(namelower)s-%(version)s/subprojects/numsa.wrap && "
preconfigopts += "sed -i 's/head/d2f08e8/' %(builddir)s/%(namelower)s-%(version)s/subprojects/tblite.wrap && "

configopts = "-Dlapack='custom' "
configopts += "-Dcustom_libraries='flexiblas' "
configopts += "--buildtype release "

runtest = 'meson'
pretestopts = 'export OMP_NUM_THREADS=2 && '
testopts = 'test -C %(builddir)s/easybuild_obj -t 60'  # Ensure test don't timeout

sanity_check_paths = {
    'files': ['bin/xtb', 'include/xtb.h'] + ['lib/libxtb.%s' % e for e in ('a', SHLIB_EXT)],
    'dirs': ['share'],
}

sanity_check_commands = ["xtb --help"]

modextravars = {
    'XTBHOME': '%(installdir)s',
    'XTBPATH': '%(installdir)s',
    'XTBEXE': '%(installdir)s/bin/xtb',
}

moduleclass = 'chem'
