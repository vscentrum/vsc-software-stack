 set(EP_PROJECT nevpt2_ext)
 
 # Enabling source changes to keep ExternalProject happy
@@ -125,6 +117,20 @@
                     INSTALL_DIR "${PROJECT_BINARY_DIR}/qcmaquis"
                    )
 
+# -------------- PATCH STEP FOR gctime.c -------------------
+ExternalProject_Add_Step(${EP_PROJECT} patch_gctime
+  COMMAND ${CMAKE_COMMAND} -E echo "Patching gctime.c in NEVPT2..."
+  COMMAND sed -i '1i#include <string.h>' ${CUSTOM_NEVPT2_LOCATION}/src/nevpt2_ext/src/gctime.c
+  COMMAND sed -i '2i#include <time.h>' ${CUSTOM_NEVPT2_LOCATION}/src/nevpt2_ext/src/gctime.c
+  COMMAND sed -i 's/^gctime *(fstr, *lstr) *f77_char \*fstr; *int lstr; *{/int gctime(f77_char fstr, int lstr) {/' ${CUSTOM_NEVPT2_LOCATION}/src/nevpt2_ext/src/gctime.c
+  COMMAND sed -i 's/^gctime_ *(fstr, *lstr) *f77_char \*fstr; *int lstr; *{/int gctime_(f77_char fstr, int lstr) {/' ${CUSTOM_NEVPT2_LOCATION}/src/nevpt2_ext/src/gctime.c
+  COMMAND sed -i '/long time(), t;/d' ${CUSTOM_NEVPT2_LOCATION}/src/nevpt2_ext/src/gctime.c
+  COMMAND sed -i '/char \*ctime();/d' ${CUSTOM_NEVPT2_LOCATION}/src/nevpt2_ext/src/gctime.c
+  DEPENDEES update
+  ALWAYS 1
+)
+# ----------------------------------------------------------
+
 ExternalProject_Add_Step (${EP_PROJECT} update_hash
                           COMMAND echo ${reference_git_commit} > ${hash_file}
                           DEPENDEES build
