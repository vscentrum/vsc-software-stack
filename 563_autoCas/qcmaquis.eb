easyblock = 'CMakeMake'

name = 'QCMaquis'
version = '3.1.4'

homepage = "https://gitlab.com/Molcas/OpenMolcas"
description = "OpenMolcas is a quantum chemistry software package."

toolchain = {'name': 'iimpi', 'version': '2023a'}
# https://github.com/qcscine/qcmaquis/archive/refs/tags/release-3.1.4.tar.gz
source_urls = ['https://github.com/qcscine/qcmaquis/archive']
sources = ["release-%(version)s.tar.gz"]
checksums = ['98eaa0a057a8f056ebeab8427c8b59efaf2d71667a2d71491b900adbe0d29341']

# patches = ['%(name)s-23.06_mcpdft_deps.patch']

builddependencies = [('CMake', '3.26.3')]

dependencies = [
    # ('Python', '3.11.3'),
    # ('Python-bundle-PyPI', '2023.06'),
    # ('lxml', '4.9.2'),
    ('HDF5', '1.14.0'),
    # ('GlobalArrays', '5.8.2'),
    # ('libxc', '6.2.2'),
    ('GSL', '2.7'),
    ('Boost', '1.82.0'),
]

start_dir = 'dmrg'
