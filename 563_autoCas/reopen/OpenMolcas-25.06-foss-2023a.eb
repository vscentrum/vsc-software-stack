easyblock = 'CMakeMake'

name = 'OpenMolcas'
version = '25.06'

homepage = "https://gitlab.com/Molcas/OpenMolcas"
description = "OpenMolcas is a quantum chemistry software package"

toolchain = {'name': 'foss', 'version': '2023a'}
toolchainopts = {'openmp': True}

source_urls = ['https://gitlab.com/Molcas/OpenMolcas/-/archive/v%(version)s/']
sources = ["OpenMolcas-v%(version)s.tar.gz"]
checksums = ['df5262abd030d4fdfc66900140e608e53c71cf1d35acfdedcfaac147c02af94c']

builddependencies = [('CMake', '3.31.8')]
dependencies = [
    ('Python', '3.11.3'),
    ('GlobalArrays', '5.8.2'),
    ('HDF5', '1.14.0'),
    ('libxc', '6.2.2'),
    ('GSL', '2.7'),
    ('Boost', '1.82.0'),
    ('pyparsing', '3.1.1'),
]

build_shared_libs = True

# separate_build_dir = True

# preconfigopts = 'GAROOT=$EBROOTGLOBALARRAYS'

configopts = '-DLINALG=Manual -DLINALG_LIBRARIES="flexiblas;scalapack" '
configopts += '-DEXTERNAL_LIBXC=$EBROOTLIBXC '
configopts += '-DMPI=OFF -DOPENMP=ON -DGA=OFF '
configopts += '-DBUILD_SHARED_LIBS=ON -DTOOLS=ON '
configopts += '-DPython_ROOT=$EBROOTPYTHON -DDMRG=ON -DNEVPT2=ON'

pretestopts = 'MOLCAS=%(builddir)s/easybuild_obj '
pretestopts += 'MOLCAS_DRIVER=%(builddir)s/easybuild_obj/pymolcas '
pretestopts += 'MOLCAS_SOURCE=%(builddir)s/easybuild_obj '
pretestopts += 'MOLCAS_WORKDIR=%(builddir)s/easybuild_obj '
pretestopts += 'PATH=%(builddir)s/easybuild_obj:$PATH '

test_cmd = 'pymolcas verify .default'

postinstallcmds = ['ln -s %(installdir)s/pymolcas %(installdir)s/sbin']

fix_python_shebang_for = ['pymolcas', 'Tools/AugerOca/*.py', 'Tools/AugerOca/auger_oca/*.py', 'Tools/mort/mort.py',
    'Tools/dynamixtools/dynamixtools.py']

modextravars = {
    'MOLCAS': '%(installdir)s',
    'MOLCAS_DRIVER': '%(installdir)s/sbin/pymolcas',
    'MOLCAS_SOURCE': '%(installdir)s',
}

sanity_check_paths = {
    'files': ['bin/dynamix.exe', 'bin/mpprop.exe', 'lib/libmolcas.%s' % SHLIB_EXT,
              'sbin/help_basis', 'sbin/pymolcas'],
    'dirs': ['data/', 'basis_library/'],
}

sanity_check_commands = ['pymolcas --help']

moduleclass = 'chem'

# again alps problem -> need serial HDF5
    # CMake Warning at alps/CMakeLists.txt:49 (MESSAGE):
    #   parallel(MPI) hdf5 is detected.  We will compile but ALPS does not use
    #   parallel HDF5.  The standard version is preferred.


    # CMake Error at alps/CMakeLists.txt:51 (MESSAGE):
    #   parallel(MPI) hdf5 needs MPI.  Enable MPI or install serial HDF5 libraries.

