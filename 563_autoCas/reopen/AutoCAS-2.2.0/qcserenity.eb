easyblock = 'PythonBundle'

name = 'qcserenity'
version = '1.6.3.post2'

homepage = 'https://www.uni-muenster.de/Chemie.oc/neugebauer/softwareAKN.html'
description = """SERENITY is an open-source, C++ Quantum Chemistry code especially designed for calculations
on systems composed of several subsystems. It features a wide variety of subsystem and embedding methods.
"""

toolchain = {'name': 'iomkl', 'version': '2023a'}

builddependencies = [
    ('pybind11', '2.11.1'),  # qcserenity builddep
    ('scikit-build-core', '0.10.6'),  # qcserenity builddep
    ('Eigen', '3.4.0'),  # qcserenity builddep
]
dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    # ('matplotlib', '3.7.2'),
    # ('Pillow', '10.0.0'),
    # ('PyYAML', '6.0'),
    ('HDF5', '1.14.0', '-serial-CMake'),
    # ('h5py', '3.9.0', '-serial-CMake'),
    # ('OpenMolcas', '25.02', '-DMRG-no-MPI'),
    # ('OpenMolcas', '23.10'),
    # ('GMP', '6.2.1'),
    # ('Boost', '1.82.0'),
]

exts_list = [
    (name, version, {
        'installopts': '-C cmake.define.HDF5_DIR="$EBROOTHDF5/cmake" -C cmake.define.MKL_ROOT="$EBROOTIMKL"',
        'modulename': 'serenipy',
        'checksums': ['d83c9393d981a27674a8006ab002c25eb034a588be8cf482293ef845882361b8'],
    }),
]

check_ldshared = True

# sanity_check_commands = ["python3 -m scine_autocas -h"]

moduleclass = 'tools'
