easyblock = 'CMakeMake'

name = 'QCMaquis'
version = '3.1.4'

homepage = "https://github.com/qcscine/qcmaquis"
description = """QCMaquis is written in C++ (C++14 standard) and parallelizes the computationally heavy steps of
a DMRG simulation with shared-memory parallelism (OpenMP)."""

toolchain = {'name': 'iomkl', 'version': '2023a'}
# toolchainopts = {'usempi': True, 'optarch': False}

# source_urls = ['https://github.com/qcscine/qcmaquis/archive']
# sources = ["release-%(version)s.tar.gz"]

_molcas_name = 'OpenMolcas'
_molcas_version = '25.02'
_molcas_commit = 'bd63d2168b911f0dc2f7ea00013cb2b37bf41d95'

# OpenMolcas-v25.02-bd63d2168b911f0dc2f7ea00013cb2b37bf41d95/
# qcmaquis-release-3.1.4/
    # {
    #     'source_urls': ['https://gitlab.com/Molcas/OpenMolcas/-/archive/v25.02/'],
    #     # 'download_filename': 'OpenMolcas-25.02.tar.gz',
    #     'filename': f"{_molcas_name}-v{_molcas_version}.tar.gz",
    # },
sources = [
    {
        'source_urls': ['https://github.com/qcscine/qcmaquis/archive'],
        'download_filename': 'release-%(version)s.tar.gz',
        'filename': '%(name)s-%(version)s.tar.gz',
    },
    # {
    #     'source_urls': ['https://gitlab.com/Molcas/OpenMolcas/-/archive/v25.02/'],
    #     # 'download_filename': 'OpenMolcas-25.02.tar.gz',
    #     'filename': f"{_molcas_name}-v{_molcas_version}.tar.gz",
    # },    
    { 'filename': f"{_molcas_name}-v{_molcas_version}.tar.gz", 'alt_location': f"{_molcas_name}"},
]
checksums = [
    {'QCMaquis-3.1.4.tar.gz': '98eaa0a057a8f056ebeab8427c8b59efaf2d71667a2d71491b900adbe0d29341'},
    {'OpenMolcas-v25.02.tar.gz': '7d25d4f0563bf3c1c08ed4b48c50e38fc9a8ece77f28661d55886df6e88dcf26'},
]

builddependencies = [('CMake', '3.26.3')]
dependencies = [
    ('HDF5', '1.14.0', '-serial'),
    ('GSL', '2.7'),
    ('Boost', '1.82.0'),
]

start_dir = 'dmrg'

# fix missing MPI find for ALPS CMakeLists.txt
# preconfigopts = "sed  -i '32ifind_package(MPI)' %(start_dir)s/alps/CMakeLists.txt && "

configopts = '-DBUILD_OPENMOLCAS_INTERFACE=ON -DCMAKE_Fortran_FLAGS="-fpp -D_MOLCAS_MPP_" -DQCMAQUIS_TESTS=ON'
# configopts = '-DBUILD_OPENMOLCAS_INTERFACE=ON -DQCMAQUIS_TESTS=ON'

# fix build of test_wigner
prebuildopts = "sed -i '14i#include <array>' %(start_dir)s/tests/test_wigner.cpp && "
prebuildopts += "export MOLCAS_INCLUDE_DIR="
prebuildopts += f"%(builddir)s/{_molcas_name}-v{_molcas_version}-{_molcas_commit}/src/Include && "

runtest = True

moduleclass = 'chem'

