easyblock = 'CMakeMake'

name = 'OpenMolcas'
version = '25.02'
versionsuffix = '-DMRG'

homepage = "https://gitlab.com/Molcas/OpenMolcas"
description = "OpenMolcas is a quantum chemistry software package."

toolchain = {'name': 'intel', 'version': '2023a'}
# toolchainopts = {'usempi': True, 'optarch': False, 'cstd': 'gnu89', 'extra_cflags': '-std=gnu89'}  # optarch required to pass all tests
toolchainopts = {'usempi': True, 'optarch': False}

source_urls = ['https://gitlab.com/Molcas/OpenMolcas/-/archive/v%(version)s/']
sources = ["%(name)s-v%(version)s.tar.gz"]
patches = [
    '%(name)s-23.06_mcpdft_deps.patch',
    'patch1.1.0-fix_nevpt2.cmake.patch',
]
checksums = [
    {'OpenMolcas-v25.02.tar.gz': '7d25d4f0563bf3c1c08ed4b48c50e38fc9a8ece77f28661d55886df6e88dcf26'},
    {'OpenMolcas-23.06_mcpdft_deps.patch': 'a798ec6f93a19539aa2211a978da461d4ecd31c5521b9dab6f2a9b1c2fa65f0e'},
    {'patch1.1.0-fix_nevpt2.cmake.patch': '06e3def784341db7221fe6c9f6768a9c5c4946ed98a7f9eb54f69de858a57c0b'},
]

builddependencies = [('CMake', '3.26.3')]

dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('lxml', '4.9.2'),
    ('HDF5', '1.14.0', '-serial'),
    ('GlobalArrays', '5.8.2'),
    ('libxc', '6.2.2'),
    ('GSL', '2.7'),
    ('Boost', '1.82.0'),
]

build_shared_libs = True

# preconfigopts = 'export CFLAGS="$CFLAGS -std=gnu89" && '
# preconfigopts += 'GAROOT=$EBROOTGLOBALARRAYS'
preconfigopts = 'GAROOT=$EBROOTGLOBALARRAYS'
_copts = [
    '-DLINALG=MKL',
    '-DMKLROOT=$MKLROOT',
    '-DOPENMP=ON',
    '-DTOOLS=ON',
    '-DFDE=ON',
    '-DMPI=ON',
    '-DGA=ON',
    '-DEXTERNAL_LIBXC=$EBROOTLIBXC',
    '-DPython_ROOT=$EBROOTPYTHON',
    '-DDMRG=ON',
    '-DNEVPT2=ON',
]
configopts = ' '.join(_copts)
# configopts += " --enable-c++ CPPFLAGS=-fgnu89-inline "
# configopts += "CFLAGS=-std=c99 "
# configopts += " CFLAGS='-std=gnu89' "

# prebuildopts = 'export CFLAGS="$CFLAGS -std=gnu89" && '
# prebuildopts = 'export CFLAGS="-std=gnu89" && '
# buildopts = "CFLAGS='-std=gnu89' CC='icc -std=gnu89'"

# prebuildopts = ( # /External/nevpt2_ext/src/nevpt2_ext is empty before builds
    # r"sed -i '1i\\#include <string.h>\\\n#include <time.h>' "
    # "%(builddir)s/easybuild_obj/External/nevpt2_ext/src/nevpt2_ext/src/gctime.c && "
    # r"sed -i 's/^gctime *(fstr, *lstr) *f77_char \\*fstr; *int lstr; *{/int gctime(f77_char fstr, int lstr) {/' "
    # "%(builddir)s/easybuild_obj/External/nevpt2_ext/src/nevpt2_ext/src/gctime.c && "
    # r"sed -i 's/^gctime_ *(fstr, *lstr) *f77_char \\*fstr; *int lstr; *{/int gctime_(f77_char fstr, int lstr) {/' "
    # "%(builddir)s/easybuild_obj/External/nevpt2_ext/src/nevpt2_ext/src/gctime.c && "
    # "sed -i '/long time(), t;/d' %(builddir)s/easybuild_obj/External/nevpt2_ext/src/nevpt2_ext/src/gctime.c && "
    # "sed -i '/char \\*ctime();/d' %(builddir)s/easybuild_obj/External/nevpt2_ext/src/nevpt2_ext/src/gctime.c && "
# )


pretestopts = 'MOLCAS=%(builddir)s/easybuild_obj '
pretestopts += 'MOLCAS_DRIVER=%(builddir)s/easybuild_obj/pymolcas '
pretestopts += 'MOLCAS_SOURCE=%(builddir)s/easybuild_obj '
pretestopts += 'PATH=%(builddir)s/easybuild_obj:$PATH '
test_cmd = 'pymolcas verify'

fix_python_shebang_for = ['pymolcas', 'Tools/AugerOca/*.py', 'Tools/AugerOca/auger_oca/*.py', 'Tools/mort/mort.py',
                          'Tools/dynamixtools/dynamixtools.py']

modextrapaths = {'PATH': ''}
modextravars = {
    'MOLCAS': '%(installdir)s',
    'MOLCAS_DRIVER': '%(installdir)s/pymolcas',
    'MOLCAS_SOURCE': '%(installdir)s',
}

sanity_check_commands = ['pymolcas --help']

sanity_check_paths = {
    'files': ['bin/dynamix.exe', 'bin/mpprop.exe', 'lib/libmolcas.%s' % SHLIB_EXT,
              'sbin/help_basis', 'pymolcas'],
    'dirs': ['data/', 'basis_library/'],
}

moduleclass = 'chem'

