#         'preinstallopts': 'export CMAKE_ARGS="-Dgmxapi_ROOT=%(installdir)s ' +
#                         #  '-C %(installdir)s/share/cmake/gromacs_mpi/gromacs-hints_mpi.cmake" && ',
#                             '-C %(installdir)s/share/cmake/gromacs/gromacs-hints.cmake" && ',
#         'source_tmpl': '%%(name)s-%%(version)s-%s.tar.gz' % local_commit,
#         'start_dir': 'python_packaging/src/gmxapi',
#         'checksums': ['4ec8f8d0c7af76b13f8fd16db8e2c120e749de439ae9554d9f653f812d78d1cb'],
#     }),
# ]

moduleclass = 'bio'
