easyblock = 'EB_NCL'

name = 'ncarg'
version = '6.0.0'

homepage = 'https://www.ncl.ucar.edu'
description = "NCL is an interpreted language designed specifically for scientific data analysis and visualization."

toolchain = {'name': 'intel', 'version': '2025b'}

toolchainopts = {'cstd': 'gnu89', 'openmp': True, 'pic': True, 'noopt': True}

# https://portal.nccs.nasa.gov/datashare/astg/nuwrf/baselibs/ncl_ncarg-6.0.0.tar.gz
source_urls = ['https://portal.nccs.nasa.gov/datashare/astg/nuwrf/baselibs/']
sources = ['ncl_ncarg-6.0.0.tar.gz']
checksums = ['190beae6301db3ab10bf86b8a2de314f6f251fa0a2bce36ba4029b71a99d6565']

builddependencies = [
    ('makedepend', '1.0.9'),
    # ('Bison', '3.8.2'),
    ('byacc', '2.0.20241231'),
    ('flex', '2.6.4'),
]
dependencies = [
    ('cURL', '8.14.1'),
    ('JasPer', '4.2.8'),
    ('g2lib', '4.0.0'),
    ('HDF5', '1.14.6'),
    ('HDF', '4.3.1'),
    ('netCDF', '4.9.3'),
    ('netCDF-Fortran', '4.6.2'),
    ('Szip', '2.1.1'),
    ('freetype', '2.13.3'),
    ('zlib', '1.3.1'),
    ('GDAL', '3.11.3'),
    ('UDUNITS', '2.2.28'),
    ('ESMF', '8.9.0'),
    ('bzip2', '1.0.8'),
    ('cairo', '1.18.4'),
    ('libiconv', '1.18'),
    ('GSL', '2.8'),
    ('libpng', '1.6.50'),
    ('libjpeg-turbo', '3.1.1'),
]

# 3. FIX THE SEGFAULT AND MISSING SEPARATOR
# The 'ymake' tool is built using 'config/Makefile.ini'. 
# This file hardcodes 'cc'. We must force it to use 'icx' with permissive flags
# BEFORE the EasyBlock runs 'make -f Makefile.ini'.
preconfigopts = "sed -i 's/cc/icx -std=gnu89 -Wno-int-conversion -Wno-implicit-function-declaration -Wno-incompatible-function-pointer-types -Wno-error/g' config/Makefile.ini && "

# 4. Compiler Flags to pass to the EasyBlock
# -D_POSIX_SOURCE: Required for NCL on Linux
# -DH5_USE_18_API: Required because you are linking HDF5 1.14, but NCL 6.0 expects HDF5 1.8
# -Wno-error: Prevent build stopping on warnings
env_cflags = [
    '-std=gnu89',
    '-D_POSIX_SOURCE', 
    '-D_XOPEN_SOURCE',
    '-DByteSwapped',
    '-DNeedFuncProto',
    '-DH5_USE_18_API',
    '-Wno-error',
    '-Wno-implicit-function-declaration',
    '-Wno-incompatible-function-pointer-types',
    '-Wno-int-conversion'
]

# 5. Fortran Flags
# -std=legacy: Required for old Fortran 77/90 code in NCL
# -allow no-fpp-comments: Fixes Intel preprocessor choking on C-style comments
env_fflags = [
    '-std=legacy',
    '-fPIC',
    '-allow no-fpp-comments'
]

# Inject these into the environment so EB_NCL picks them up
preconfigopts += "export CC=icx && export F90=ifx && "
preconfigopts += "export CFLAGS='%s' && " % ' '.join(env_cflags)
preconfigopts += "export FFLAGS='%s' && " % ' '.join(env_fflags)

moduleclass = 'data'
