# toolchainopts = {'cstd': 'c99', 'openmp': True, 'pic': True}
# toolchainopts = {'cstd': 'gnu89', 'openmp': True, 'pic': True}

toolchainopts = {'cstd': 'gnu89', 'openmp': True, 'pic': True, 'noopt': True}

