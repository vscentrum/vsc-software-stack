# readelf -d liftOver | egrep 'NEEDED|RPATH|RUNPATH' 
# 0x0000000000000001 (NEEDED) Shared library: [libm.so.6] 
# 0x0000000000000001 (NEEDED) Shared library: [libc.so.6] 
# 0x0000000000000001 (NEEDED) Shared library: [ld-linux-x86-64.so.2] 
# 0x0000000000000001 (NEEDED) Shared library: [libcurl.so.4] 
# 0x0000000000000001 (NEEDED) Shared library: [libgcc_s.so.1]

easyblock = 'Binary'

name = 'liftOver'
version = '20260409'

homepage = 'https://genome.ucsc.edu/'
description = "UCSC liftOver for converting genome coordinates between assemblies."

toolchain = SYSTEM

osdependencies = ['curl']

sources = [{
    'filename': 'liftOver',
    'extract_cmd': 'cp -L %s .',
}]

# dependencies = [
#     ('cURL', 'x.y.z'),
# ]

install_cmd = 'install -D -m 755 liftOver %(installdir)s/bin/liftOver'

sanity_check_paths = {
    'files': ['bin/liftOver'],
    'dirs': [],
}

sanity_check_commands = [
    'liftOver 2>&1 | grep "Move annotations from one assembly to another"',
]

moduleclass = 'bio'
