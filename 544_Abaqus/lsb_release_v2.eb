easyblock = 'ConfigureMake'

name = 'lsb_release'
version = '3.3'

homepage = 'https://github.com/thkukuk/lsb-release_os-release'
description = """LSB version query program (lsb_release) by Dominique Massonie."""

toolchain = SYSTEM
# https://github.com/thkukuk/lsb-release_os-release/releases/download/v3.3/lsb-release-3.3.tar.gz
source_urls = ['https://github.com/thkukuk/lsb-release_os-release/releases/download/v3.3']
sources = [{'download_filename': 'lsb-release-3.3.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}]
checksums = ['b42c842e98d5fc875b5c8c23784aed891a8e771b6bb8302b7dbe77e676c50ea9']

skipsteps = ['configure']

# prebuildopts = "sed -i 's|/usr/local|%(installdir)s|' Makefile && "
# prebuildopts += "sed -i '198 s|$MSG_NA|2.0|' lsb_release && "
prebuildopts = "export INSTALL_ROOT='%(installdir)s' && "
prebuildopts += "sed -i 's|LSB_VERSION=$MSG_NA|LSB_VERSION=%(version)s|' lsb_release && "
preinstallopts = prebuildopts

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': ['bin'],
}

sanity_check_commands = ['%(name)s --help']

moduleclass = 'tools'
