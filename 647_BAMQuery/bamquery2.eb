# postinstallpatches = ['patch1.1.patch']
postinstallcmds = [
    'cp -r %(builddir)s/BamQuery/BamQuery* %(installdir)s/BamQuery',
    'mkdir -p %(installdir)s/bin',
    'echo "#!/usr/bin/env bash" > %(installdir)s/bin/bamquery',
    """echo 'exec python "$EBROOTBAMQUERY/BamQuery/BamQuery.py" "$@"' >> %(installdir)s/bin/bamquery""",
    'chmod 755 %(installdir)s/bin/bamquery',
]

sanity_check_paths = {
    'files': ['bin/bamquery'],
    'dirs': ['lib/python%(pyshortver)s/site-packages', 'BamQuery'],
}

sanity_check_commands = [
    'bamquery --help',
]

moduleclass = 'bio'
