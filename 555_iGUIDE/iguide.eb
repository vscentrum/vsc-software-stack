easyblock = 'PythonBundle'

name = 'iGUIDE'
version = '1.1.2'

homepage = 'https://github.com/cnobles/iGUIDE'
description = """iGUIDE is a pipeline written in snakemake for processing and analyzing double-strand DNA break events.
These events may be induced, such as by designer nucleases like Cas9, or spontaneous,
as produced through DNA replication or ionizing radiation."""

toolchain = {'name': 'foss', 'version': '2023a'}

# source_urls = ['https://github.com/cnobles/iGUIDE/archive']
# sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
# checksums = ['cb19e2d24b529cc830b8e1849075195ef298fae6016743fd65cc67b28b815806']

# R-bioconductor missing:
    # OK hiAnnotator 1.36.0
# CRAN missing:
    # OK kableExtra

builddependencies = [('hatchling', '1.18.0')]
dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    ('snakemake', '8.4.2'),
    ('ruamel.yaml', '0.17.32'),
    ('BLAT', '3.7'),
    ('BWA', '0.7.17'),
    ('SAMtools', '1.18'),
    ('Pandoc', '3.1.2', '', SYSTEM),
    ('graphviz-python', '0.20.1'),
    ('R', '4.3.2'),
    # ('R-bundle-Bioconductor', '3.18', '-with-HiAnnotator'),  # UPDATE bundle
    ('RbB', '3.18', '-with-HiAnnotator'),
    ('R-bundle-CRAN', '2023.12'),
]

components = [
    ('iguideSupport', version, {
        'easyblock': 'RPackage',
        'source_urls': ['https://github.com/cnobles/iGUIDE/archive'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'start_dir': 'iGUIDE-1.1.2/tools/iguideSupport',
        'checksums': ['cb19e2d24b529cc830b8e1849075195ef298fae6016743fd65cc67b28b815806'],
    }),
]

exts_list = [
    ('semantic_version', '2.10.0', {
        'checksums': ['bdabb6d336998cbb378d4b9db3a4b56a1e3235701dc05ea2690d9a997ed5041c'],
    }),
    ('plumbum', '1.8.3', {
        'checksums': ['6092c85ab970b7a7a9d5d85c75200bc93be82b33c9bdf640ffa87d2d7c8709f0'],
    }),
    ('pandoc', '2.3', {
        'checksums': ['e772c2c6d871146894579828dbaf1efd538eb64fc7e71d4a6b3a11a18baef90d'],
    }),
    ('iguidelib', version, {
        'preinstallopts': 'export IGUIDE_DIR="%(builddir)s/iguidelib/iGUIDE-1.1.2" && ',
        'source_urls': ['https://github.com/cnobles/iGUIDE/archive'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}],
        'start_dir': 'tools/iguidelib',
        'checksums': ['cb19e2d24b529cc830b8e1849075195ef298fae6016743fd65cc67b28b815806'],
    }),
]

postinstallcmds = [
    'cp %(builddir)s/iGUIDE-1.1.2/Snakefile %(installdir)s',
    'cp %(builddir)s/iguidelib/iGUIDE-1.1.2/.version %(installdir)s',
    'cp -r %(builddir)s/iGUIDE-1.1.2/rules %(installdir)s/rules',
    'cp -r %(builddir)s/iGUIDE-1.1.2/configs %(installdir)s/configs',
    'cp -r %(builddir)s/iGUIDE-1.1.2/analysis %(installdir)s/analysis',
    'cp -r %(builddir)s/iGUIDE-1.1.2/sampleInfo %(installdir)s/sampleInfo',
    'cp -r %(builddir)s/iGUIDE-1.1.2/tools %(installdir)s/tools',
    'cp -r %(builddir)s/iGUIDE-1.1.2/etc %(installdir)s/etc',
    'cp -r %(builddir)s/iGUIDE-1.1.2/genomes %(installdir)s/genomes',
    "sed -i 's/(unique_index_seqs,/(as.character(unique_index_seqs),/' %(installdir)s/tools/rscripts/demulti.R",
    "sed -i 's/lengths(/base::lengths(/' %(installdir)s/tools/rscripts/demulti.R",
]

# sanity_check_paths = {
#     'files': ['bin/ipa', 'etc/ipa.snakefile'],
#     'dirs': [],
# }

# sanity_check_commands = [
#     'ipa --version',
# ]

modextrapaths = {
    'IGUIDE_DIR': '',
    'R_LIBS_SITE': '',
}

moduleclass = 'bio'

