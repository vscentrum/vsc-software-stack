builddependencies = [
    ('hatchling', '1.18.0'),
    ('maturin', '1.1.0'),
    ('CMake', '3.26.3'),
    ('Ninja', '1.11.1'),
]
dependencies = [
    ('CUDA', '12.1.1', '', SYSTEM),
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    ('SentencePiece', '0.2.0'),
    ('py-cpuinfo', '9.0.0'),
    ('Transformers', '4.39.3'),
    ('pydantic', '2.5.3'),
    ('tiktoken', '0.6.0'),
    ('PyTorch', '2.1.2', versionsuffix),
    ('Triton', '2.1.0', versionsuffix),
    ('Ray-project', '2.9.1'),
    ('numba', '0.58.1'),
    ('flash-attention', '2.6.3', versionsuffix)
