easyblock = 'PythonBundle'

name = 'vLLM'
version = '0.6.0' # needs PyTorch == 2.4.0 -> go for 0.4.0 -> separate EC
homepage = 'https://github.com/vllm-project/vllm'
description = """A high-throughput and memory-efficient inference and serving engine for LLMs."""

toolchain = {'name': 'foss', 'version': '2023b'}
toolchainopts = {'cstd': 'c++17'}

# DEPS:
    # OK psutil
    # OK sentencepiece  # Required for LLaMA tokenizer.
    # OK numpy < 2.0.0
    # OK requests
    # OK tqdm
    # OK py-cpuinfo
    # OK transformers >= 4.43.2  # Required for Chameleon and Llama 3.1 hotfox.
    # OK tokenizers >= 0.19.1  # Required for Llama 3.
    # OK protobuf # Required by LlamaTokenizer.
    # ok fastapi
    # OK aiohttp
    # OK openai >= 1.0 # Ensure modern openai package (ensure types module present) - CREATED
    # ok uvicorn[standard]
    # X pydantic >= 2.8  # Required for OpenAI server. -> openai seem is ok with v2.7.4
    # OK pillow  # Required for image processing
    # ok prometheus_client >= 0.18.0
    # ok prometheus-fastapi-instrumentator >= 7.0.0
    # OK tiktoken >= 0.6.0  # Required for DBRX tokenizer - CREATpdmED
    # ok lm-format-enforcer == 0.10.6
    # ok outlines >= 0.0.43, < 0.1 # Requires torch >= 2.1.0
    # OK typing_extensions >= 4.10
    # OK filelock >= 3.10.4 # filelock starts to support `mode` argument from 3.10.4
    # ok partial-json-parser # used for parsing partial JSON outputs
    # OK pyzmq
    # ok msgspec
    # ok gguf == 0.9.1
    # OK importlib_metadata
    # ok mistral_common >= 1.3.4
    # OK pyyaml
    # OK ModuleNotFoundError: No module named 'torch'
    # OK ModuleNotFoundError: No module named 'pdm' - CREATED

builddependencies = [
    ('hatchling', '1.18.0'),
    ('poetry', '1.6.1'),
    ('PDM', '2.18.2'),
    ('CMake', '3.27.6'),
    ('Ninja', '1.11.1'),
]

dependencies = [
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'),
    ('SciPy-bundle', '2023.11'),
    ('SentencePiece', '0.2.0'),
    ('tqdm', '4.66.2'),
    ('py-cpuinfo', '9.0.0'),
    ('Transformers', '4.44.0'),
    ('tokenizers', '0.19.1'),
    ('protobuf', '25.3'),
    ('aiohttp', '3.9.5'),
    ('openai-python', '1.39.0'),
    ('pydantic', '2.7.4'),
    ('Pillow', '10.2.0'),
    ('tiktoken', '0.7.0'),
    ('typing-extensions', '4.10.0'),
    ('PyZMQ', '25.1.2'),
    ('PyYAML', '6.0.1'),
    ('PyTorch', '2.1.2'),
]

use_pip = True

