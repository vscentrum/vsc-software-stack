        'preinstallopts': r"sed -i 's/\"cuda\"/\"cpu\"/' vllm/envs.py && sed -i '3 a #include <variant>' csrc/core/scalar_type.hpp && ",
        'source_urls': ['https://github.com/vllm-project/vllm/archive/'],
        'sources': ['%(namelower)s-%(version)s.tar.gz'],
        'checksums': ['40c573bc5e4124d34f4de02af8e23a584e51de66ae17cd5910af0cf63ee26eaa'],
    }),
]

sanity_pip_check = True

moduleclass = 'ai'

