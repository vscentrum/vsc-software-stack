easyblock = 'PythonPackage'

name = 'xformers'
version = '0.0.23.post1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/facebookresearch/xformers'
description = """Flexible Transformers, defined by interoperable and optimized building blocks."""

toolchain = {'name': 'foss', 'version': '2023a'}

sources = [SOURCE_TAR_GZ]
checksums = ['b443b158bd7b5275b485d2c6aee94ebc2152878fd784e379b1c8bcb1d67f3b81']

builddependencies = [
    ('CMake', '3.26.3'),
    ('Ninja', '1.11.1'),
]
dependencies = [
    ('CUDA', '12.1.1', '', SYSTEM),
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    ('PyTorch-bundle', '2.1.2', versionsuffix),
    ('flash-attention', '2.6.3', versionsuffix),
    ('CUTLASS', '3.4.0', versionsuffix),
    ('Triton', '2.1.0', versionsuffix),
]

maxparallel = 1
use_pip = True
download_dep_fail = True

preinstallopts = 'export XFORMERS_MORE_DETAILS=1 && '
# preinstallopts += 'export XFORMERS_DISABLE_FLASH_ATTN=1 && '
# preinstallopts += 'export NVCC_THREADS=1 && '
preinstallopts += 'export TORCH_CUDA_ARCH_LIST="5.2;6.0;7.0;7.5;8.0;8.6;9.0" && '
preinstallopts += 'export MAX_JOBS=1 && '
# preinstallopts += 'export MAX_JOBS=3 && '
# preinstallopts += 'export FORCE_CUDA=1 && '
# fix version to 0.0.23.post1
# preinstallopts += "sed -i 's/24/23.post1/' version.txt && "
# preinstallopts += "sed -i '385d' setup.py && "
preinstallopts += "sed -i '274 s/4/1/' setup.py && "
preinstallopts += "sed -i '191 s/3/2/' setup.py && "
preinstallopts += "sed -i '238 s/3/2/' setup.py && "

# local_preinstallopts += "sed -i '225,232d' setup.py && "
# local_preinstallopts += "sed -i '224a\    cutlass_dir_ebroot=os.getenv(\"$EBROOTCUTLASS\")' setup.py && "
# local_preinstallopts += "sed -i '225a\    cutlass_dir=os.path.join(cutlass_dir_ebroot, \"include\")' setup.py && "
# local_preinstallopts += "sed -i 's/cutlass_dir, cutlass_examples_dir/cutlass_dir/' setup.py && "

# exts_list = [
#     (name, version, {
#         'preinstallopts': local_preinstallopts,
#         # 'installopts': '--index-url https://download.pytorch.org/whl/cu121',
#         # 'source_urls': ['https://github.com/facebookresearch/xformers/archive/'],
#         'sources': [{
#             'filename': 'v%(version)s-rec.tar.gz',
#             'git_config': {
#                 'url': 'https://github.com/facebookresearch',
#                 'repo_name': 'xformers',
#                 'tag': 'v%(version)s',
#                 'recursive': True,
#                 'keep_git_dir': True,
#             }
#         }],
#         'checksums': [None],
#     }),
# ]

sanity_pip_check = True

# my_test_cmd = 'python -m xformers.info'
moduleclass = 'ai'

