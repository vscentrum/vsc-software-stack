easyblock = 'PythonBundle'

name = 'xformers'
version = '0.0.23.post1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/facebookresearch/xformers'
description = """Flexible Transformers, defined by interoperable and optimized building blocks."""

toolchain = {'name': 'foss', 'version': '2023a'}

builddependencies = [
#     ('hatchling', '1.18.0'),
#     ('maturin', '1.1.0'),
#     ('CMake', '3.26.3'),
    ('Ninja', '1.11.1'),
]
dependencies = [
    ('CUDA', '12.1.1', '', SYSTEM),
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    # ('SentencePiece', '0.2.0'),
    # ('py-cpuinfo', '9.0.0'),
    # ('Transformers', '4.39.3'),
    # ('pydantic', '2.5.3'),
    # ('tiktoken', '0.6.0'),
    ('PyTorch-bundle', '2.1.2', versionsuffix),
    # ('Triton', '2.1.0', versionsuffix),
    # ('Ray-project', '2.9.1'),
    # ('numba', '0.58.1'),
    ('flash-attention', '2.6.3', versionsuffix),
    ('CUTLASS', '3.4.0', versionsuffix),
]

use_pip = True

local_preinstallopts = 'export TORCH_CUDA_ARCH_LIST="5.2;6.0;7.0;7.5;8.0;8.6;9.0" && '
local_preinstallopts += 'export MAX_JOBS=2 && '
local_preinstallopts += 'export FORCE_CUDA=1 && '

exts_list = [
    (name, version, {
        'preinstallopts': local_preinstallopts,
        'source_urls': ['https://github.com/facebookresearch/xformers/archive/'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'checksums': ['95e5fa8f6ac63f11b4c7122e01c0892beae91f754a64a7e525bc06c3b49feac7'],
    }),
]

sanity_pip_check = True

moduleclass = 'ai'

# xformers with cuda:
    #   TORCH_CUDA_ARCH_LIST="6.0;6.1;6.2;7.0;7.2;8.0;8.6"
    #   5.2;6.0;7.0;7.5;8.0;8.6;9.0
    # TORCH_CUDA_ARCH_LIST="5.2;6.0;7.0;7.5;8.0;8.6;9.0"
    # export MAX_JOBS=2
    # FORCE_CUDA=1
    # ? export NVCC_THREADS=1
    