easyblock = 'PythonBundle'

name = 'pyclesperanto'
version = '0.14.2'

homepage = 'https://github.com/haesleinhuepf/devbio-napari'
description = """pyclesperanto is the python package of clEsperanto - a multi-language framework
for GPU-accelerated image processing. It relies on a familly of OpenCL kernels originated from CLIJ.
This package is developped in python and C++ wrapped using PyBind11, and uses the C++ CLIc
library as a processing backend."""

toolchain = {'name': 'foss', 'version': '2023a'}

builddependencies = [
    ('scikit-build-core', '0.5.0'),
    ('Ninja', '1.11.1'),
]

dependencies = [  # TODO some are not necessary
    ('Python', '3.11.3'),
    ('napari', '0.4.18'),
    ('jupyter-server', '2.7.2'),
    ('JupyterLab', '4.0.5'),
    ('Seaborn', '0.13.2'),
    ('scikit-learn', '1.3.1'),
    ('SimpleITK', '2.3.1'),
    ('PyQtGraph', '0.13.7'),
    ('PyOpenCL', '2023.1.4'),
    ('Deprecated', '1.2.14'),
    ('imagecodecs', '2024.1.1'),
    ('HDBSCAN', '0.8.38.post1'),
    ('umap-learn', '0.5.5'),
    ('Mako', '1.2.4'),
    ('autopep8', '2.2.0'),
    ('Qt5', '5.15.10'),
    ('ipympl', '0.9.3'),
]

exts_list = [
    ('pyclesperanto_prototype', '0.24.5', {
        'checksums': ['aa38b346e9beaa716fafeb205c7999302aed1b20c07b9749f52d290c278359bc'],
    }),
    ('transforms3d', '0.4.2', {
        'checksums': ['e8b5df30eaedbee556e81c6938e55aab5365894e47d0a17615d7db7fd2393680'],
    }),
    (name, version, {
        'checksums': ['879f48f1bb60297d4af654c510b791616cb6722fd0e5269014a0907d2e661edb'],
    }),
]

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

