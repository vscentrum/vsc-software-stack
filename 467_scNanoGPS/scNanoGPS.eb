easyblock = 'PythonBundle'

name = 'scNanoGPS'
version = '1.1'

homepage = 'https://github.com/gaolabtools/scNanoGPS/'
description = "Single cell Nanopore sequencing data for Genotype and Phenotype."

toolchain = {'name': 'foss', 'version': '2023a'}

