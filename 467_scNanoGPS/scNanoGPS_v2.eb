            # ADD_TO_CRAN gcmr
            # OK betareg
        
dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    ('Biopython', '1.83'),
    ('matplotlib', '3.7.2'),
    ('Pysam', '0.22.0'),
    ('Seaborn', '0.13.2'),
    ('Perl', '5.36.1'),
    ('minimap2', '2.26'),
    ('SAMtools', '1.18'),
    ('tabix', '0.2.6'),
    ('spoa', '4.1.0'),
    ('Subread', '2.0.6'),
    ('Longshot', '1.0.0'),
    ('BCFtools', '1.21'),
    ('gffread', '0.12.7'),
    ('lifelines', '0.28.0'),
    ('R', '4.3.2'),
    ('R-bundle-CRAN', '2023.12'),
    # annovar
]

exts_defaultclass = 'PythonPackage'
exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'download_dep_fail': True,
    'use_pip': True,
    # 'sanity_pip_check': False,
}

exts_list = [
    ('liqa', '1.3.4', {
        'modulename': False,
        'checksums': ['f8b2e6f0226d99f513d17be3758e6b3e2e9b7b40579f840d28737e827358850e'],
    }),
    ('Distance', '0.1.3', {
        'checksums': ['60807584f5b6003f5c521aa73f39f51f631de3be5cccc5a1d67166fcbf0d4551'],
    }),
]

sanity_check_paths = {
    'files': ['bin/liqa'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = [
    "liqa -h",
    "python -c 'import distance'",
    "python other_utils/read_length_profiler.py -h",
    "python scanner.py -h",
    "python assigner.py -h",
    "python curator.py -h ",
    "python reporter_expression.py -h",
    "python reporter_isoform.py -h",
    "python reporter_SNV.py -h",
    "python reporter_summary.py -h"
]

modextrapaths = {'PYTHONPATH': 'lib/python%(pyshortver)s/site-packages'}

moduleclass = 'bio'
