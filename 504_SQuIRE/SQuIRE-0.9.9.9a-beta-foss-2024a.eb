easyblock = 'PythonBundle'

name = 'SQuIRE'
version = '0.9.9.9a-beta'

homepage = 'https://github.com/wyang17/SQuIRE'
description = """Software for Quantifying Interspersed Repeat Expression"""

toolchain = {'name': 'foss', 'version': '2024a'}

dependencies = [
    ('Python', '3.12.3'),
    ('pyfaidx', '0.8.1.2'),
    ('Python-bundle-PyPI', '2024.06'),  # for `six` and `urllib3`
]

use_pip = True

# leading zeros in decimal integer literals are not permitted `os.makedirs(path, 0770)`
preinstallopts = "sed -i 's/0770/0o770/g' squire/*.py && "

exts_list = [
    (name, version, {
        'source_urls': ['https://github.com/wyang17/SQuIRE/archive/'],
        'sources': ['v%(version)s.tar.gz'],
        'checksums': ['90d55b22f95ece4a63789f23ecf9217cdc4a5b4c372271f6be00a5e77fbc8752'],
    }),
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = [
    "squire -h",
]

sanity_pip_check = True

moduleclass = 'bio'

# TODO
# cannot import name 'urlopen' from 'urllib3
