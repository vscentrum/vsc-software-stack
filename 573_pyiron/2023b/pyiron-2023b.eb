easyblock = 'PythonBundle'

name = 'pyiron'
version = '0.5.2'

homepage = 'https://github.com/pyiron/pyiron'
description = "An integrated development environment (IDE) for computational materials science."

toolchain = {'name': 'foss', 'version': '2023b'}

