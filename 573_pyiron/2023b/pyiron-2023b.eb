builddependencies = [('poetry', '1.6.1')]

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('Python-bundle-PyPI', '2023.10'),
    ('pymatgen', '2024.5.1'),
    ('pyiron_base', '0.8.0'),
    ('ASE', '3.23.0'),
    ('phonopy', '2.22.1'),
    ('scikit-learn', '1.4.0'),
    ('nglview', '3.1.4'),
]

check_ldshared = True

_pyiron_atomistics_preinstallopts = ("sed -i "
    "-e 's/==3.22.1//g' "  # unpin ASE
    "-e 's/,<=3.10.0//g' "  # unpin h5py
    "-e 's/,<=0.23//g' "  # unpin Pint
    "-e 's/,<=2.3.1//g' "  # unpin spglib
    "pyproject.toml && "
)

