easyblock = 'PythonBundle'

name = 'pyiron-gpl'
version = '0.0.5'

homepage = 'https://github.com/pyiron/pyiron_gpl'
description = """Additional modules for the pyiron IDE licensed under GPLv3.
"""

toolchain = {'name': 'foss', 'version': '2023b'}

# DEPS
        # OK 'molmod==1.4.8', -> UPDATED
        # OK? 'numpy==1.26.4', (has 1.26.2 in scipy-bundle)
        # ok 'pyiron_atomistics==0.6.10',
        # ok 'pyiron_snippets==0.1.3',
        # OK? 'quickff==2.2.4', -> UPDATED to 2.2.8
        # OK tamkin==1.2.6', -> UPDATED
        # OK 'yaff==1.6.0' -> UPDATED

builddependencies = [('hatchling', '1.18.0')]
dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('molmod', '1.4.8'),
    ('QuickFF', '2.2.8'),
    ('TAMkin', '1.2.6'),
    ('SQLAlchemy', '2.0.29'),
    ('PyYAML', '6.0.1'),
    ('tqdm', '4.66.2'),
    ('pyiron', '0.5.2'),
]

exts_list = [
    (name, version, {
        'runtest': "pytest -vvvs tests",
        'testinstall': True,
        'checksums': ['1136b2c796f14a34774f01293c885704acafcacc0cdf70b017e09eb9929d380a'],
    }),
]

check_ldshared = True

moduleclass = 'chem'
