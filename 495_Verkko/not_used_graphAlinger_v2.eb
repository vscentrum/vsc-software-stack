easyblock = 'MakeCp'

name = 'GraphAligner'
version = '1.0.20'

homepage = 'https://github.com/maickrau/GraphAligner'
description = """Seed-and-extend program for aligning long error-prone reads to genome graphs."""

toolchain = {'name': 'foss', 'version': '2023a'}

# source_urls = ['https://github.com/user-attachments/files/17976913/']
# sources = [{'download_filename': '%(name)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
sources = [{
    'filename': '%(name)s-%(version)s-rec.tar.gz',
    'git_config': {
        'url': 'https://github.com/maickrau',
        'repo_name': '%(name)s',
        'tag': 'v%(version)s',
        'recursive': True,
        'keep_git_dir': True,
    },
}]
checksums = [None]

# patches = ['patch1.1-makefile.patch']

builddependencies = [('pkgconf', '1.9.5')]
dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('Abseil', '20230125.3'),
    ('BamTools', '2.5.2'),
    ('bzip2', '1.0.8'),
    ('jemalloc', '5.3.0'),
    ('expat', '2.5.0'),
    ('libffi', '3.4.4'),
    ('libnsl', '2.0.1'),
    ('protobuf', '24.0'),
    ('SQLite', '3.42.0'),
    ('zlib', '1.2.13'),
    ('ncurses', '6.4'),
    ('sparsehash', '2.0.4'),
    ('Boost', '1.82.0'),
    ('sdsl-lite', '2.0.3'),
    ('HTSlib', '1.18'),
    ('libdivsufsort', '2.0.1'),
    # ('snakemake', '8.4.2'), # there is Snakemake >=7.0, <8.0 in deps
    # ('MashMap', '3.1.3'),  # MashMap - v2.0 or newer CREATED OK
    # # GraphAligner - v1.0.19 or newer CREATE
    # # Winnowmap - UPDATE
    # ('BWA', '0.7.18'),
    # ('minimap2', '2.26'),
    # ('SAMtools', '1.18'),
    # ('seqtk', '1.4'),
]
# fix E1
# prebuildopts = "sed -i 's|#include <api/BamReader.h>|#include <bamtools/api/BamReader.h>|' src/fastqloader.h && "
# fix E2
# prebuildopts = r"sed -i 's|zlib`/bamtools|bamtools`|' makefile && " -> NO
# try CPPFLAGS += -I$(CPATH) -> NO
# try CPPFLAGS += -I$(EBROOTBAMTOOLS)/include/bamtools -> OK
prebuildopts = r"sed -i '6 s|^.*$|CPPFLAGS += -I$(EBROOTBAMTOOLS)/include/bamtools|' makefile && "
# prebuildopts = ('sed -i '
#     r"-e '6 s|^.*$|CPPFLAGS += -I$(EBROOTBAMTOOLS)/include/bamtools|' "
#     "-e 's/'"
#     "makefile && "
# )

