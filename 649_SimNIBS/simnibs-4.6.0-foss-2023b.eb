    # ('LLVM', '16.0.6'),  # llvmlite
]

# ok simnibs 4.6.0 requires brainnet, which is not installed.
# ok simnibs 4.6.0 requires cortech, which is not installed.
# ok simnibs 4.6.0 requires fmm3dpy, which is not installed.
# ?ok simnibs 4.6.0 requires gmsh, which is not installed.
# ok simnibs 4.6.0 requires h5py, which is not installed.
# ok simnibs 4.6.0 requires nibabel, which is not installed.
# ok simnibs 4.6.0 requires numba, which is not installed.
# ok simnibs 4.6.0 requires petsc4py, which is not installed.
# ok simnibs 4.6.0 requires pillow, which is not installed.
# ok simnibs 4.6.0 requires pygpc, which is not installed.
# ok simnibs 4.6.0 requires samseg, which is not installed.
# ok importlib-metadata 8.7.0 has requirement zipp>=3.20, but you have zipp 3.17.0.
# ok ModuleNotFoundError: No module named 'mpmath' -> add to exts
# ok ImportError: Numba needs NumPy 2.2 or less. Got NumPy 2.3., from import cortech -> update numba + llvmlite
# ok ImportError: cannot import name 'TypeIs' from 'typing_extensions' from import brainnet -> newer typing_extensions
# ok ModuleNotFoundError: No module named 'surfa', from import samseg
# ok ModuleNotFoundError: No module named 'sklearn' from import pygpc
# ok llvmlite 0.45.x  -> LLVM 20.x -> use wheels for llvmlite
# ModuleNotFoundError: No module named 'ignite' from import brainnet
# ModuleNotFoundError: No module named 'xxhash' from import samseg/surfa
# ModuleNotFoundError: No module named 'tqdm' from import pygpc
# ModuleNotFoundError: No module named 'mumps' from import simnibs; from simnibs.mesh_tools import cgal and simnibs --help

local_llvmlite_preinstallopts = "export LLVM_CONFIG=${EBROOTLLVM}/bin/llvm-config && "
local_llvmlite_preinstallopts += "sed -i 's/llvm_config, \"--system-libs/llvm_config, \"--link-static --system-libs/' "
local_llvmlite_preinstallopts += "ffi/build.py && "

