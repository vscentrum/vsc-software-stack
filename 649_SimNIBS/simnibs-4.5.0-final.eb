# SimNIBS declares PyPI mkl/tbb dependencies on Linux. In this EB stack,
# NumPy/SciPy are provided by SciPy-bundle, and runtime TBB is provided
# by the EB tbb module. Installing PyPI mkl/intel-openmp/tbb pulls in native
# Intel runtime wheels and causes import/RPATH sanity failures, so remove only
# those wheel metadata requirements and keep targeted runtime checks.
postinstallcmds = [
    "sed -i -e '/^Requires-Dist: mkl[ ;]/d' "
    "-e '/^Requires-Dist: tbb[ ;]/d' "
    "%(installdir)s/lib/python%(pyshortver)s/site-packages/simnibs-%(version)s.dist-info/METADATA",
]

