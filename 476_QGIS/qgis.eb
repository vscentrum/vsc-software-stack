    ('PyYAML', '6.0'),
    ('Cartopy', '0.22.0'), # ? rly needed
    ('psycopg2', '2.9.9'),
    ('GDAL', '3.7.1'),
    ('Qwt', '6.3.0'),
    ('expat', '2.5.0'),
    ('QCA', '2.3.9'), # UPDATED
