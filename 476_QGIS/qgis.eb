#     ('QScintilla', '2.11.6'), # UPDATE - problem...
    # ('python-QScintilla', '2.14.1'),
    ('QScintilla', '2.14.1'),
    ('GSL', '2.7'), # optional
    ('libzip', '1.10.1'), # UPDATED
    ('QtKeychain', '0.14.3'), # UPDATED
    ('ICU', '73.2'), # ? rly needed
    ('PostgreSQL', '16.1'), # optional
    ('GRASS', '8.4.0'), # optional UPDATED
    # ('protobuf', '24.0'),
    ('protobuf-python', '4.24.0'),
    ('exiv2', '0.28.0'),
    ('pocl', '4.0'),
    ('draco', '1.5.7'), # CREATED
    ('SIP', '6.8.1'),
    ('HDF5', '1.14.0'),
    ('netCDF', '4.9.2'),
    ('libxml2', '2.11.4'),
]

