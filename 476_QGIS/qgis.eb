    ('flex', '2.6.4'),
    ('Bison', '3.8.2'),
    ('CMake', '3.26.3'),
    ('pkgconf', '1.9.5'),
    ('PyQt-builder', '1.15.4'),
]

dependencies = [
    ('Python', '3.11.3'),
    ('Qt5', '5.15.10'),
    ('Qt5Webkit', '5.212.0-alpha4'), # UPDATED
    ('PyQt5', '5.15.10'),
