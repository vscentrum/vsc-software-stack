# Author: Pavel Grochal (INUITS)
# License: GPLv2

easyblock = 'ConfigureMake'

name = 'QScintilla'
version = '2.14.1'

homepage = 'https://www.riverbankcomputing.com/software/qscintilla'
description = "QScintilla is a port to Qt of Neil Hodgson's Scintilla C++ editor control"

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://www.riverbankcomputing.com/static/Downloads/QScintilla/%(version)s/']
sources = ['QScintilla_src-%(version)s.tar.gz']
checksums = ['dfe13c6acc9d85dfcba76ccc8061e71a223957a6c02f3c343b30a9d43a4cdd4d']

# patches = ['QScintilla-2.11.2_fix-link-python-bindings.patch']

builddependencies = [
    ('binutils', '2.40'),
    ('PyQt-builder', '1.15.4'),
]

dependencies = [
    ('Python', '3.11.3'),
    ('PyQt5', '5.15.10'),
    ('SIP', '6.8.1'),
]

skipsteps = ['configure']
start_dir = 'src'

prebuildopts = 'export CPATH=$EBROOTQT5/include/QtWidgets:$EBROOTQT5/include/QtPrintSupport:$CPATH && '
prebuildopts += (
    "sed -i "
    # "-e 's|\$\$\[QT_HOST_DATA\]|%(installdir)s/data|g' "
    # "-e 's|\$\$\[QT_INSTALL_DATA\]|%(installdir)s/data|g' "
    "-e 's|\$\$\[QT_INSTALL_HEADERS\]|%(installdir)s/include|g' "
    "-e 's|\$\$\[QT_INSTALL_LIBS\]|%(installdir)s/lib|g' "
    # "-e 's|\$\$\[QT_INSTALL_TRANSLATIONS\]|%(installdir)s/trans|g' "
    "%(start_dir)s/features/qscintilla2.prf && "
)
prebuildopts += (
    "sed -i "
    "-e 's|\$\$\[QT_HOST_DATA\]|%(installdir)s/data|g' "
    "-e 's|\$\$\[QT_INSTALL_DATA\]|%(installdir)s/data|g' "
    "-e 's|\$\$\[QT_INSTALL_HEADERS\]|%(installdir)s/include|g' "
    "-e 's|\$\$\[QT_INSTALL_LIBS\]|%(installdir)s/lib|g' "
    "-e 's|\$\$\[QT_INSTALL_TRANSLATIONS\]|%(installdir)s/trans|g' "
    "%(start_dir)s/qscintilla.pro && "
)

prebuildopts += 'qmake qscintilla.pro && '

# installdir: /scratch/gent/vo/001/gvo00117/easybuild/RHEL8/cascadelake-ampere-ib/software/QScintilla/2.14.1-GCCcore-12.3.0
# builddir: /tmp/vsc47063/easybuild/build/QScintilla/2.14.1/GCCcore-12.3.0
# start_dir: /tmp/vsc47063/easybuild/build/QScintilla/2.14.1/GCCcore-12.3.0/QScintilla_src-2.14.1/src
# Python dir at: /tmp/vsc47063/easybuild/build/QScintilla/2.14.1/GCCcore-12.3.0/QScintilla_src-2.14.1/Python
postinstallcmds = [
    'export LD_LIBRARY_PATH=%(installdir)s/lib:$LD_LIBRARY_PATH && '
    'export CXXFLAGS="$CXXFLAGS -I%(installdir)s/include/Qsci" && '
    'export LDFLAGS="$LDFLAGS -L%(installdir)s/lib" && '
    'cd %(builddir)s/QScintilla_src-2.14.1/Python && cp pyproject-qt5.toml pyproject.toml && '
    'sip-install --target=%(installdir)s/lib/python%(pyshortver)s/site-packages --verbose'
]
# postinstall - add python bindings
# 1) rename pyproject-qt5.toml to pyproject.toml
# 2) sip-install
# 3) add PYTHONPATH

sanity_check_paths = {
    'files': [],
    'dirs': ['lib', 'lib/python%(pyshortver)s/site-packages'],
}

moduleclass = 'vis'

