easyblock = 'CMakeMake'

name = 'QGIS'
version = '3.40.2'

homepage = 'http://www.qgis.org/'
description = "QGIS is a user friendly Open Source Geographic Information System (GIS)."

toolchain = {'name': 'foss', 'version': '2023a'}
# toolchainopts = {'pic': True, 'cstd': 'gnu++11'}

source_urls = ['http://qgis.org/downloads/']
sources = [SOURCELOWER_TAR_BZ2]
checksums = ['d72d07a39729d97d8d3f536301819a4ca9c2c00f9f396e9022a5ec4356d828bf']

patches = ['patch2.1_fix-SIP-macro.patch']

builddependencies = [
    ('flex', '2.6.4'),
    ('Bison', '3.8.2'),
    ('CMake', '3.26.3'),
    ('pkgconf', '1.9.5'),
    ('PyQt-builder', '1.15.4'),
]

dependencies = [
    ('Python', '3.11.3'),
    ('Qt5', '5.15.10'),
    ('Qt5Webkit', '5.212.0-alpha4'), # UPDATED
    ('PyQt5', '5.15.10'),
    ('PROJ', '9.2.0'),
    ('GEOS', '3.12.0'),
    ('PDAL', '2.8.2'),
    ('zstd', '1.5.5'),
    ('SQLite', '3.42.0'),
    ('libspatialite', '5.1.0'), # UPDATED
    ('libspatialindex', '1.9.3'),
    ('PyYAML', '6.0'),
    ('Cartopy', '0.22.0'),
    ('psycopg2', '2.9.9'),
    ('GDAL', '3.7.1'),
    ('Qwt', '6.3.0'),
    ('expat', '2.5.0'),
    ('QCA', '2.3.9'), # UPDATED
#     # QScintilla must be listed after PyQt5 due to Python bindings 'overriding' those of PyQt5
    ('QScintilla', '2.14.1'),
    ('GSL', '2.7'), # optional
    ('libzip', '1.10.1'), # UPDATED
    ('QtKeychain', '0.14.3'), # UPDATED
    ('ICU', '73.2'),
    ('PostgreSQL', '16.1'), # optional
    ('GRASS', '8.4.0'), # optional UPDATED
    ('protobuf-python', '4.24.0'),
    ('exiv2', '0.28.0'),
    ('pocl', '4.0'),
    ('draco', '1.5.7'), # CREATED
    ('SIP', '6.8.1'),
    ('HDF5', '1.14.0'),
    ('netCDF', '4.9.2'),
    ('libxml2', '2.11.4'),
]

# specify locations that CMake can't figure out correctly
_copts = [
    "-DCMAKE_PREFIX_PATH=$EBROOTQT",
    "-DQSCINTILLA_LIBRARY=$EBROOTQSCINTILLA/lib/libqscintilla2_qt5.so,
    "-DQt5WebKit_DIR=$EBROOTQT5WEBKIT/lib64/cmake/Qt5WebKit",
    "-DQt5WebKitWidgets_DIR=$EBROOTQT5WEBKIT/lib64/cmake/Qt5WebKitWidgets",
    "-DPYQT5_SIP_DIR=$EBROOTPYQT5/share/sip",
    "-DQSCI_SIP_DIR=$EBROOTQSCINTILLA/lib/python%(pyshortver)s/site-packages/PyQt5/bindings/Qsci",
    "-DGRASS_PREFIX8=$EBROOTGRASS/grass8",
]
configopts = ' '.join(_copts)

