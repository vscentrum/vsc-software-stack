# Installation
# ------------

# The GPL version of QScintilla can be installed from PyPI::

#     pip install QScintilla

# The wheels include a statically linked copy of the QScintilla C++ library.

# ``pip`` will also build and install the bindings from the sdist package but
# Qt's ``qmake`` tool must be on ``PATH``.

# The ``sip-install`` tool will also install the bindings from the sdist package
# but will allow you to configure many aspects of the installation.

easyblock = 'PythonBundle'

name = 'python-QScintilla'
version = '2.14.1'

homepage = 'https://www.riverbankcomputing.com/software/qscintilla'
description = "QScintilla is a port to Qt of Neil Hodgson's Scintilla C++ editor control"

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}
# toolchainopts = {'pic': True, 'cstd': 'c++11'}
# toolchainopts = {'pic': True}

# source_urls = ['https://www.riverbankcomputing.com/static/Downloads/QScintilla/%(version)s/']
# sources = ['%(name)s_src-%(version)s.tar.gz']

# patches = ['QScintilla-2.11.2_fix-link-python-bindings.patch']

builddependencies = [
    ('binutils', '2.40'),
    ('PyQt-builder', '1.15.4'),
]

dependencies = [
    ('Python', '3.11.3'),
    ('PyQt5', '5.15.10'),
    ('SIP', '6.8.1'),
    ('QScintilla-CM', '2.14.1'),
]

use_pip = True
sanity_pip_check = True

exts_list = [
    ('QScintilla', version, {
        'easyblock': 'PythonPackage',
        'source_urls': ['https://www.riverbankcomputing.com/static/Downloads/QScintilla/%(version)s/'],
        'sources': ['QScintilla_src-%(version)s.tar.gz'],
        'preinstallopts': 'cp pyproject-qt5.toml pyproject.toml && sip-install &&',
        'start_dir': 'Python',
        'checksums': ['dfe13c6acc9d85dfcba76ccc8061e71a223957a6c02f3c343b30a9d43a4cdd4d'],
    }),
]

# QScintilla_src-%(version)s.tar.gz

moduleclass = 'vis'
