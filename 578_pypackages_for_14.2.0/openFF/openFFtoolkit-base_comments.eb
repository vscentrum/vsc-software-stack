easyblock = 'PythonBundle'

name = 'OpenForceField-Toolkit'
version = '0.16.9'
versionsuffix = '-base'

homepage = 'https://github.com/openforcefield/openff-toolkit'
description = """The Open Force Field Toolkit provides implementations of the SMIRNOFF format,
parameterization engine, and other tools."""

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [('poetry', '2.1.2')]
dependencies = [
    ('Python', '3.13.1'),
    ('Python-bundle-PyPI', '2025.04'),
    ('SciPy-bundle', '2025.06'),
    ('networkx', '3.5'),
    ('typing-extensions', '4.14.0'),
    ('pydantic', '2.11.7'), # in PR: https://github.com/easybuilders/easybuild-easyconfigs/pull/23272
    ('tqdm', '4.67.1'),
    ('OpenMM', '8.3.0'),
    ('PyYAML', '6.0.2'),
    ('RDKit', '2025.03.4'),
    ('MDTraj', '1.11.0'),
    ('JupyterNotebook', '7.4.4'), # in PR: https://github.com/easybuilders/easybuild-easyconfigs/pull/23272
    # ('AmberTools', '25.1'),
    ('Pint', '0.24.4'),
    ('nglview', '3.1.4'),
    # ('versioningit', '3.2.0'),
    # ('setuptools', '80.9.0'),
] # TODO: test pint + nglview - add them in openFF PR

# fix old syntax in versioneer.py
_fix_versioneer = "sed -i -e 's/SafeConfigParser()/ConfigParser()/' -e 's/readfp(/read_file(/' versioneer.py && "

