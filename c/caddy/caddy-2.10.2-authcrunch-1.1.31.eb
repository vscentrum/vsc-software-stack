easyblock = 'GoPackage'

name = 'caddy'
version = '2.10.2'
versionsuffix = '-authcrunch-1.1.31'

homepage = 'https://caddyserver.com/'
description = """Fast and extensible multi-platform HTTP/1-2-3 web server with automatic HTTPS,
here with an additional 'caddy-security' (aka 'authcrunch') plugin
"""

toolchain = SYSTEM

source_urls = ['https://github.com/caddyserver/caddy/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']

patches = ['caddy-2.10.2_authcrunch_1.1.31.patch']
checksums = [
    {'v2.10.2.tar.gz': 'f63f46b7ae68ced0a5c2e31df1b6dfc7656117d162a1bc7fed4bd4afd14ddc8f'},
    {'caddy-2.10.2_authcrunch_1.1.31.patch': '7ff35d5f5e65e4ccd5857ab492042218f47b415d748493057135b8e386003e38'},
]

builddependencies = [
    ('Go', '1.25.0'),
]

installopts = './cmd/%(namelower)s'

moduleclass = 'tools'
