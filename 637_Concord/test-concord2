import numpy as np, pandas as pd, anndata as ad, scanpy as sc, concord as ccd, torch, tempfile
rng=np.random.default_rng(0)
n,g=200,500
X=rng.poisson(1.0,(n,g)).astype(np.float32)
obs=pd.DataFrame({"batch":rng.integers(0,2,n).astype(str)})
var=pd.DataFrame(index=[f"g{i}" for i in range(g)])
adata=ad.AnnData(X=X, obs=obs, var=var)
feature_list=ccd.ul.select_features(adata,n_top_features=200,flavor="seurat_v3")
sc.pp.normalize_total(adata); sc.pp.log1p(adata)
device=torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
tmp=tempfile.mkdtemp(prefix="concord_smoke_")
m=ccd.Concord(adata=adata,input_feature=feature_list,domain_key="batch",
             device=device,n_epochs=1,batch_size=64,latent_dim=16,
             encoder_dims=[128],decoder_dims=[128],
             use_faiss=True,use_ivf=False,preload_dense=True,
             save_dir=tmp,verbose=False)
m.fit_transform(output_key="ConcordTest",save_model=False,return_class=False,return_class_prob=False)
print("emb",adata.obsm["ConcordTest"].shape,"save_dir",tmp)
ccd.ul.run_umap(adata,source_key="ConcordTest",result_key="ConcordTest_UMAP",
               n_components=2,n_neighbors=15,min_dist=0.3,metric="cosine")
print("umap",adata.obsm["ConcordTest_UMAP"].shape)
