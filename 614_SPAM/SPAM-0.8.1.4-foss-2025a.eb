    ('Python', '3.13.1'),
    ('gmsh', '4.15.0'),
    ('SciPy-bundle', '2025.06'),
    ('h5py', '3.14.0'),
    ('matplotlib', '3.10.3'),
    ('meshio', '5.3.5'),
    ('numba', '0.62.0'),
    ('PyAMG', '5.3.0'),
    ('PyYAML', '6.0.2'),
    ('scikit-image', '0.25.2'),
    # ('SimpleITK', ''),  # TODO
]

