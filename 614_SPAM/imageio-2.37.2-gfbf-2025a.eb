easyblock = 'PythonPackage'

name = 'imageio'
version = '2.37.2'

homepage = 'https://imageio.github.io'
description = """Imageio is a Python library that provides an easy interface to read and write a wide range of
 image data, including animated images, video, volumetric data, and scientific formats."""

toolchain = {'name': 'gfbf', 'version': '2025a'}

# fixes ValueError: invalid pyproject.toml config: `project.license`
# configuration error: `project.license` must be valid exactly by one definition
sources = [SOURCE_PY3_WHL]
checksums = ['ad9adfb20335d718c03de457358ed69f141021a333c40a53e57273d8a5bd0b9b']

dependencies = [
    ('Python', '3.13.1'),
    ('matplotlib', '3.10.3'),
    ('Pillow', '11.3.0'),
]

moduleclass = 'vis'
