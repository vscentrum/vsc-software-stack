easyblock = 'MakeCp'

name = 'VASP'
version = '6.4.3'
local_wanver = '3.1.0'
local_hdf5ver = '1.14.5'
versionsuffix = '-Wannier90-%s-HDF5-%s' % (local_wanver, local_hdf5ver)

homepage = 'http://www.vasp.at'
description = """The Vienna Ab initio Simulation Package (VASP) is a computer program for atomic scale
materials modelling, e.g. electronic structure calculations and quantum-mechanical molecular dynamics,
from first principles."""

toolchain = {'name': 'intel', 'version': '2024a'}
toolchainopts = {'usempi': True, 'openmp':True}

# Vasp is proprietary software, see http://www.vasp.at/index.php/faqs on how to get access to the code
sources = [
    '%(namelower)s.%(version)s.tgz',
]
patches = [('VASP-6.4.3-intel-Wannier90-HDF5.patch', 1)]
checksums = [
    'fe30e773f2a3e909b5e0baa9654032dfbdeff7ec157bc348cee7681a7b6c24f4',  # vasp.6.4.3.tgz
    'ffc7d6451339762aa335df9ea07b0c1fd47d6d2b3231a74782aa96d7c4c31179',  # VASP-6.4.3-intel-Wannier90-HDF5.patch
]

dependencies = [('Wannier90', local_wanver), 
                ('HDF5', local_hdf5ver, '', ('iimpi', '2024a')),
               ]

prebuildopts = 'cp -v arch/makefile.include.intel_omp ./makefile.include &&'

# Makefile uses LIBS as a list of folders
prebuildopts += 'unset LIBS && '

_targets = ['std', 'gam', 'ncl']

# https://www.vasp.at/wiki/index.php/Validation_tests
pretestopts = 'export OMP_STACKSIZE=512m && '
runtest = 'test'

parallel = 1

files_to_copy = [
    (['bin/vasp_' + x for x in _targets], 'bin'),
    (['testsuite'], ''),
]

sanity_check_paths = {
    'files': ['bin/vasp_' + x for x in _targets],
    'dirs': []
}

modextravars = {
    'I_MPI_ADJUST_REDUCE': "3",
    'OMP_STACKSIZE': "512m"

}

moduleclass = 'phys'

