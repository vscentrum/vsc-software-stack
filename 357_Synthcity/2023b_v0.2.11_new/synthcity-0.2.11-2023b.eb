easyblock = 'PythonBundle'

name = 'synthcity'
version = '0.2.11'

local_pytorch_version = '2.1.2'

homepage = 'https://github.com/vanderschaarlab/synthcity'
description = """A library for generating and evaluating synthetic tabular data."""

toolchain = {'name': 'foss', 'version': '2023b'}

# DEPS in DEPS-0.2.11.txt

builddependencies = [('poetry', '1.6.1')]
dependencies = [
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'),
    ('SciPy-bundle', '2023.11'),
    ('PyTorch', local_pytorch_version),
    ('lifelines', '0.29.0'),
    ('Redis', '7.2.4'),
    ('scikit-learn', '1.4.0'),
    ('SHAP', '0.46.0'),
    ('XGBoost', '2.1.1'),
    ('tqdm', '4.66.2'),
    ('HF-Datasets', '3.1.0'),
    ('Transformers', '4.44.0'),
    ('fastai', '2.7.18'),
    ('h5py', '3.11.0'),
    ('Brotli-python', '1.1.0'),
    ('statsmodels', '0.14.1'),
    ('imbalanced-learn', '0.12.3'),
    ('Optuna', '3.6.1'),
    ('MONAI', '1.4.0'),
    ('DECAF-synthetic-data', '0.1.6'),
    ('PyTorch-Lightning', '1.9.5'),
    # # TESTS
    # ('Jupyter-bundle', '20240522'),
    # # ('python-igraph', '0.11.4'),
    # ('coverage', '7.4.4'),
    # ('py-cpuinfo', '9.0.0'),
    # # ('pycodestyle', '2.11.1'),
]

sanity_pip_check = True
use_pip = True

