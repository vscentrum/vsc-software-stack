easyblock = 'PythonBundle'

name = 'PyTorch-Lightning'
version = '1.8.4'
local_pytorch_version = '2.1.2'
versionsuffix = '-PyTorch-%s' % local_pytorch_version

homepage = 'https://pytorchlightning.ai'
description = "PyTorch Lightning is the lightweight PyTorch wrapper for ML researchers."

toolchain = {'name': 'foss', 'version': '2023b'}

# DEPS:
    # ok lightning-cloud>=0.5.12
    # OK packaging
    # ok typing-extensions>=4.0.0, <=4.4.0
    # OK? deepdiff>=5.7.0, <=5.8.1
    # ok starsessions>=1.2.1, <2.0 # strict
    # ok fsspec>=2022.5.0, <=2022.7.1
    # ok croniter>=1.3.0, <1.4.0  # strict; TODO: for now until we find something more robust.
    # ok traitlets>=5.3.0, <=5.4.0
    # ok arrow>=1.2.0, <1.2.4
    # ok lightning-utilities>=0.3.0, !=0.4.0, <0.5.0
    # OK? beautifulsoup4>=4.8.0, <4.11.2
    # ok inquirer>=2.10.0
    # OK? psutil<5.9.4 - in pypi v5.9.6
    # OK? click<=8.1.3 - in pypi v8.1.7
    # ok s3fs>=2022.5.0, <2022.8.3
    # OK? aiohttp>=3.8.0, <=3.8.3
    # OK? numpy>=1.17.2, <1.23.1
    # OK? torch>=1.9.0, <=1.13.0
    # OK? tqdm>=4.57.0, <4.65.0
    # OK? PyYAML>=5.4, <=6.0
    # OK? tensorboardX>=2.2, <=2.5.1  # min version is set by torch.onnx missing attribute
    # ok torchmetrics>=0.7.0, <0.10.1  # needed for using fixed compare_version
    # ok lightning-cloud 0.5.64 requires boto3, which is not installed.
    # ok lightning-cloud 0.5.64 requires fastapi, which is not installed.
    # ok lightning-cloud 0.5.64 requires pyjwt, which is not installed.
    # ok lightning-cloud 0.5.64 requires python-multipart, which is not installed.
    # ok lightning-cloud 0.5.64 requires uvicorn, which is not installed.
    # ok lightning-cloud 0.5.64 requires websocket-client, which is not installed.
    # ok inquirer 2.10.1 requires blessed, which is not installed.
    # ok inquirer 2.10.1 requires python-editor, which is not installed.
    # ok inquirer 2.10.1 requires readchar, which is not installed.
    # ok s3fs 2022.7.1 requires aiobotocore, which is not installed.
    # ok starsessions 1.3.0 requires itsdangerous, which is not installed.
    # ok starsessions 1.3.0 requires starlette, which is not installed.


builddependencies = [('poetry', '1.6.1')]
dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('Python-bundle-PyPI', '2023.10'),
    ('aiohttp', '3.9.5'),
    ('BeautifulSoup', '4.12.2'),
    ('deepdiff', '8.0.1'),
    ('PyTorch', '2.1.2'),
    ('tqdm', '4.66.2'),
    ('tensorboardX', '2.6.2.2'),
    ('PyYAML', '6.0.1'),
]

use_pip = True

