    ('Werkzeug', '3.1.0', {
        'source_tmpl': '%(namelower)s-%(version)s.tar.gz',
        'checksums': ['e39b645a6ac92822588e7b39a692e7828724ceae0b0d702ef96701f90e70128d'],
