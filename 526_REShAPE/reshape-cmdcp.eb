builddependencies = [
    ('CMake', '3.26.3'),
]
dependencies = [
    ('CUDA', '12.1.1', '', SYSTEM),
    ('Python', '3.11.3'),
    ('Tkinter', '%(pyver)s'),
    ('Python-bundle-PyPI', '2023.06'),
    ('freeglut', '3.4.0'),
    ('libjpeg-turbo', '2.1.5.1'),
    ('cURL', '8.0.1'),
    ('OpenSSL', '3', '', SYSTEM),
    ('libxml2', '2.11.4'),
    ('R', '4.3.2'),
    ('R-bundle-CRAN', '2023.12'),
    ('Pillow', '10.0.0'),
    ('Fiji', '2.14.0', '-Java-11', SYSTEM),
    ('ITK', '5.3.0'),
    # ('MATLAB', '2023a', '', SYSTEM),
    ('Qt5', '5.15.10'),
    # ('VTK', '9.3.0'),
]

with_configure = True
configure_without_installdir = True
configure_cmd = 'chmod 777 %(start_dir)sStandalone/deviceQuery && cd %(start_dir)s && ./Standalone/deviceQuery'  # OK
build_cmd = ''
install_cmd = ''
# cmds_map = [('.*', "./configure.py --bootstrap")]

files_to_copy = ['*']

