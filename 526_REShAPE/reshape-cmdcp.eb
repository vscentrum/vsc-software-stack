easyblock = 'CmdCp'

name = 'REShAPE'
version = '1.0.5-20230410'
_commit = '8f1865e'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://qiime2.org'
description = """QIIME 2 is a powerful, extensible, and decentralized microbiome bioinformatics platform that is free,
open source, and community developed."""

toolchain = {'name': 'foss', 'version': '2023a'}

source_urls = ['https://github.com/NIH-NEI/REShAPE/archive/']
sources = [{'download_filename': '8f1865e.tar.gz', 'filename': '%(name)s-%(version)s-8f1865e.tar.gz'}]
checksums = ['bdd333a23660311c7dac033c07ea8d6d5347302130eeb30f609c27783a04d9c4']

