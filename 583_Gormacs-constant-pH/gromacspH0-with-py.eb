name = 'GROMACS'
version = '20250409'
local_commit = '28807b11'
versionsuffix = '-constant-pH'
# seems the fork is from v2021.0-beta1
# SOVERSION = 6.0.0

homepage = 'https://gitlab.com/gromacs-constantph'
description = """
GROMACS is a versatile package to perform molecular dynamics, i.e. simulate the
Newtonian equations of motion for systems with hundreds to millions of
particles.

This is a CPU only build, containing both MPI and threadMPI binaries
for both single and double precision.

It also contains the gmxapi extension for the single precision MPI build.
"""

toolchain = {'name': 'foss', 'version': '2023b'}
toolchainopts = {'openmp': True, 'usempi': True}

# https://gitlab.com/gromacs-constantph/constantph/-/archive/main/constantph-main.tar.gz
source_urls = ['https://gitlab.com/gromacs-constantph/constantph/-/archive/']
sources = [{
    'download_filename': '%s.tar.gz' % local_commit,
    'filename': '%%(name)s-%%(version)s-%s.tar.gz' % local_commit,
}]
patches = [
    'patch1_fix-pybind11.patch',
    'patch2.patch',
]
checksums = [
    {'GROMACS-20250409-28807b11.tar.gz': '88548354e02c872052f2fa662eab5f111421706cb0ea264e94af19e7274d0f78'},
    {'patch1_fix-pybind11.patch': '81b69c34df5720ff7c25853ae5b63f1b64276888b89505a339a739cc0ad9febb'},
    {'patch2.patch': 'c7ed9c1f84c416eeb0cc065868f25053a11581300e9de504b8bf804cdd1f9fd9'},
]

builddependencies = [
    ('CMake', '3.27.6'),
    ('scikit-build-core', '0.9.3'),
    ('pybind11', '2.11.1'),
]

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('networkx', '3.2.1'),
    ('mpi4py', '3.1.5'),
]

start_dir = 'gromacs-constantph'

# be a bit more forgiving w.r.t. timeouts for GROMACS test suite,
# see also https://gitlab.com/gromacs/gromacs/-/issues/5062
# configopts = "-DGMX_TEST_TIMEOUT_FACTOR=3"
# configopts += "-DGMX_PYTHON_PACKAGE=OFF"

# not working:
# configopts = "-DGMX_EXTERNAL_PYBIND11=ON "
# configopts += "-Dpybind11_DIR=$EBROOTPYBIND11 "

preconfigopts = (
    "sed -i "
    "-e 's/pybind11 2.2 REQUIRED/pybind11 2.11 REQUIRED/' "
    "-e 's/_gmxapi PRIVATE Gromacs::gmxapi/_gmxapi PRIVATE pybind11::pybind11 Gromacs::gmxapi/' "
    "%(builddir)s/constantph-28807b11-28807b1162cacd9dc797520bc509d12edca13d1a/gromacs-constantph/python_packaging/src/CMakeLists.txt && "
)
# preconfigopts += "export CPATH=/apps/gent/RHEL9/cascadelake-ib/software/Python/3.11.5-GCCcore-13.2.0/include/python3.11:$CPATH && "
# preconfigopts += 'echo $CPATH && '
configopts = "-DGMXAPI_USE_BUNDLED_PYBIND=OFF "
# configopts += "-DPYTHON_INCLUDE_DIR=/apps/gent/RHEL9/cascadelake-ib/software/Python/3.11.5-GCCcore-13.2.0/include/python3.11 " # not working
# configopts += "-DPython3_INCLUDE_DIR=/apps/gent/RHEL9/cascadelake-ib/software/Python/3.11.5-GCCcore-13.2.0/include/python3.11"
configopts += "-DPYTHON_LIBRARIES=/apps/gent/RHEL9/cascadelake-ib/software/Python/3.11.5-GCCcore-13.2.0/lib/libpython3.11.so "

exts_defaultclass = 'PythonPackage'
exts_default_options = {
    'source_urls': [PYPI_SOURCE],
}

exts_list = [
    ('gmxapi', '0.4.2', {
        'preinstallopts': 'export CMAKE_ARGS="-Dgmxapi_ROOT=%(installdir)s -C %(installdir)s/share/cmake/gromacs_mpi/gromacs-hints_mpi.cmake" && ',
        'checksums': ['c746c6498c73a75913d7fcb01c13cc001d4bcb82999e9bf91d63578565ed1a1f'],
    }),
]

moduleclass = 'bio'

